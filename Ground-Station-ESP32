    function findLoraStrengthCard() {
      const frame =
        document.getElementById("atlasUiFrame");

      try {
        const frameDocument =
          frame.contentDocument ||
          frame.contentWindow.document;

        const elements =
          frameDocument.querySelectorAll("*");

        let titleElement = null;

        for (const element of elements) {
          const text =
            element.textContent.trim();

          if (
            element.children.length === 0 &&
            (
              text === "LoRa Link Strength" ||
              text === "LoRa Strength"
            )
          ) {
            titleElement = element;
            break;
          }
        }

        if (!titleElement) {
          return null;
        }

        let card =
          titleElement.parentElement;

        while (
          card &&
          card !== frameDocument.body
        ) {
          if (
            card.textContent.includes("%")
          ) {
            return card;
          }

          card =
            card.parentElement;
        }
      }
      catch (error) {
      }

      return null;
    }

