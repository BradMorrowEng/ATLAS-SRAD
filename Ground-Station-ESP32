void handleData()
{
  unsigned long age = 0;

  if (lastPacketTime > 0)
  {
    age =
      millis() - lastPacketTime;
  }

  bool groundFixValid =
    groundLastFixTime > 0 &&
    millis() - groundLastFixTime <
    GS_FIX_TIMEOUT_MS;

  double onboardLatitude = 0.0;
  double onboardLongitude = 0.0;

  bool onboardLatitudeValid =
    stringToDouble(
      latitude,
      onboardLatitude
    );

  bool onboardLongitudeValid =
    stringToDouble(
      longitude,
      onboardLongitude
    );

  bool onboardFixValid =
    onboardLatitudeValid &&
    onboardLongitudeValid &&
    onboardLatitude >= -90.0 &&
    onboardLatitude <= 90.0 &&
    onboardLongitude >= -180.0 &&
    onboardLongitude <= 180.0 &&
    onboardLatitude != 0.0 &&
    onboardLongitude != 0.0;

  double distanceKm = 0.0;
  double distanceM = 0.0;
  double bearingDegrees = 0.0;

  String direction = "";

  if (
    groundFixValid &&
    onboardFixValid
  )
  {
    distanceKm =
      calculateDistanceKm(
        groundLatitude,
        groundLongitude,
        onboardLatitude,
        onboardLongitude
      );

    distanceM =
      distanceKm * 1000.0;

    bearingDegrees =
      calculateBearingDegrees(
        groundLatitude,
        groundLongitude,
        onboardLatitude,
        onboardLongitude
      );

    direction =
      bearingDirection(
        bearingDegrees
      );
  }

  uint32_t groundSatellites = 0;

  if (groundGps.satellites.isValid())
  {
    groundSatellites =
      groundGps.satellites.value();
  }

  double groundHdop = 0.0;

  if (groundGps.hdop.isValid())
  {
    groundHdop =
      groundGps.hdop.hdop();
  }

  unsigned long groundFixAge = 0;

  if (groundGps.location.isValid())
  {
    groundFixAge =
      groundGps.location.age();
  }

  String json = "{";

  json += "\"latest\":\"";
  json += escapeJson(latestLine);
  json += "\",";

  json += "\"name\":\"";
  json += escapeJson(trackerName);
  json += "\",";

  json += "\"count\":";
  json += String(packetCount);
  json += ",";

  json += "\"age\":";
  json += String(age);
  json += ",";

  json += "\"timeout\":";
  json += String(LINK_TIMEOUT_MS);
  json += ",";

  json += "\"pkt\":\"";
  json += escapeJson(pkt);
  json += "\",";

  json += "\"altft\":\"";
  json += escapeJson(altitudeFt);
  json += "\",";

  json += "\"lat\":\"";
  json += escapeJson(latitude);
  json += "\",";

  json += "\"lon\":\"";
  json += escapeJson(longitude);
  json += "\",";

  json += "\"descfts\":\"";
  json += escapeJson(descentFtS);
  json += "\",";

  json += "\"sats\":\"";
  json += escapeJson(satellites);
  json += "\",";

  json += "\"gpsfix\":\"";
  json += escapeJson(gpsFixType);
  json += "\",";

  json += "\"gpsaltft\":\"";
  json += escapeJson(gpsAltitudeFt);
  json += "\",";

  json += "\"gpsvsfts\":\"";
  json += escapeJson(gpsVerticalSpeedFtS);
  json += "\",";

  json += "\"gpsage\":\"";
  json += escapeJson(gpsAgeMs);
  json += "\",";

  json += "\"batv\":\"";
  json += escapeJson(batteryVoltage);
  json += "\",";

  json += "\"gsbatv\":\"";
  json += escapeJson(
    groundStationBatteryVoltage
  );
  json += "\",";

  json += "\"rssi\":\"";
  json += escapeJson(loraRssi);
  json += "\",";

  json += "\"snr\":\"";
  json += escapeJson(loraSnr);
  json += "\",";

  json += "\"gsFix\":";
  json += groundFixValid
    ? "true"
    : "false";
  json += ",";

  json += "\"gsLat\":";
  json += groundFixValid
    ? String(groundLatitude, 6)
    : "0";
  json += ",";

  json += "\"gsLon\":";
  json += groundFixValid
    ? String(groundLongitude, 6)
    : "0";
  json += ",";

  json += "\"gsSats\":";
  json += String(groundSatellites);
  json += ",";

  json += "\"gsHdop\":";
  json += String(groundHdop, 2);
  json += ",";

  json += "\"gsFixAge\":";
  json += String(groundFixAge);
  json += ",";

  json += "\"onboardFix\":";
  json += onboardFixValid
    ? "true"
    : "false";
  json += ",";

  json += "\"distanceKm\":";
  json += String(distanceKm, 3);
  json += ",";

  json += "\"distanceM\":";
  json += String(distanceM, 1);
  json += ",";

  json += "\"bearingDeg\":";
  json += String(bearingDegrees, 1);
  json += ",";

  json += "\"bearingDirection\":\"";
  json += escapeJson(direction);
  json += "\",";

  json += "\"frequency\":\"";
json += escapeJson(
    currentLoraFrequency
);
json += "\",";

String actualRadioFrequencyMHz = "--";

if (actualRadioFrequencyHz.length() > 0)
{
    actualRadioFrequencyMHz =
        String(
            actualRadioFrequencyHz.toDouble() / 1000000.0,
            3
        );
}

json += "\"radioFrequency\":\"";
json += escapeJson(
    actualRadioFrequencyMHz
);
json += "\",";

json += "\"frequencyStatus\":\"";
json += escapeJson(
    frequencyStatus
);

json += "\",";

json += "\"mainAltitudeFt\":\"";
json += escapeJson(
    currentMainAltitudeFt
);
json += "\",";

json += "\"mainAltitudeStatus\":\"";
json += escapeJson(
    mainAltitudeStatus
);
json += "\",";

  json += "\"flashMaintenance\":";
  json += flashMaintenanceActive
    ? "true"
    : "false";
  json += ",";

  json += "\"flashStatus\":\"";
  json += escapeJson(
    flashStatus
  );
  json += "\",";

  json += "\"flashVerify\":\"";
  json += escapeJson(
    flashVerify
  );
  json += "\",";

  json += "\"flashBytes\":\"";
  json += escapeJson(
