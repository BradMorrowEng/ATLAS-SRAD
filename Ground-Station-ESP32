        if (!confirmed) {
          return;
        }

        atlasPanelClear.disabled = true;
        atlasPanelReturn.disabled = false;
        atlasPanelStatus.innerText = "COMMAND SENT";
        atlasPanelMessage.innerText =
          "Sending erase command...";

        fetch(
          "/clear-blackbox",
          { method: "POST" }
        )
          .then(response => response.json())
          .then(result => {
            if (!result.ok) {
              throw new Error("Rejected");
            }
          })
          .catch(() => {
            atlasPanelStatus.innerText = "FAILED";
            atlasPanelMessage.innerText = "Command failed";
            atlasPanelClear.disabled = false;
            atlasPanelReturn.disabled = false;
          });
