    function refreshFrequency() {
      fetch("/data")
        .then(response => response.json())
        .then(data => {
          const frequency =
            data.frequency || "915.0";

          const state =
            data.frequencyStatus || "READY";

          const currentFlashStatus =
            data.flashStatus || "READY";

          const panelUsedBytes =
            Number(data.flashUsedBytes || 0);

          const panelTotalBytes =
            Number(data.flashTotalBytes || 16777216);

          const panelAvailableBytes =
            Math.max(
              panelTotalBytes - panelUsedBytes,
              0
            );

          const panelPercent =
            panelTotalBytes > 0
              ? (panelUsedBytes / panelTotalBytes) * 100.0
              : 0.0;

          atlasPanelStatus.innerText =
            (data.flashStatus || "READY")
              .replaceAll("_", " ");

          atlasPanelUsed.innerText =
            (panelUsedBytes / 1048576.0).toFixed(2) +
            " MB";

          atlasPanelAvailable.innerText =
            (panelAvailableBytes / 1048576.0).toFixed(2) +
            " MB";

          atlasPanelPercent.innerText =
            panelPercent.toFixed(1) +
            "% full";

          atlasFlashUsageInner.style.width =
            Math.min(panelPercent, 100).toFixed(1) +
            "%";

          const panelVerify =
            data.flashVerify || "NOT RUN";

          atlasPanelVerify.innerText =
            panelVerify;
          atlasPanelVerify.style.color = "#eeeeee";

          const flashPanelBusy =
            currentFlashStatus === "COMMAND_SENT" ||
            currentFlashStatus === "CLEARING";

          atlasPanelClear.disabled =
            flashPanelBusy;

          atlasPanelReturn.disabled = false;

          if (
            data.flashStatus === "EMPTY" &&
            panelVerify === "FULL"
          )
          {
            atlasPanelUsed.innerText = "0.00 MB";
            atlasPanelAvailable.innerText = "16.00 MB";
            atlasPanelPercent.innerText = "0.0% full";
            atlasFlashUsageInner.style.width = "0%";
            atlasPanelVerify.innerText =
              "FULL ERASE VERIFIED";
            atlasPanelVerify.style.color =
              "#00ee91";
            atlasPanelMessage.innerText =
              "Flash is empty and ready.";
            atlasPanelClear.disabled = false;
            atlasPanelReturn.disabled = false;
          }
          else if (data.flashStatus === "CLEARING")
          {
            atlasPanelVerify.innerText =
              "ERASING";
            atlasPanelVerify.style.color =
              "#ffba52";
            atlasPanelMessage.innerText =
              "Erasing flash... ATLAS V2 is still connected.";
          }
          else if (data.flashStatus === "VERIFYING")
          {
            atlasPanelVerify.innerText =
              "VERIFYING";
            atlasPanelVerify.style.color =
              "#ffba52";
            atlasPanelMessage.innerText =
              "Erase finished. Verifying the full 16 MB...";
          }
          else if (
            data.flashStatus === "FAILED" ||
            panelVerify === "FAIL"
          )
          {
            atlasPanelVerify.innerText =
              "FAILED";
            atlasPanelVerify.style.color =
              "#ff5d5d";
            atlasPanelMessage.innerText =
              "Erase or verification failed.";
            atlasPanelClear.disabled = false;
            atlasPanelReturn.disabled = false;
          }

          if (
            currentFlashStatus === "READY" &&
            !flashPanelBusy
          )
          {
            atlasPanelMessage.innerText =
              "Flash usage loaded.";
            atlasPanelClear.disabled = false;
            atlasPanelReturn.disabled = false;
          }

          else if (
            currentFlashStatus === "TIMEOUT" ||
            currentFlashStatus === "SEND_FAILED"
          )
          {
            atlasPanelVerify.innerText = "NOT VERIFIED";
            atlasPanelVerify.style.color = "#ffba52";
            atlasPanelMessage.innerText =
              "No response from ATLAS V2. You can return or try again.";
            atlasPanelClear.disabled = false;
            atlasPanelReturn.disabled = false;
          }

          updateLoraDisplay(data);

          button.innerText =
            frequency.replace(".0", "") +
            " MHz";

          status.innerText =
            state;

          const mainAltitude =
            data.mainAltitudeFt || "";

          const mainState =
            data.mainAltitudeStatus || "UNKNOWN";

          mainAltitudeButton.innerText =
            mainAltitude.length > 0
              ? "MAIN " + mainAltitude + " FT"
              : "MAIN -- FT";

          mainAltitudeStatus.innerText =
            mainState;

          const mainAltitudeBusy = [
            "SENDING",
            "WAITING",
            "PENDING",
            "COMMAND_SENT",
            "BUSY"
          ];

          mainAltitudeButton.disabled =
            mainAltitudeBusy.includes(mainState);

          document
            .querySelectorAll(
              ".atlasMainAltitudeOption"
            )
            .forEach(option => {
              option.classList.toggle(
                "current",
                option.dataset.altitude ===
                  mainAltitude
              );
            });

          const frequencyBusy = [
            "SENDING",
            "CHANGING",
            "PENDING",
            "COMMAND_SENT"
          ];

          button.disabled =
            frequencyBusy.includes(state);

          document
            .querySelectorAll(
              ".atlasFrequencyOption"
            )
            .forEach(option => {
              option.classList.toggle(
                "current",
                option.dataset.frequency ===
                  frequency
              );
            });
        })
        .catch(() => {
          status.innerText = "OFFLINE";
          button.disabled = false;

          mainAltitudeStatus.innerText = "OFFLINE";
          mainAltitudeButton.disabled = false;
        });
    }

    setInterval(
      refreshFrequency,
      500
    );

    fetch(
      "/main-altitude-info",
      { method: "POST" }
    ).catch(() => {
      mainAltitudeStatus.innerText = "SYNC FAILED";
    });

    refreshFrequency();
  </script>

</body>
</html>
)freqpage";

String escapeJson(String value)
{
  value.replace("\\", "\\\\");
  value.replace("\"", "\\\"");
  value.replace("\n", "\\n");
  value.replace("\r", "");

  return value;
}

String getValue(
  const String& line,
  const String& key
)
{
  /*
   * Match whole comma-separated field names only.
   *
   * This prevents STATUS from accidentally matching FLASHSTATUS,
   * ALTFT from matching GPSALTFT, etc.
   */
  String token = key + "=";

  int searchFrom = 0;

  while (true)
  {
    int start =
      line.indexOf(
        token,
        searchFrom
      );

    if (start < 0)
    {
      return "";
    }

    bool validBoundary =
      start == 0 ||
      line.charAt(start - 1) == ',';

    if (validBoundary)
    {
      start += token.length();

      int end =
        line.indexOf(",", start);

      if (end < 0)
      {
        end = line.length();
      }

      String value =
        line.substring(
          start,
          end
        );

      value.trim();

      return value;
    }

    searchFrom =
      start + token.length();
  }
}

bool stringToDouble(
  const String& value,
  double& result
)
{
  if (value.length() == 0)
  {
    return false;
  }

  char* endPointer = nullptr;

  result = strtod(
    value.c_str(),
    &endPointer
  );

  if (
    endPointer == value.c_str() ||
    *endPointer != '\0'
  )
  {
    return false;
  }

  return true;
}

double degreesToRadians(double degrees)
{
  return degrees * PI / 180.0;
}

double radiansToDegrees(double radians)
{
  return radians * 180.0 / PI;
}

double calculateDistanceKm(
  double lat1,
  double lon1,
  double lat2,
  double lon2
)
{
  const double earthRadiusKm = 6371.0;

  double latitudeDifference =
    degreesToRadians(lat2 - lat1);

  double longitudeDifference =
    degreesToRadians(lon2 - lon1);

  double a =
    sin(latitudeDifference / 2.0) *
    sin(latitudeDifference / 2.0) +
    cos(degreesToRadians(lat1)) *
    cos(degreesToRadians(lat2)) *
    sin(longitudeDifference / 2.0) *
    sin(longitudeDifference / 2.0);

  double c =
    2.0 *
    atan2(
      sqrt(a),
      sqrt(1.0 - a)
    );

  return earthRadiusKm * c;
}

double calculateBearingDegrees(
  double lat1,
  double lon1,
  double lat2,
  double lon2
)
{
  double firstLatitude =
    degreesToRadians(lat1);

  double secondLatitude =
    degreesToRadians(lat2);

  double longitudeDifference =
    degreesToRadians(lon2 - lon1);

  double y =
    sin(longitudeDifference) *
    cos(secondLatitude);

  double x =
    cos(firstLatitude) *
    sin(secondLatitude) -
    sin(firstLatitude) *
    cos(secondLatitude) *
    cos(longitudeDifference);

  double bearing =
    radiansToDegrees(
      atan2(y, x)
    );

  return fmod(
    bearing + 360.0,
    360.0
  );
}

String bearingDirection(double bearing)
{
  const char* directions[] =
  {
    "N",
    "NE",
    "E",
    "SE",
    "S",
    "SW",
    "W",
    "NW"
  };

  int index =
    ((int)round(bearing / 45.0)) % 8;

  return String(directions[index]);
}

String getContentType(const String& filename)
{
  if (filename.endsWith(".html"))
  {
    return "text/html";
  }

  if (filename.endsWith(".css"))
  {
    return "text/css";
  }

  if (filename.endsWith(".js"))
  {
    return "application/javascript";
  }

  if (filename.endsWith(".png"))
  {
    return "image/png";
  }

  if (
    filename.endsWith(".jpg") ||
    filename.endsWith(".jpeg")
  )
  {
    return "image/jpeg";
  }

  if (filename.endsWith(".svg"))
  {
    return "image/svg+xml";
  }

  if (filename.endsWith(".json"))
  {
    return "application/json";
  }

  return "application/octet-stream";
}

bool serveFileFromSD(String path)
{
  if (path == "/")
  {
    path = "/index.html";
  }

  if (path.indexOf("..") >= 0)
  {
    server.send(
      403,
      "text/plain",
      "Invalid path"
    );

    return true;
  }

  if (!SD.exists(path))
  {
    return false;
  }

  File file = SD.open(
    path,
    FILE_READ
  );

  if (!file)
  {
    server.send(
      500,
      "text/plain",
      "Failed to open file"
    );

    return true;
  }

  server.sendHeader(
    "Cache-Control",
    "no-store"
  );

  server.streamFile(
    file,
    getContentType(path)
  );

  file.close();

  return true;
}

void saveField(
  const String& line,
  const String& key,
  String& destination
)
{
  String value = getValue(
    line,
    key
  );

  if (value.length() > 0)
  {
    destination = value;
  }
}

void parseDataLine(const String& line)
{
  if (!line.startsWith("DATA,"))
  {
    return;
  }

  latestLine = line;

  packetCount++;

  lastPacketTime = millis();

  saveField(
    line,
    "NAME",
    trackerName
  );

  saveField(
    line,
    "PKT",
    pkt
  );

  /*
   * Green LED link detection.
   * Only a DATA line with a real PKT number greater than 0
   * counts as an onboard packet.
   *
   * The GS STM32 startup line uses PKT=0, so it is ignored.
   * GS battery lines do not enter parseDataLine().
   */
  String receivedPkt = getValue(
    line,
    "PKT"
  );

  if (
    receivedPkt.length() > 0 &&
    receivedPkt.toInt() > 0
  )
  {
    lastValidPktTime = millis();
    digitalWrite(GREEN_LED_PIN, HIGH);
  }

  /*
   * Main UI altitude must ALWAYS come from the onboard barometer.
   * The GS STM32 forwards barometric altitude as A1FT.
   *
   * Do not search for "ALTFT" here because "ALTFT=" is also a
   * substring of "GPSALTFT=", which caused the ESP32 to accidentally
   * use GPS altitude for the main Altitude card.
   */
  String receivedAltitude =
    getValue(
      line,
      "A1FT"
    );

  if (
    receivedAltitude.length() > 0 &&
    receivedAltitude != "---"
  )
  {
    altitudeFt =
      receivedAltitude;
  }

  /*
   * Update onboard coordinates only when BOTH new values are valid.
   * If a later packet has missing/invalid coordinates, keep the
   * last valid coordinates so the UI and map retain last known position.
   */
  String receivedLatitude =
    getValue(
      line,
      "LAT"
    );

  String receivedLongitude =
    getValue(
      line,
      "LON"
    );

  double parsedLatitude = 0.0;
  double parsedLongitude = 0.0;

  bool receivedCoordinatesValid =
    stringToDouble(
      receivedLatitude,
      parsedLatitude
    ) &&
    stringToDouble(
      receivedLongitude,
      parsedLongitude
    ) &&
    parsedLatitude >= -90.0 &&
    parsedLatitude <= 90.0 &&
    parsedLongitude >= -180.0 &&
    parsedLongitude <= 180.0 &&
    parsedLatitude != 0.0 &&
    parsedLongitude != 0.0;

  if (receivedCoordinatesValid)
  {
    latitude = receivedLatitude;
    longitude = receivedLongitude;
  }

  saveField(
    line,
    "DESCFTS",
    descentFtS
  );

  saveField(
    line,
    "SATS",
    satellites
  );

  saveField(
    line,
    "FIX",
    gpsFixType
  );

  saveField(
    line,
    "GPSALTFT",
    gpsAltitudeFt
  );

  saveField(
    line,
    "GPSVSFTS",
    gpsVerticalSpeedFtS
  );

  saveField(
    line,
    "GPSAGE",
    gpsAgeMs
  );

  saveField(
    line,
    "BATV",
    batteryVoltage
  );

  saveField(
    line,
    "GSBATV",
    groundStationBatteryVoltage
  );

  saveField(
    line,
    "RSSI",
    loraRssi
  );

  saveField(
    line,
    "SNR",
    loraSnr
  );

saveField(
    line,
    "RFHZ",
    actualRadioFrequencyHz
);

  Serial.println(line);
}

void parseGroundStationLine(const String& line)
{
  if (!line.startsWith("GS,"))
  {
    return;
  }

  String value = getValue(
    line,
    "GSBATV"
  );

  if (value.length() > 0)
  {
    groundStationBatteryVoltage =
      value;
  }

  String receivedFlashUsed =
    getValue(
      line,
      "USED"
    );

  String receivedFlashTotal =
    getValue(
      line,
      "TOTAL"
    );

  if (receivedFlashUsed.length() > 0)
  {
    flashUsedBytes =
      receivedFlashUsed;
    flashInfoRequestTime = 0;
  }

  if (receivedFlashTotal.length() > 0)
  {
    flashTotalBytes =
      receivedFlashTotal;
  }

  String receivedFlashStatus =
    getValue(
      line,
      "FLASHSTATUS"
    );

  if (receivedFlashStatus.length() > 0)
  {
    flashStatus =
      receivedFlashStatus;

    flashMaintenanceActive =
      receivedFlashStatus == "COMMAND_SENT" ||
      receivedFlashStatus == "CLEARING" ||
      receivedFlashStatus == "VERIFYING";

    String receivedVerify =
      getValue(
        line,
        "VERIFY"
      );

    String receivedBytes =
      getValue(
        line,
        "BYTES"
      );

    if (receivedVerify.length() > 0)
    {
      flashVerify = receivedVerify;
    }

    if (receivedBytes.length() > 0)
    {
      flashBytes = receivedBytes;
    }

    if (
      receivedFlashStatus == "EMPTY" ||
      receivedFlashStatus == "FAILED" ||
      receivedFlashStatus == "SEND_FAILED"
    )
    {
      flashMaintenanceActive = false;
      flashCommandTime = 0;

      if (
        receivedFlashStatus == "EMPTY" &&
        flashVerify == "FULL"
      )
      {
        flashUsedBytes = "0";
        flashTotalBytes = "16777216";
      }
    }
  }

  String receivedMainAltitude =
    getValue(
      line,
      "MAINALTFT"
    );

  if (
    receivedMainAltitude.length() > 0 &&
    receivedMainAltitude != "UNKNOWN"
  )
  {
    currentMainAltitudeFt =
      receivedMainAltitude;
  }

  String receivedMainAltitudeStatus =
    getValue(
      line,
      "MAINALTSTATUS"
    );

  if (receivedMainAltitudeStatus.length() > 0)
  {
    if (
      receivedMainAltitudeStatus == "CHANGED" ||
      receivedMainAltitudeStatus == "ALREADY_SET" ||
      receivedMainAltitudeStatus == "OK"
    )
    {
      mainAltitudeStatus = "READY";
      requestedMainAltitudeFt = "";
      mainAltitudeCommandTime = 0;
    }
    else
    {
      mainAltitudeStatus =
        receivedMainAltitudeStatus;

      if (
        receivedMainAltitudeStatus == "NO_ACK" ||
        receivedMainAltitudeStatus == "SEND_FAILED" ||
        receivedMainAltitudeStatus == "INVALID" ||
        receivedMainAltitudeStatus == "REJECTED" ||
        receivedMainAltitudeStatus == "BAD_ACK"
      )
      {
        requestedMainAltitudeFt = "";
        mainAltitudeCommandTime = 0;
      }
    }
  }
  else if (
    line.indexOf("GS,HEALTH,") == 0 &&
    receivedMainAltitude.length() > 0 &&
    mainAltitudeCommandTime == 0
  )
  {
    /*
     * A health response is the authoritative startup sync for the persisted
     * onboard MAIN altitude.
     */
    mainAltitudeStatus = "READY";
  }

  String receivedFrequency =
    getValue(
      line,
      "FREQ"
    );

  String receivedStatus =
    getValue(
      line,
      "FREQSTATUS"
    );

  /*
   * Some frequency responses may use STATUS= instead of FREQSTATUS=.
   * getValue() now requires a complete field-name match, so this can
   * no longer accidentally read FLASHSTATUS=CLEARING/COMMAND_SENT.
   */
  if (receivedStatus.length() == 0)
  {
    receivedStatus =
      getValue(
        line,
        "STATUS"
      );
  }

  if (
    line.indexOf("FREQACK") >= 0 &&
    receivedStatus.length() == 0
  )
  {
    receivedStatus =
      "CHANGED";
  }

  if (
    line.indexOf("NO_ACK") >= 0 &&
    receivedStatus.length() == 0
  )
  {
    receivedStatus =
      "NO_ACK";
  }

  if (
    line.indexOf("INVALID") >= 0 &&
    receivedStatus.length() == 0
  )
  {
    receivedStatus =
      "INVALID";
  }

  if (
    receivedStatus == "CHANGED" ||
    receivedStatus == "ALREADY_SET" ||
    receivedStatus == "SUCCESS" ||
    receivedStatus == "OK"
  )
  {
    if (receivedFrequency.length() > 0)
    {
      currentLoraFrequency =
        receivedFrequency;
    }
    else if (
      requestedLoraFrequency.length() > 0
    )
    {
      currentLoraFrequency =
        requestedLoraFrequency;
    }

    frequencyStatus =
      "READY";

    requestedLoraFrequency = "";
    frequencyCommandTime = 0;
  }
  else if (receivedStatus.length() > 0)
  {
    frequencyStatus =
      receivedStatus;

    if (
      receivedStatus == "NO_ACK" ||
      receivedStatus == "FAILED" ||
      receivedStatus == "INVALID" ||
      receivedStatus == "REJECTED"
    )
    {
      requestedLoraFrequency = "";
      frequencyCommandTime = 0;
    }
  }

  Serial.println(line);
}

void readAtlas()
{
  while (AtlasSerial.available())
  {
    char receivedCharacter =
      AtlasSerial.read();

    uartCharCount++;

    if (receivedCharacter == '\n')
    {
      inputLine.trim();

      if (inputLine.length() > 0)
{
  if (inputLine.startsWith("DATA,"))
  {
    parseDataLine(inputLine);
  }
  else if (inputLine.startsWith("GS,"))
  {
    parseGroundStationLine(inputLine);
  }
}

      inputLine = "";
    }
    else if (receivedCharacter != '\r')
    {
      inputLine +=
        receivedCharacter;

      if (inputLine.length() > 350)
      {
        inputLine = "";
      }
    }
  }
}

