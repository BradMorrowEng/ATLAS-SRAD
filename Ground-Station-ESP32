        const measurements =
          frameDocument.createElement("div");

        measurements.id =
          "atlasLoraMeasurements";

        measurements.textContent =
          "-- dBm • -- dB SNR";

        card.appendChild(measurements);
      }

      if (!card.querySelector(
        "#atlasLoraGuide"
      )) {
        const guide =
          frameDocument.createElement("div");

        guide.id =
          "atlasLoraGuide";

        guide.innerHTML = `
          <div class="atlasLoraGuideRow">
            <span>Excellent</span>
            <span>&gt; -70 dBm • &gt; +8 dB SNR</span>
          </div>
          <div class="atlasLoraGuideRow">
            <span>Very good</span>
            <span>-70 to -90 dBm • +4 to +8 dB</span>
          </div>
          <div class="atlasLoraGuideRow">
            <span>Good</span>
            <span>-90 to -105 dBm • 0 to +4 dB</span>
          </div>
          <div class="atlasLoraGuideRow">
            <span>Weak</span>
            <span>-105 to -115 dBm • -5 to 0 dB</span>
          </div>
          <div class="atlasLoraGuideRow">
            <span>Near limit</span>
            <span>&lt; -115 dBm • &lt; -5 dB</span>
          </div>
          <div id="atlasLoraHint">
            Tap the card to close
          </div>
        `;

        card.appendChild(guide);

        card.style.cursor =
          "pointer";

        card.addEventListener(
          "click",
          () => {
            guide.classList.toggle(
              "open"
            );
          }
        );
      }
    }

    function updateLoraDisplay(data) {
      addLoraGuide();

      const card =
        findLoraStrengthCard();

      if (!card) {
        return;
      }

      const descendants =
        card.querySelectorAll("*");

      for (const element of descendants) {
        if (
          element.children.length === 0 &&
          element.textContent.trim() ===
            "Radio connection quality"
        ) {
          element.style.display = "none";
        }
      }

      const measurements =
        card.querySelector(
          "#atlasLoraMeasurements"
        );

      if (!measurements) {
        return;
      }

      const rssi =
        data.rssi || "--";

      const snr =
        data.snr || "--";

      measurements.textContent =
        `${rssi} dBm • ${snr} dB SNR`;
    }

