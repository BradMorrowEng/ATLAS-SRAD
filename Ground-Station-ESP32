void handleClearBlackBox()
{
  if (
    flashStatus == "COMMAND_SENT" ||
    flashStatus == "CLEARING"
  )
  {
    server.send(
      409,
      "application/json",
      "{\"ok\":false,\"message\":\"Flash clear already in progress\"}"
    );

    return;
  }

  /*
   * Send the exact confirmation token to ATLAS V1.
   * ATLAS V1 and ATLAS V2 both require the explicit token.
   */
  AtlasSerial.print(
    "CLEARFLASH,CONFIRM=ERASE_W25Q128\r\n"
  );

  flashStatus = "COMMAND_SENT";
  flashMaintenanceActive = true;
  flashCommandTime = millis();

  Serial.println(
    "Sent to GS STM32: CLEARFLASH,CONFIRM=ERASE_W25Q128"
  );

  server.send(
    200,
    "application/json",
    "{\"ok\":true,\"message\":\"Flash clear command sent\"}"
  );
}

void handleNotFound()
{
  String requestedPath =
    server.uri();

  if (serveFileFromSD(requestedPath))
  {
    return;
  }

  server.send(
    404,
    "text/plain",
    "File not found: " +
    requestedPath
  );
}

void updateStatusLeds()
{
  /* Yellow means the ESP32 board is powered and running. */
  digitalWrite(YELLOW_LED_PIN, HIGH);

  /*
   * Green means a valid onboard packet number has been seen recently.
   * DATA,PKT=0 is ignored.
   * GS battery UART messages do not affect this LED.
   */
  bool pktFresh =
    lastValidPktTime > 0 &&
    (millis() - lastValidPktTime <= PKT_LED_TIMEOUT_MS);

  digitalWrite(
    GREEN_LED_PIN,
    pktFresh ? HIGH : LOW
  );
}

void startAtlasAccessPoint()
{
  WiFi.mode(WIFI_AP);

  IPAddress localIP(
    192,
    168,
    4,
    1
  );

  IPAddress gateway(
    192,
    168,
    4,
    1
  );

  IPAddress subnet(
    255,
    255,
    255,
    0
  );

  if (!WiFi.softAPConfig(
    localIP,
    gateway,
    subnet
  ))
  {
    Serial.println(
      "ATLAS AP IP configuration failed"
    );
  }

  bool started =
    WiFi.softAP(
      AP_NAME,
      AP_PASS
    );

  if (started)
  {
    Serial.println();

    Serial.println(
      "ATLAS Ground Station WiFi started"
    );

    Serial.print(
      "WiFi: "
    );

    Serial.println(
      AP_NAME
    );

    Serial.print(
      "IP: "
    );

    Serial.println(
      WiFi.softAPIP()
    );

    Serial.println(
      "Open: http://192.168.4.1"
    );
  }
  else
  {
    Serial.println(
      "ERROR: ATLAS WiFi failed to start"
    );
  }
}

void setup()
{
  pinMode(GREEN_LED_PIN, OUTPUT);
  pinMode(YELLOW_LED_PIN, OUTPUT);

  digitalWrite(GREEN_LED_PIN, LOW);
  digitalWrite(YELLOW_LED_PIN, HIGH);

  Serial.begin(115200);

  delay(1500);

  Serial.println();

  Serial.println(
    "ATLAS Ground Station Starting"
  );

  AtlasSerial.begin(
    ATLAS_BAUD,
    SERIAL_8N1,
    ATLAS_RX_PIN,
    ATLAS_TX_PIN
  );

  GroundGpsSerial.begin(
    GS_GPS_BAUD,
    SERIAL_8N1,
    GS_GPS_RX_PIN,
    GS_GPS_TX_PIN
  );

  sdSPI.begin(
    SD_SCK_PIN,
    SD_MISO_PIN,
    SD_MOSI_PIN,
    SD_CS_PIN
  );

  Serial.println(
    "Starting microSD card"
  );

  if (!SD.begin(
    SD_CS_PIN,
    sdSPI,
    10000000
  ))
  {
    Serial.println(
      "microSD initialization failed"
    );

    return;
  }

  Serial.println(
    "microSD initialized"
  );

  if (SD.exists("/index.html"))
  {
    Serial.println(
      "index.html found"
    );
  }
  else
  {
    Serial.println(
      "ERROR: index.html missing"
    );
  }

  startAtlasAccessPoint();

  if (MDNS.begin("atlas"))
  {
    Serial.println(
      "Open: http://atlas.local"
    );
  }
  else
  {
    Serial.println(
      "mDNS failed"
    );
  }

  server.on(
    "/",
    HTTP_GET,
    handleRoot
  );

  server.on(
    "/original-ui",
    HTTP_GET,
    handleOriginalUi
  );

  server.on(
    "/data",
    HTTP_GET,
    handleData
  );

  server.on(
  "/set-frequency",
  HTTP_POST,
  handleSetFrequency
);

server.on(
  "/set-main-altitude",
  HTTP_POST,
  handleSetMainAltitude
);

server.on(
  "/main-altitude-info",
  HTTP_POST,
  handleMainAltitudeInfo
);

server.on(
  "/flash-info",
  HTTP_POST,
  handleFlashInfo
);

server.on(
  "/clear-blackbox",
  HTTP_POST,
  handleClearBlackBox
);

server.onNotFound(
  handleNotFound
);
  server.begin();
  Serial.println(
    "Web server started"
  );
}

void loop()
{
  updateStatusLeds();
  readAtlas();
  readGroundGps();

  if (
    frequencyCommandTime > 0 &&
    millis() - frequencyCommandTime >
    FREQUENCY_COMMAND_TIMEOUT_MS
  )
  {
    frequencyStatus =
      "TIMEOUT";

    requestedLoraFrequency = "";
    frequencyCommandTime = 0;
  }

  if (
    mainAltitudeCommandTime > 0 &&
    millis() - mainAltitudeCommandTime >
      MAIN_ALTITUDE_COMMAND_TIMEOUT_MS
  )
  {
    mainAltitudeStatus =
      "TIMEOUT";

    requestedMainAltitudeFt = "";
    mainAltitudeCommandTime = 0;
  }

  if (
    flashInfoRequestTime > 0 &&
    millis() - flashInfoRequestTime > 2500UL
  )
  {
    flashInfoRequestTime = 0;
  }

  if (
    flashCommandTime > 0 &&
    millis() - flashCommandTime >
    FLASH_COMMAND_TIMEOUT_MS
  )
  {
    flashStatus = "TIMEOUT";
    flashVerify = "NOT RUN";
    flashMaintenanceActive = false;
    flashCommandTime = 0;
  }
  server.handleClient();
}
