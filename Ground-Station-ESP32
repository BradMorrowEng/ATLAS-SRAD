        .catch(() => {
          atlasPanelMessage.innerText =
            "Flash info request failed";
        });
    }

    window.addEventListener(
      "message",
      event => {
        if (event.data === "ATLAS_OPEN_FLASH")
        {
          flashPanelFull.classList.add("open");
          requestFlashInfoPanel();
