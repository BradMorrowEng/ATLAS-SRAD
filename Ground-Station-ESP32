  );
  json += "\",";

  json += "\"flashUsedBytes\":\"";
  json += escapeJson(
    flashUsedBytes
  );
  json += "\",";

  json += "\"flashTotalBytes\":\"";
  json += escapeJson(
    flashTotalBytes
  );
  json += "\",";

  json += "\"chars\":";
  json += String(uartCharCount);

  json += "}";

  server.sendHeader(
    "Cache-Control",
    "no-store"
  );

  server.send(
    200,
    "application/json",
    json
  );
}

bool validFrequency(
  const String& frequency
)
{
  double mhz =
    frequency.toDouble();

  if (
    frequency == "915.0" ||
    frequency == "921.8"
  )
  {
    return true;
  }

  for (
    int channel = 0;
    channel < 64;
    channel++
  )
  {
    double channelMhz =
      902.3 +
      channel * 0.2;

    if (
      fabs(
        mhz - channelMhz
      ) < 0.01
    )
    {
      return true;
    }
  }

  for (
    int channel = 0;
    channel < 8;
    channel++
  )
  {
    double channelMhz =
      903.0 +
      channel * 1.6;

    if (
      fabs(
        mhz - channelMhz
      ) < 0.01
    )
    {
      return true;
    }
  }

  for (
    int channel = 0;
    channel < 8;
    channel++
  )
  {
    double channelMhz =
      923.3 +
      channel * 0.6;

    if (
      fabs(
        mhz - channelMhz
      ) < 0.01
    )
    {
      return true;
    }
  }

  return false;
}

void handleSetFrequency()
{
  if (!server.hasArg("mhz"))
  {
    server.send(
      400,
      "application/json",
      "{\"ok\":false,\"message\":\"Missing frequency\"}"
    );

    return;
  }

  String requestedFrequency =
    server.arg("mhz");

  requestedFrequency.trim();

  if (!validFrequency(
    requestedFrequency
  ))
  {
    server.send(
      400,
      "application/json",
      "{\"ok\":false,\"message\":\"Invalid frequency\"}"
    );

    return;
  }

  if (
    requestedFrequency ==
    currentLoraFrequency
  )
  {
    frequencyStatus =
      "ALREADY_SET";

    server.send(
      200,
      "application/json",
      "{\"ok\":true,\"message\":\"Frequency already selected\"}"
    );

    return;
  }

  uint32_t frequencyHz =
    (uint32_t)llround(
      requestedFrequency.toDouble() *
      1000000.0
    );

  requestedLoraFrequency =
    requestedFrequency;

  frequencyStatus =
    "PENDING";

  frequencyCommandTime =
    millis();

  AtlasSerial.printf(
  "SETFREQ,%lu\r\n",
  (unsigned long)frequencyHz
);

Serial.printf(
  "Sent to GS STM32: SETFREQ,%lu\n",
  (unsigned long)frequencyHz
);

  server.send(
    200,
    "application/json",
    "{\"ok\":true,\"message\":\"Frequency command sent\"}"
  );
}

void handleSetMainAltitude()
{
  if (!server.hasArg("ft"))
  {
    server.send(
      400,
      "application/json",
      "{\"ok\":false,\"message\":\"Missing altitude\"}"
    );

    return;
  }

  String requestedAltitude =
    server.arg("ft");

  requestedAltitude.trim();

  if (requestedAltitude.length() == 0)
  {
    server.send(
      400,
      "application/json",
      "{\"ok\":false,\"message\":\"Invalid altitude\"}"
    );

    return;
  }

  for (size_t i = 0; i < requestedAltitude.length(); i++)
  {
    if (!isDigit(requestedAltitude.charAt(i)))
    {
      server.send(
        400,
        "application/json",
        "{\"ok\":false,\"message\":\"Invalid altitude\"}"
      );

      return;
    }
  }

  uint32_t altitudeFt =
    (uint32_t)requestedAltitude.toInt();

  if (
    altitudeFt < 100UL ||
    altitudeFt > 10000UL
  )
  {
    server.send(
      400,
      "application/json",
      "{\"ok\":false,\"message\":\"Altitude must be 100-10000 ft\"}"
    );

    return;
  }

  if (
    requestedMainAltitudeFt.length() > 0 &&
    mainAltitudeCommandTime > 0
  )
  {
    server.send(
      409,
      "application/json",
      "{\"ok\":false,\"message\":\"MAIN altitude command already pending\"}"
    );

    return;
  }

  if (
    currentMainAltitudeFt.length() > 0 &&
    requestedAltitude ==
      currentMainAltitudeFt
  )
  {
    mainAltitudeStatus = "READY";

    server.send(
      200,
      "application/json",
      "{\"ok\":true,\"message\":\"MAIN altitude already selected\"}"
    );

    return;
  }

  requestedMainAltitudeFt =
    requestedAltitude;

  mainAltitudeStatus =
    "PENDING";

  mainAltitudeCommandTime =
    millis();

  AtlasSerial.printf(
    "SETMAINALT,%lu\r\n",
    (unsigned long)altitudeFt
  );

  Serial.printf(
    "Sent to GS STM32: SETMAINALT,%lu\n",
    (unsigned long)altitudeFt
  );

  server.send(
    200,
    "application/json",
    "{\"ok\":true,\"message\":\"MAIN altitude command sent\"}"
  );
}

