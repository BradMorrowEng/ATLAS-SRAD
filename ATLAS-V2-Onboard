static uint8_t MS5607_Init(void)
{
   const uint16_t addresses[2] = {(0x76U << 1), (0x77U << 1)};
   for (uint8_t a = 0; a < 2; a++)
   {
       ms5607_addr = addresses[a];
       uint8_t cmd = 0x1E;
       if (HAL_I2C_Master_Transmit(&hi2c1, ms5607_addr, &cmd, 1, 100) != HAL_OK)
       {
           continue;
       }
       HAL_Delay(4);
       uint8_t good_prom = 1;
       for (uint8_t i = 1; i <= 6; i++)
       {
           uint8_t prom_cmd = (uint8_t)(0xA0 + (i * 2));
           uint8_t rx[2] = {0};
           if (HAL_I2C_Master_Transmit(&hi2c1, ms5607_addr,
                                       &prom_cmd, 1, 100) != HAL_OK ||
               HAL_I2C_Master_Receive(&hi2c1, ms5607_addr,
                                      rx, 2, 100) != HAL_OK)
           {
               good_prom = 0;
               break;
           }
           ms5607_c[i] = ((uint16_t)rx[0] << 8) | rx[1];
           if (ms5607_c[i] == 0x0000 || ms5607_c[i] == 0xFFFF)
           {
               good_prom = 0;
           }
       }
       if (good_prom)
       {
           return 1;
       }
   }
   return 0;
}
static uint8_t MS5607_ReadADC(uint8_t cmd, uint32_t *adc)
{
   uint8_t rx[3] = {0};
   uint8_t adc_cmd = 0x00;
   if (HAL_I2C_Master_Transmit(&hi2c1, ms5607_addr, &cmd, 1, 100) != HAL_OK)
   {
       return 0;
   }
   HAL_Delay(10);
   if (HAL_I2C_Master_Transmit(&hi2c1, ms5607_addr, &adc_cmd, 1, 100) != HAL_OK)
   {
       return 0;
   }
   if (HAL_I2C_Master_Receive(&hi2c1, ms5607_addr, rx, 3, 100) != HAL_OK)
   {
       return 0;
   }
   *adc = ((uint32_t)rx[0] << 16) |
          ((uint32_t)rx[1] << 8) |
          (uint32_t)rx[2];
   return 1;
}
static uint8_t MS5607_Read(int32_t *pressure_pa, int32_t *temp_c100)
{
   uint32_t d1 = 0;
   uint32_t d2 = 0;
   if (!MS5607_ReadADC(0x48, &d1))
   {
       return 0;
   }
   if (!MS5607_ReadADC(0x58, &d2))
   {
       return 0;
   }
   int64_t dT = (int64_t)d2 - ((int64_t)ms5607_c[5] << 8);
   int64_t temp = 2000 + ((dT * (int64_t)ms5607_c[6]) >> 23);
   int64_t off = ((int64_t)ms5607_c[2] << 17) +
                 (((int64_t)ms5607_c[4] * dT) >> 6);
   int64_t sens = ((int64_t)ms5607_c[1] << 16) +
                  (((int64_t)ms5607_c[3] * dT) >> 7);
   int64_t t2 = 0;
   int64_t off2 = 0;
   int64_t sens2 = 0;
   if (temp < 2000)
   {
       int64_t dt_low = temp - 2000;
       t2 = (dT * dT) >> 31;
       off2 = (61 * dt_low * dt_low) >> 4;
       sens2 = 2 * dt_low * dt_low;
       if (temp < -1500)
       {
           int64_t dt_very_low = temp + 1500;
           off2 += 15 * dt_very_low * dt_very_low;
           sens2 += 8 * dt_very_low * dt_very_low;
       }
   }
   temp -= t2;
   off -= off2;
   sens -= sens2;
   int64_t p = ((((int64_t)d1 * sens) >> 21) - off) >> 15;
   if (p < 1000 || p > 200000)
   {
       return 0;
   }
   *pressure_pa = (int32_t)p;
   *temp_c100 = (int32_t)temp;
   return 1;
}
static void Baro_SetBaseline(void)
{
   int64_t sum = 0;
   uint8_t count = 0;
   /* Let barometer settle after startup */
   HAL_Delay(1000);
   /* Throw away initial readings */
   for (uint8_t i = 0; i < 10; i++)
   {
       int32_t pressure_pa;
       int32_t temp_c100;
       MS5607_Read(
           &pressure_pa,
           &temp_c100
       );
       HAL_Delay(20);
   }
   /* Build stable launch-pad pressure reference */
   for (uint8_t i = 0; i < 50; i++)
   {
       int32_t pressure_pa = 0;
       int32_t temp_c100 = 0;
       if (MS5607_Read(
               &pressure_pa,
               &temp_c100))
       {
           sum += pressure_pa;
           count++;
       }
       HAL_Delay(20);
   }
   if (count > 0)
   {
       baro_base_pa =
           (int32_t)(sum / count);
   }
   /* Launch position = ZERO */
   baro_alt_ft10 = 0;
   baro_filtered_alt_ft10 = 0;
   /* No motion at startup */
   baro_descent_ft10s = 0;
   baro_raw_vertical_speed_ft10s = 0;
   baro_velocity_alt_ft10 = 0;
   baro_velocity_time_ms =
       HAL_GetTick();
   baro_filter_ready = 1;
}
static int32_t AltitudeFtX10(int32_t pressure_pa, int32_t base_pa)
{
   if (pressure_pa <= 0 || base_pa <= 0)
   {
       return 0;
   }
   float ratio = (float)pressure_pa / (float)base_pa;
   float altitude_m = 44330.0f * (1.0f - powf(ratio, 0.19029495f));
   float altitude_ft10 = altitude_m * 3.280839895f * 10.0f;
   if (altitude_ft10 >= 0.0f)
   {
       return (int32_t)(altitude_ft10 + 0.5f);
   }
   return (int32_t)(altitude_ft10 - 0.5f);
}
static void Baro_Service(uint32_t now_ms)
{
   static uint32_t last_sample_ms = 0;
   static uint32_t last_retry_ms = 0;
   if (!baro_ok)
   {
       if ((now_ms - last_retry_ms) >= 3000UL)
       {
           last_retry_ms = now_ms;
           baro_ok = MS5607_Init();
           if (baro_ok)
           {
               if (!flight_launch_detected)
               {
                   /*
                    * Before launch it is safe to rebuild the pad-pressure
                    * reference after a sensor retry.
                    */
                   Baro_SetBaseline();
               }
               else
               {
                   /*
                    * NEVER redefine the pad baseline after launch.
                    * Re-seed only the live filter from the preserved pad
                    * pressure reference.
                    */
                   baro_filter_ready = 0;
               }
           }
       }
       return;
   }
   uint32_t current_baro_interval_ms =
       FlightLogic_IsRecovery() ?
       RECOVERY_BARO_INTERVAL_MS :
       BARO_SAMPLE_INTERVAL_MS;
   if (
       (now_ms - last_sample_ms) <
       current_baro_interval_ms
   )
   {
       return;
   }
   last_sample_ms = now_ms;
   if (!MS5607_Read(&baro_pressure_pa, &baro_temp_c100))
   {
       baro_ok = 0;
       return;
   }
   baro_alt_ft10 = AltitudeFtX10(baro_pressure_pa, baro_base_pa);
   if (!baro_filter_ready)
   {
       baro_filtered_alt_ft10 = baro_alt_ft10;
       baro_velocity_alt_ft10 = baro_filtered_alt_ft10;
       baro_velocity_time_ms = now_ms;
       baro_descent_ft10s = 0;
       baro_raw_vertical_speed_ft10s = 0;
       baro_filter_ready = 1;
       return;
   }
   baro_filtered_alt_ft10 =
       (baro_filtered_alt_ft10 * 7 + baro_alt_ft10 * 3) / 10;
   uint32_t dt_ms = now_ms - baro_velocity_time_ms;
   if (dt_ms >= 300UL)
   {
       int32_t delta_alt_ft10 =
           baro_filtered_alt_ft10 - baro_velocity_alt_ft10;
       int32_t vertical_speed_ft10s =
           (int32_t)(((int64_t)delta_alt_ft10 * 1000LL) / (int64_t)dt_ms);
       /*
        * Signed barometric vertical speed:
        * positive = ascending
        * negative = descending
        *
        * Keep both values:
        * raw is retained for logging and diagnostics only.
        * filtered remains the flight-state/descent control value.
        */
       baro_raw_vertical_speed_ft10s =
           vertical_speed_ft10s;
       baro_velocity_sample_sequence++;
       baro_descent_ft10s =
           (baro_descent_ft10s * 7 + vertical_speed_ft10s * 3) / 10;
       baro_velocity_alt_ft10 = baro_filtered_alt_ft10;
       baro_velocity_time_ms = now_ms;
   }
}
static uint8_t GPS_SendUBX(uint8_t msg_class, uint8_t msg_id,
                          const uint8_t *payload, uint16_t payload_len)
{
   if (payload_len > 80)
   {
       return 0;
   }
   uint8_t frame[88];
   uint16_t index = 0;
   uint8_t ck_a = 0;
   uint8_t ck_b = 0;
   frame[index++] = 0xB5;
   frame[index++] = 0x62;
   frame[index++] = msg_class;
   frame[index++] = msg_id;
   frame[index++] = (uint8_t)(payload_len & 0xFF);
   frame[index++] = (uint8_t)(payload_len >> 8);
   for (uint16_t i = 2; i < index; i++)
   {
       ck_a = (uint8_t)(ck_a + frame[i]);
       ck_b = (uint8_t)(ck_b + ck_a);
   }
   for (uint16_t i = 0; i < payload_len; i++)
   {
       frame[index++] = payload[i];
       ck_a = (uint8_t)(ck_a + payload[i]);
       ck_b = (uint8_t)(ck_b + ck_a);
   }
   frame[index++] = ck_a;
   frame[index++] = ck_b;
   return HAL_I2C_Master_Transmit(&hi2c1,
                                   GPS_I2C_ADDRESS,
                                   frame,
                                   index,
                                   100) == HAL_OK;
}
static void PutU4LE(uint8_t *p, uint32_t value)
{
   p[0] = (uint8_t)(value & 0xFF);
   p[1] = (uint8_t)((value >> 8) & 0xFF);
   p[2] = (uint8_t)((value >> 16) & 0xFF);
   p[3] = (uint8_t)((value >> 24) & 0xFF);
}
static void PutU2LE(uint8_t *p, uint16_t value)
{
   p[0] = (uint8_t)(value & 0xFF);
   p[1] = (uint8_t)(value >> 8);
}
static uint8_t GPS_Configure(void)
{
   uint8_t payload[64] = {0};
   uint16_t i = 0;
   payload[i++] = 0x00;
   payload[i++] = 0x01;
   payload[i++] = 0x00;
   payload[i++] = 0x00;
   PutU4LE(&payload[i], GPS_CFG_I2C_ENABLED);
   i += 4;
   payload[i++] = 1;
   PutU4LE(&payload[i], GPS_CFG_I2CINPROT_UBX);
   i += 4;
   payload[i++] = 1;
   PutU4LE(&payload[i], GPS_CFG_I2COUTPROT_UBX);
   i += 4;
   payload[i++] = 1;
   PutU4LE(&payload[i], GPS_CFG_I2COUTPROT_NMEA);
   i += 4;
   payload[i++] = 0;
   PutU4LE(&payload[i], GPS_CFG_MSGOUT_NAV_PVT_I2C);
   i += 4;
   payload[i++] = 1;
   PutU4LE(&payload[i], GPS_CFG_RATE_MEAS);
   i += 4;
   PutU2LE(&payload[i], 250);
   i += 2;
   PutU4LE(&payload[i], GPS_CFG_RATE_NAV);
   i += 4;
   PutU2LE(&payload[i], 1);
   i += 2;
   PutU4LE(&payload[i], GPS_CFG_NAVSPG_DYNMODEL);
   i += 4;
   payload[i++] = GPS_DYNMODEL_AIRBORNE_4G;
   if (!GPS_SendUBX(0x06, 0x8A, payload, i))
   {
       return 0;
   }
   HAL_Delay(100);
   return 1;
}
static uint8_t GPS_Init(void)
{
   if (HAL_I2C_IsDeviceReady(&hi2c1,
                             GPS_I2C_ADDRESS,
                             3,
                             100) != HAL_OK)
   {
       gps.present = 0;
       gps.configured = 0;
       gps.fix_ok = 0;
       return 0;
   }
   gps.present = 1;
   gps.configured = GPS_Configure();
   gps.fix_ok = 0;
   memset(&gps_parser, 0, sizeof(gps_parser));
   return 1;
}
static void GPS_PollNavPvt(void)
{
   if (!gps.present)
   {
       return;
   }
   GPS_SendUBX(0x01, 0x07, NULL, 0);
}
static int32_t ReadI4LE(const uint8_t *p)
{
   uint32_t value =
       ((uint32_t)p[0]) |
       ((uint32_t)p[1] << 8) |
       ((uint32_t)p[2] << 16) |
       ((uint32_t)p[3] << 24);
   return (int32_t)value;
}
static void GPS_HandleMessage(uint8_t msg_class, uint8_t msg_id,
                             const uint8_t *payload, uint16_t payload_len)
{
   if (msg_class != 0x01 || msg_id != 0x07 || payload_len != 92)
   {
       return;
   }
   gps.present = 1;
   gps.last_message_ms = HAL_GetTick();
   gps.fix_type = payload[20];
   gps.sats = payload[23];
   uint8_t flags = payload[21];
   uint8_t flags3_lsb = payload[78];
   uint8_t invalid_llh = flags3_lsb & 0x01;
   gps.fix_ok =
       ((flags & 0x01) != 0) &&
       (gps.fix_type >= 2) &&
       (gps.fix_type <= 4) &&
       !invalid_llh;
   if (gps.fix_ok)
   {
       gps.lon_e7 = ReadI4LE(&payload[24]);
       gps.lat_e7 = ReadI4LE(&payload[28]);
       gps.hmsl_mm = ReadI4LE(&payload[36]);
       int32_t vel_n_mmps =
           ReadI4LE(&payload[48]);
       int32_t vel_e_mmps =
           ReadI4LE(&payload[52]);
       gps.vel_d_mmps =
           ReadI4LE(&payload[56]);
       gps.speed_3d_mmps =
           FlightLogic_VectorMagnitude(
               vel_n_mmps,
               vel_e_mmps,
               gps.vel_d_mmps
           );
       gps.last_fix_ms = gps.last_message_ms;
   }
}
static void GPS_FeedByte(uint8_t byte)
{
   switch (gps_parser.state)
   {
       case 0:
           if (byte == 0xB5)
           {
               gps_parser.state = 1;
           }
           break;
       case 1:
           if (byte == 0x62)
           {
               gps_parser.state = 2;
               gps_parser.ck_a = 0;
               gps_parser.ck_b = 0;
               gps_parser.payload_index = 0;
               gps_parser.overflow = 0;
           }
           else if (byte != 0xB5)
           {
               gps_parser.state = 0;
           }
           break;
       case 2:
           gps_parser.msg_class = byte;
           gps_parser.ck_a = (uint8_t)(gps_parser.ck_a + byte);
           gps_parser.ck_b = (uint8_t)(gps_parser.ck_b + gps_parser.ck_a);
           gps_parser.state = 3;
           break;
       case 3:
           gps_parser.msg_id = byte;
           gps_parser.ck_a = (uint8_t)(gps_parser.ck_a + byte);
           gps_parser.ck_b = (uint8_t)(gps_parser.ck_b + gps_parser.ck_a);
           gps_parser.state = 4;
           break;
       case 4:
           gps_parser.payload_len = byte;
           gps_parser.ck_a = (uint8_t)(gps_parser.ck_a + byte);
           gps_parser.ck_b = (uint8_t)(gps_parser.ck_b + gps_parser.ck_a);
           gps_parser.state = 5;
           break;
       case 5:
           gps_parser.payload_len |= ((uint16_t)byte << 8);
           gps_parser.ck_a = (uint8_t)(gps_parser.ck_a + byte);
           gps_parser.ck_b = (uint8_t)(gps_parser.ck_b + gps_parser.ck_a);
           gps_parser.payload_index = 0;
           gps_parser.overflow = gps_parser.payload_len > sizeof(gps_parser.payload);
           gps_parser.state = (gps_parser.payload_len == 0) ? 7 : 6;
           break;
       case 6:
           if (!gps_parser.overflow &&
               gps_parser.payload_index < sizeof(gps_parser.payload))
           {
               gps_parser.payload[gps_parser.payload_index] = byte;
           }
           gps_parser.payload_index++;
           gps_parser.ck_a = (uint8_t)(gps_parser.ck_a + byte);
           gps_parser.ck_b = (uint8_t)(gps_parser.ck_b + gps_parser.ck_a);
           if (gps_parser.payload_index >= gps_parser.payload_len)
           {
               gps_parser.state = 7;
           }
           break;
       case 7:
           gps_parser.received_ck_a = byte;
           gps_parser.state = 8;
           break;
       case 8:
           if (gps_parser.received_ck_a == gps_parser.ck_a &&
               byte == gps_parser.ck_b &&
               !gps_parser.overflow)
           {
               GPS_HandleMessage(gps_parser.msg_class,
                                 gps_parser.msg_id,
                                 gps_parser.payload,
                                 gps_parser.payload_len);
           }
           gps_parser.state = 0;
           break;
       default:
           gps_parser.state = 0;
           break;
   }
}
static void GPS_Service(void)
{
   static uint8_t fail_count = 0;
   uint8_t length_bytes[2] = {0};
   if (!gps.present)
   {
       return;
   }
   if (HAL_I2C_Mem_Read(&hi2c1,
                        GPS_I2C_ADDRESS,
                        0xFD,
                        I2C_MEMADD_SIZE_8BIT,
                        length_bytes,
                        2,
                        30) != HAL_OK)
   {
       fail_count++;
       if (fail_count >= 5)
       {
           gps.present = 0;
           gps.configured = 0;
           gps.fix_ok = 0;
           fail_count = 0;
       }
       return;
   }
   fail_count = 0;
   uint16_t available = ((uint16_t)length_bytes[0] << 8) | length_bytes[1];
   if (available == 0)
   {
       if (gps.last_message_ms != 0 &&
           (HAL_GetTick() - gps.last_message_ms) > 2000UL)
       {
           gps.fix_ok = 0;
       }
       return;
   }
   if (available > 512)
   {
       available = 512;
   }
   uint8_t buffer[128];
   while (available > 0)
   {
       uint16_t chunk = available > sizeof(buffer) ? sizeof(buffer) : available;
       if (HAL_I2C_Mem_Read(&hi2c1,
                            GPS_I2C_ADDRESS,
                            0xFF,
                            I2C_MEMADD_SIZE_8BIT,
                            buffer,
                            chunk,
                            50) != HAL_OK)
       {
           break;
       }
       for (uint16_t i = 0; i < chunk; i++)
       {
           GPS_FeedByte(buffer[i]);
       }
       available -= chunk;
   }
   if (gps.last_message_ms != 0 &&
       (HAL_GetTick() - gps.last_message_ms) > 2000UL)
   {
       gps.fix_ok = 0;
   }
}
static int32_t MillimetersToFeetX10(int32_t mm)
{
   int64_t scaled = (int64_t)mm * 328084LL;
   if (scaled >= 0)
   {
       scaled += 5000000LL;
   }
   else
   {
       scaled -= 5000000LL;
   }
   return (int32_t)(scaled / 10000000LL);
}
static void FormatSigned1(char *out, size_t out_size, int32_t value_x10)
{
   int64_t value = value_x10;
   const char *sign = "";
   if (value < 0)
   {
       sign = "-";
       value = -value;
   }
   snprintf(out,
            out_size,
            "%s%ld.%01ld",
            sign,
            (long)(value / 10),
            (long)(value % 10));
}
static void FormatSigned3(char *out, size_t out_size, int32_t value_x1000)
{
   int negative = value_x1000 < 0;
   int64_t magnitude = value_x1000;
   if (magnitude < 0)
   {
       magnitude = -magnitude;
   }
   snprintf(out, out_size, "%s%ld.%03ld",
            negative ? "-" : "",
            (long)(magnitude / 1000),
            (long)(magnitude % 1000));
}
static void FormatCoordE7(char *out, size_t out_size, int32_t value_e7)
{
   int64_t value = value_e7;
   const char *sign = "";
   if (value < 0)
   {
       sign = "-";
       value = -value;
   }
   snprintf(out,
            out_size,
            "%s%ld.%07ld",
            sign,
            (long)(value / 10000000LL),
            (long)(value % 10000000LL));
}
