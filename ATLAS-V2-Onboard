static uint8_t IMU_ReadChecked(
   GPIO_TypeDef *cs_port,
   uint16_t cs_pin,
   int32_t *ax_g1000,
   int32_t *ay_g1000,
   int32_t *az_g1000,
   int32_t *gx_dps10,
   int32_t *gy_dps10,
   int32_t *gz_dps10
)
{
   if (
       !ax_g1000 || !ay_g1000 || !az_g1000 ||
       !gx_dps10 || !gy_dps10 || !gz_dps10
   )
   {
       return 0;
   }
   uint8_t tx[13] = {0};
   uint8_t rx[13] = {0};
   tx[0] = (uint8_t)(LSM6_OUTX_L_G | 0x80);
   IMU_AllUnselect();
   SPI3_SetModeIMU();
   HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_RESET);
   HAL_StatusTypeDef status =
       HAL_SPI_TransmitReceive(
           &hspi3,
           tx,
           rx,
           sizeof(tx),
           100
       );
   HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);
   if (status != HAL_OK)
   {
       *ax_g1000 = 0;
       *ay_g1000 = 0;
       *az_g1000 = 0;
       *gx_dps10 = 0;
       *gy_dps10 = 0;
       *gz_dps10 = 0;
       return 0;
   }
   const uint8_t *d = &rx[1];
   int16_t gx_raw = (int16_t)((uint16_t)d[0] | ((uint16_t)d[1] << 8));
   int16_t gy_raw = (int16_t)((uint16_t)d[2] | ((uint16_t)d[3] << 8));
   int16_t gz_raw = (int16_t)((uint16_t)d[4] | ((uint16_t)d[5] << 8));
   int16_t ax_raw = (int16_t)((uint16_t)d[6] | ((uint16_t)d[7] << 8));
   int16_t ay_raw = (int16_t)((uint16_t)d[8] | ((uint16_t)d[9] << 8));
   int16_t az_raw = (int16_t)((uint16_t)d[10] | ((uint16_t)d[11] << 8));
   *ax_g1000 = ((int32_t)ax_raw * 61) / 1000;
   *ay_g1000 = ((int32_t)ay_raw * 61) / 1000;
   *az_g1000 = ((int32_t)az_raw * 61) / 1000;
   *gx_dps10 = ((int32_t)gx_raw * 875) / 10000;
   *gy_dps10 = ((int32_t)gy_raw * 875) / 10000;
   *gz_dps10 = ((int32_t)gz_raw * 875) / 10000;
   return 1;
}
static void IMU_WriteReg(GPIO_TypeDef *cs_port, uint16_t cs_pin, uint8_t reg, uint8_t value)
{
   uint8_t tx[2] = {(uint8_t)(reg & 0x7F), value};
   IMU_AllUnselect();
   SPI3_SetModeIMU();
   HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_RESET);
   HAL_SPI_Transmit(&hspi3, tx, 2, 100);
   HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);
}
static void IMU_ReadRegs(GPIO_TypeDef *cs_port, uint16_t cs_pin, uint8_t reg, uint8_t *buf, uint8_t len)
{
   uint8_t tx[20] = {0};
   uint8_t rx[20] = {0};
   if (len > 18)
   {
       len = 18;
   }
   tx[0] = (uint8_t)(reg | 0x80);
   IMU_AllUnselect();
   SPI3_SetModeIMU();
   HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_RESET);
   HAL_SPI_TransmitReceive(&hspi3, tx, rx, (uint16_t)(len + 1), 100);
   HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);
   for (uint8_t i = 0; i < len; i++)
   {
       buf[i] = rx[i + 1];
   }
}
static uint8_t IMU_Init(GPIO_TypeDef *cs_port, uint16_t cs_pin, uint8_t *who)
{
   IMU_AllUnselect();
   HAL_Delay(50);
   *who = 0;
   for (uint8_t i = 0; i < 10; i++)
   {
       *who = IMU_ReadReg(cs_port, cs_pin, LSM6_WHO_AM_I);
       if (*who == 0x69)
       {
           break;
       }
       HAL_Delay(20);
   }
   if (*who != 0x69)
   {
       return 0;
   }
   IMU_WriteReg(cs_port, cs_pin, LSM6_CTRL3_C, 0x44);
   HAL_Delay(10);
   IMU_WriteReg(cs_port, cs_pin, LSM6_CTRL1_XL, 0x60);
   IMU_WriteReg(cs_port, cs_pin, LSM6_CTRL2_G, 0x60);
   IMU_WriteReg(cs_port, cs_pin, LSM6_CTRL9_XL, 0x38);
   IMU_WriteReg(cs_port, cs_pin, LSM6_CTRL10_C, 0x38);
   HAL_Delay(20);
   return IMU_ReadReg(cs_port, cs_pin, LSM6_WHO_AM_I) == 0x69;
}
