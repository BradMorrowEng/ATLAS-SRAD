static uint8_t BLACKBOX_WriteSessionRecord(
   BlackBoxSessionRecord_t *record
)
{
   if (!record)
   {
       return 0;
   }
   if (
       blackbox_next_address < BLACKBOX_START_ADDR ||
       blackbox_next_address + BLACKBOX_RECORD_SIZE > BLACKBOX_END_ADDR
   )
   {
       return 0;
   }
   record->crc16 = 0;
   record->crc16 =
       BLACKBOX_CRC16(
           (const uint8_t *)record,
           (uint16_t)(sizeof(BlackBoxSessionRecord_t) - sizeof(record->crc16))
       );
   FLASH_WritePage(
       blackbox_next_address,
       (const uint8_t *)record,
       sizeof(BlackBoxSessionRecord_t)
   );
   BlackBoxSessionRecord_t verify;
   FLASH_ReadData(
       blackbox_next_address,
       (uint8_t *)&verify,
       sizeof(verify)
   );
   if (
       memcmp(
           record,
           &verify,
           sizeof(BlackBoxSessionRecord_t)
       ) != 0
   )
   {
       return 0;
   }
   uint16_t verify_crc =
       BLACKBOX_CRC16(
           (const uint8_t *)&verify,
           (uint16_t)(sizeof(BlackBoxSessionRecord_t) - sizeof(verify.crc16))
       );
   if (verify_crc != verify.crc16)
   {
       return 0;
   }
   blackbox_next_address += BLACKBOX_RECORD_SIZE;
   return 1;
}
