   if (gps.fix_ok)
   {
       record.status_flags |= (1U << 2);
   }
   if (imu1_ok)
   {
       record.status_flags |= (1U << 3);
   }
   if (imu2_ok)
   {
       record.status_flags |= (1U << 4);
   }
   if (lora_ok)
   {
       record.status_flags |= (1U << 5);
   }
   if (highg_ok)
   {
       record.status_flags |= (1U << 6);
   }
   if (flight_baro_trusted)
   {
       record.status_flags |= (1U << 7);
   }
   record.timestamp_ms = timestamp_ms;
   record.session_number = blackbox_session_number;
   record.record_sequence = blackbox_record_sequence;
   record.event_id = (uint8_t)event_id;
   record.flight_state = (uint8_t)flight_state;
   record.baro_trusted = flight_baro_trusted;
   record.gyro_turnover_seen = flight_gyro_turnover_seen;
   record.event_flags = flight_event_flags;
   /*
    * Keep the permanent 128-byte V3 event-record layout unchanged.
    * Human-readable trace metadata is stored in the reserved region:
    *   reserved[0]      = simulated ARM GPIO state
    *   reserved[1]      = simulated FIRE GPIO state for this event
    *   reserved[2..5]   = related detection/reference timestamp
    *   reserved[6..9]   = detection-to-output delay in ms
    *   reserved[10..25] = readable flight state
    *   reserved[26..45] = readable event name
    *   reserved[46..49] = raw barometric vertical speed, ft/s x10
    *   reserved[50..51] = configured main deployment altitude, ft AGL
    *   reserved[52]     = main trigger reason
    */
   record.reserved[0] =
       flight_pyro_arm_would_be_high;
   uint32_t reference_time_ms = timestamp_ms;
   uint32_t delay_ms = 0;
   uint8_t fire_would_high = 0;
   if (event_id == FLIGHT_EVENT_PYRO_ARM_WOULD_ENABLE)
   {
       reference_time_ms = flight_launch_ms;
       delay_ms = flight_launch_to_arm_ms;
   }
   else if (event_id == FLIGHT_EVENT_DROGUE_WOULD_FIRE)
   {
       reference_time_ms = flight_apogee_ms;
       delay_ms = flight_drogue_detect_to_fire_ms;
       fire_would_high = 1;
   }
   else if (event_id == FLIGHT_EVENT_MAIN_WOULD_FIRE)
   {
       reference_time_ms = flight_main_deploy_detected_ms;
       delay_ms = flight_main_detect_to_fire_ms;
       fire_would_high = 1;
   }
   record.reserved[1] = fire_would_high;
   memcpy(&record.reserved[2], &reference_time_ms, sizeof(reference_time_ms));
   memcpy(&record.reserved[6], &delay_ms, sizeof(delay_ms));
   snprintf(
       (char *)&record.reserved[10],
       16,
       "%s",
       FlightLogic_StateName(flight_state)
   );
   FlightLogic_FormatEventName(
       (char *)&record.reserved[26],
       20,
       event_id
   );
   memcpy(
       &record.reserved[46],
       &baro_raw_vertical_speed_ft10s,
       sizeof(baro_raw_vertical_speed_ft10s)
   );
   uint16_t main_alt_ft_u16 =
       (uint16_t)flight_main_deploy_alt_ft;
   memcpy(
       &record.reserved[50],
       &main_alt_ft_u16,
       sizeof(main_alt_ft_u16)
   );
   record.reserved[52] =
       (uint8_t)flight_main_trigger;
   record.baro_alt_ft10 = baro_filtered_alt_ft10;
   record.vertical_speed_ft10s = baro_descent_ft10s;
   record.accel_mag_mg = flight_accel_mag_mg;
   record.gyro_mag_dps10 = flight_gyro_mag_dps10;
   record.gps_speed_3d_mmps = gps.speed_3d_mmps;
   record.battery_mv = Battery_ReadMillivolts();
   if (flight_launch_detected)
   {
       record.since_launch_ms =
           timestamp_ms - flight_launch_ms;
   }
   if (!BLACKBOX_WriteEventRecord(&record))
   {
       return 0;
   }
   blackbox_record_sequence++;
   return 1;
}
static void FlightOutputs_Safe(void)
{
   /* Match the proven bench-test shutdown order: FIRE LOW first. */
   HAL_GPIO_WritePin(APO_FIRE_PORT, APO_FIRE_PIN, GPIO_PIN_RESET);
   HAL_GPIO_WritePin(MAIN_FIRE_PORT, MAIN_FIRE_PIN, GPIO_PIN_RESET);
   HAL_GPIO_WritePin(AUX_FIRE_PORT, AUX_FIRE_PIN, GPIO_PIN_RESET);
   /* ARM LOW second. */
   HAL_GPIO_WritePin(PYRO_ARM_PORT, PYRO_ARM_PIN, GPIO_PIN_RESET);
   flight_apo_indicator_high = 0;
   flight_main_indicator_high = 0;
   flight_apo_indicator_high_ms = 0;
   flight_main_indicator_high_ms = 0;
}
static void FlightOutputs_Arm(void)
{
   /* AUX is never used. */
   HAL_GPIO_WritePin(AUX_FIRE_PORT, AUX_FIRE_PIN, GPIO_PIN_RESET);
   /* PB0 stays HIGH from confirmed launch until confirmed landing. */
   HAL_GPIO_WritePin(PYRO_ARM_PORT, PYRO_ARM_PIN, GPIO_PIN_SET);
}
static void FlightOutputs_TriggerApo(uint32_t now_ms)
{
   HAL_GPIO_WritePin(AUX_FIRE_PORT, AUX_FIRE_PIN, GPIO_PIN_RESET);
   HAL_GPIO_WritePin(APO_FIRE_PORT, APO_FIRE_PIN, GPIO_PIN_SET);
   flight_apo_indicator_high = 1;
   flight_apo_indicator_high_ms = now_ms;
}
static void FlightOutputs_TriggerMain(uint32_t now_ms)
{
   HAL_GPIO_WritePin(AUX_FIRE_PORT, AUX_FIRE_PIN, GPIO_PIN_RESET);
   HAL_GPIO_WritePin(MAIN_FIRE_PORT, MAIN_FIRE_PIN, GPIO_PIN_SET);
   flight_main_indicator_high = 1;
   flight_main_indicator_high_ms = now_ms;
}
static void FlightOutputs_Service(uint32_t now_ms)
{
   /* PB2 AUX is forced LOW for the entire power cycle. */
   HAL_GPIO_WritePin(AUX_FIRE_PORT, AUX_FIRE_PIN, GPIO_PIN_RESET);
   if (
       flight_apo_indicator_high &&
       (now_ms - flight_apo_indicator_high_ms) >=
           FLIGHT_FIRE_INDICATOR_PULSE_MS
   )
   {
       HAL_GPIO_WritePin(APO_FIRE_PORT, APO_FIRE_PIN, GPIO_PIN_RESET);
       flight_apo_indicator_high = 0;
   }
   if (
       flight_main_indicator_high &&
       (now_ms - flight_main_indicator_high_ms) >=
           FLIGHT_FIRE_INDICATOR_PULSE_MS
   )
   {
       HAL_GPIO_WritePin(MAIN_FIRE_PORT, MAIN_FIRE_PIN, GPIO_PIN_RESET);
       flight_main_indicator_high = 0;
   }
   /* Reassert the required ARM state every loop. */
   if (flight_launch_detected && !flight_landed_detected)
   {
       HAL_GPIO_WritePin(PYRO_ARM_PORT, PYRO_ARM_PIN, GPIO_PIN_SET);
   }
   else
   {
       HAL_GPIO_WritePin(PYRO_ARM_PORT, PYRO_ARM_PIN, GPIO_PIN_RESET);
   }
}
static uint32_t FlightLogic_VectorMagnitude(
   int32_t x,
   int32_t y,
   int32_t z
)
{
   float xf = (float)x;
   float yf = (float)y;
   float zf = (float)z;
   float magnitude =
       sqrtf(
           xf * xf +
           yf * yf +
           zf * zf
       );
   if (magnitude <= 0.0f)
   {
       return 0;
   }
   if (magnitude >= 4294967040.0f)
   {
       return 0xFFFFFFFFUL;
   }
   return (uint32_t)(magnitude + 0.5f);
}
