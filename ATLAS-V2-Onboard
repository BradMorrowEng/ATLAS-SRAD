static uint8_t SDLOG_FindNextFile(
   uint32_t *next_number,
   char *filename,
   size_t filename_size
)
{
   if (!next_number || !filename || filename_size < 13U)
   {
       return 0;
   }
   DIR directory;
   FILINFO info;
   FRESULT result =
       f_opendir(
           &directory,
           USERPath
       );
   if (result != FR_OK)
   {
       return 0;
   }
   uint32_t highest = 0;
   while (1)
   {
       result =
           f_readdir(
               &directory,
               &info
           );
       if (result != FR_OK)
       {
           f_closedir(&directory);
           return 0;
       }
       if (info.fname[0] == '\0')
       {
           break;
       }
       /*
        * Accept only our exact short-name format:
        * FLT0001.BIN through FLT9999.BIN
        */
       if (
           strlen(info.fname) == 11U &&
           info.fname[0] == 'F' &&
           info.fname[1] == 'L' &&
           info.fname[2] == 'T' &&
           info.fname[7] == '.' &&
           info.fname[8] == 'B' &&
           info.fname[9] == 'I' &&
           info.fname[10] == 'N'
       )
       {
           uint32_t number = 0;
           uint8_t valid = 1;
           for (uint8_t i = 3; i <= 6; i++)
           {
               if (
                   info.fname[i] < '0' ||
                   info.fname[i] > '9'
               )
               {
                   valid = 0;
                   break;
               }
               number =
                   (number * 10UL) +
                   (uint32_t)(info.fname[i] - '0');
           }
           if (valid && number > highest)
           {
               highest = number;
           }
       }
   }
   f_closedir(&directory);
   if (highest >= 9999UL)
   {
       return 0;
   }
   *next_number = highest + 1UL;
   snprintf(
       filename,
       filename_size,
       "FLT%04lu.BIN",
       (unsigned long)*next_number
   );
   return 1;
}
static uint8_t SDLOG_WriteHeader(void)
{
   SDLogHeader_t header;
   memset(
       &header,
       0,
       sizeof(header)
   );
   header.magic = SDLOG_HEADER_MAGIC;
   header.version = SDLOG_HEADER_VERSION;
   header.header_size = sizeof(header);
   header.log_number = sdlog_number;
   header.startup_ms = HAL_GetTick();
   header.lora_frequency_hz = actual_lora_frequency_hz;
   header.startup_battery_mv = Battery_ReadMillivolts();
   header.startup_baro_base_pa = baro_base_pa;
   header.imu_rate_hz =
       (uint16_t)(1000UL / SDLOG_IMU_INTERVAL_MS);
   header.highg_rate_hz =
       (uint16_t)(1000UL / SDLOG_HIGHG_INTERVAL_MS);
   header.baro_rate_hz =
       (uint16_t)(1000UL / SDLOG_BARO_INTERVAL_MS);
   header.gps_rate_hz =
       (uint16_t)(1000UL / SDLOG_GPS_INTERVAL_MS);
   header.power_rate_hz =
       (uint16_t)(1000UL / SDLOG_POWER_INTERVAL_MS);
   if (baro_ok)
   {
       header.startup_status_flags |= (1U << 0);
   }
   if (gps.present)
   {
       header.startup_status_flags |= (1U << 1);
   }
   if (gps.fix_ok)
   {
       header.startup_status_flags |= (1U << 2);
   }
   if (imu1_ok)
   {
       header.startup_status_flags |= (1U << 3);
   }
   if (imu2_ok)
   {
       header.startup_status_flags |= (1U << 4);
   }
   if (lora_ok)
   {
       header.startup_status_flags |= (1U << 5);
   }
   if (highg_ok)
   {
       header.startup_status_flags |= (1U << 6);
   }
   memcpy(
       header.system_name,
       "ATLAS V2",
       8
   );
   header.crc16 =
       BLACKBOX_CRC16(
           (const uint8_t *)&header,
           (uint16_t)(sizeof(header) - sizeof(header.crc16))
       );
   UINT bytes_written = 0;
   FRESULT result =
       f_write(
           &sdlog_file,
           &header,
           sizeof(header),
           &bytes_written
       );
   if (
       result != FR_OK ||
       bytes_written != sizeof(header)
   )
   {
       return 0;
   }
   if (f_sync(&sdlog_file) != FR_OK)
   {
       return 0;
   }
   return 1;
}
static uint8_t SDLOG_Start(void)
{
   FRESULT result;
   /*
    * USER_Driver has already been linked by MX_FATFS_Init().
    * Force a real mount now.
    */
   result =
       f_mount(
           &USERFatFS,
           USERPath,
           1
       );
   if (result != FR_OK)
   {
       SDLOG_Debug(
           "\r\nSDLOG,MOUNT=FAIL,FRESULT=%u\r\n",
           (unsigned int)result
       );
       return 0;
   }
   char filename[16];
   if (
       !SDLOG_FindNextFile(
           &sdlog_number,
           filename,
           sizeof(filename)
       )
   )
   {
       SDLOG_Debug(
           "\r\nSDLOG,FILESCAN=FAIL\r\n"
       );
       return 0;
   }
   /*
    * FA_CREATE_NEW is intentional:
    * even if our directory scan somehow races/fails, an existing flight log
    * can never be overwritten.
    */
   result =
       f_open(
           &sdlog_file,
           filename,
           FA_CREATE_NEW | FA_WRITE
       );
   if (result != FR_OK)
   {
       SDLOG_Debug(
           "\r\nSDLOG,OPEN=FAIL,FILE=%s,FRESULT=%u\r\n",
           filename,
           (unsigned int)result
       );
       return 0;
   }
   sdlog_record_sequence = 0;
   sdlog_buffer_used = 0;
   uint32_t now_ms = HAL_GetTick();
   sdlog_last_imu_ms = now_ms;
   sdlog_last_highg_ms = now_ms;
   sdlog_last_baro_ms = now_ms;
   sdlog_last_gps_ms = now_ms;
   sdlog_last_power_ms = now_ms;
   sdlog_last_sync_ms = now_ms;
   if (!SDLOG_WriteHeader())
   {
       SDLOG_Debug(
           "\r\nSDLOG,HEADER=FAIL,FILE=%s\r\n",
           filename
       );
       f_close(&sdlog_file);
       return 0;
   }
   SDLOG_Debug(
       "\r\nSDLOG,START=OK,FILE=%s,LOG=%lu\r\n",
       filename,
       (unsigned long)sdlog_number
   );
   sdlog_ever_started = 1;
   return 1;
}
static uint8_t SDLOG_FlushBuffer(void)
{
   if (sdlog_buffer_used == 0)
   {
       return 1;
   }
   UINT bytes_written = 0;
   FRESULT result =
       f_write(
           &sdlog_file,
           sdlog_buffer,
           sdlog_buffer_used,
           &bytes_written
       );
   if (
       result != FR_OK ||
       bytes_written != sdlog_buffer_used
   )
   {
       SDLOG_Debug(
           "\r\nSDLOG,WRITE=FAIL,FRESULT=%u,WANTED=%u,WROTE=%u\r\n",
           (unsigned int)result,
           (unsigned int)sdlog_buffer_used,
           (unsigned int)bytes_written
       );
       return 0;
   }
   sdlog_buffer_used = 0;
   return 1;
}
static uint8_t SDLOG_Sync(void)
{
   if (!SDLOG_FlushBuffer())
   {
       return 0;
   }
   FRESULT result =
       f_sync(
           &sdlog_file
       );
   if (result != FR_OK)
   {
       SDLOG_Debug(
           "\r\nSDLOG,SYNC=FAIL,FRESULT=%u\r\n",
           (unsigned int)result
       );
       return 0;
   }
   return 1;
}
static uint8_t SDLOG_AppendRecord(
   uint8_t record_type,
   uint32_t timestamp_ms,
   uint16_t status_flags,
   const void *payload,
   uint16_t payload_length
)
{
   if (
       !payload ||
       payload_length > sizeof(((SDLogRecord_t *)0)->payload)
   )
   {
       return 0;
   }
   SDLogRecord_t record;
   memset(
       &record,
       0,
       sizeof(record)
   );
   record.magic = SDLOG_RECORD_MAGIC;
   record.version = SDLOG_RECORD_VERSION;
   record.record_type = record_type;
   record.timestamp_ms = timestamp_ms;
   record.sequence = sdlog_record_sequence;
   record.status_flags = status_flags;
   record.payload_length = payload_length;
   memcpy(
       record.payload,
       payload,
       payload_length
   );
   record.crc16 =
       BLACKBOX_CRC16(
           (const uint8_t *)&record,
           (uint16_t)(sizeof(record) - sizeof(record.crc16))
       );
   /*
    * 64-byte records pack exactly 8 per 512-byte software buffer.
    */
   if (
       (sdlog_buffer_used + sizeof(record)) >
       sizeof(sdlog_buffer)
   )
   {
       if (!SDLOG_FlushBuffer())
       {
           return 0;
       }
   }
   memcpy(
       &sdlog_buffer[sdlog_buffer_used],
       &record,
       sizeof(record)
   );
   sdlog_buffer_used += sizeof(record);
   sdlog_record_sequence++;
   if (sdlog_buffer_used == sizeof(sdlog_buffer))
   {
       if (!SDLOG_FlushBuffer())
       {
           return 0;
       }
   }
   return 1;
}
static void SDLOG_LogIMU(uint32_t now_ms)
{
   SDLogIMUPayload_t payload;
   memset(
       &payload,
       0,
       sizeof(payload)
   );
   payload.imu1_who =
       IMU_ReadReg(
           IMU1_CS_PORT,
           IMU1_CS_PIN,
           LSM6_WHO_AM_I
       );
   payload.imu2_who =
       IMU_ReadReg(
           IMU2_CS_PORT,
           IMU2_CS_PIN,
           LSM6_WHO_AM_I
       );
   snprintf(
       payload.flight_state,
       sizeof(payload.flight_state),
       "%s",
       FlightLogic_StateName(flight_state)
   );
   uint8_t imu1_current_ok =
       (payload.imu1_who == 0x69);
   uint8_t imu2_current_ok =
       (payload.imu2_who == 0x69);
   int32_t ax = 0;
   int32_t ay = 0;
   int32_t az = 0;
   int32_t gx = 0;
   int32_t gy = 0;
   int32_t gz = 0;
   if (imu1_current_ok)
   {
       IMU_Read(
           IMU1_CS_PORT,
           IMU1_CS_PIN,
           &ax, &ay, &az,
           &gx, &gy, &gz
       );
       payload.imu1_ax_g1000 = SaturateI32ToI16(ax);
       payload.imu1_ay_g1000 = SaturateI32ToI16(ay);
       payload.imu1_az_g1000 = SaturateI32ToI16(az);
       payload.imu1_gx_dps10 = SaturateI32ToI16(gx);
       payload.imu1_gy_dps10 = SaturateI32ToI16(gy);
       payload.imu1_gz_dps10 = SaturateI32ToI16(gz);
   }
   if (imu2_current_ok)
   {
       IMU_Read(
           IMU2_CS_PORT,
           IMU2_CS_PIN,
           &ax, &ay, &az,
           &gx, &gy, &gz
       );
       payload.imu2_ax_g1000 = SaturateI32ToI16(ax);
       payload.imu2_ay_g1000 = SaturateI32ToI16(ay);
       payload.imu2_az_g1000 = SaturateI32ToI16(az);
       payload.imu2_gx_dps10 = SaturateI32ToI16(gx);
       payload.imu2_gy_dps10 = SaturateI32ToI16(gy);
       payload.imu2_gz_dps10 = SaturateI32ToI16(gz);
   }
   uint16_t status = 0;
   if (imu1_current_ok)
   {
       status |= (1U << 0);
   }
   if (imu2_current_ok)
   {
       status |= (1U << 1);
   }
   if (
       !SDLOG_AppendRecord(
           SDLOG_TYPE_IMU,
           now_ms,
           status,
           &payload,
           sizeof(payload)
       )
   )
   {
       sdlog_ok = 0;
   }
}
static void SDLOG_LogHighG(uint32_t now_ms)
{
   SDLogHighGPayload_t payload;
   memset(
       &payload,
       0,
       sizeof(payload)
   );
   snprintf(
       payload.flight_state,
       sizeof(payload.flight_state),
       "%s",
       FlightLogic_StateName(flight_state)
   );
   uint8_t current_ok = 0;
   if (highg_ok)
   {
       /*
        * Read into naturally aligned locals first. SDLogHighGPayload_t is
        * packed, so taking int32_t pointers directly to its members can
        * create unaligned accesses on the STM32.
        */
       int32_t x_mg = 0;
       int32_t y_mg = 0;
       int32_t z_mg = 0;
       current_ok =
           ADXL372_ReadAccelMg(
               &x_mg,
               &y_mg,
               &z_mg
           );
       if (current_ok)
       {
           payload.x_mg = x_mg;
           payload.y_mg = y_mg;
           payload.z_mg = z_mg;
       }
   }
   uint16_t status =
       current_ok ? 1U : 0U;
   if (
       !SDLOG_AppendRecord(
           SDLOG_TYPE_HIGHG,
           now_ms,
           status,
           &payload,
           sizeof(payload)
       )
   )
   {
       sdlog_ok = 0;
   }
}
