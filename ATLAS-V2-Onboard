static void SDLOG_Service(uint32_t now_ms)
{
   /*
    * Do not try to "catch up" with bursts if another subsystem briefly
    * blocks the superloop. Each group simply takes its next current sample.
    *
    * After landing, ATLAS V2 remains a recovery beacon and drops the SD
    * recorder to low-rate health/location logging.
    */
   uint8_t recovery = FlightLogic_IsRecovery();
   uint32_t highg_interval_ms =
       recovery ? RECOVERY_SD_HIGHG_INTERVAL_MS : SDLOG_HIGHG_INTERVAL_MS;
   uint32_t imu_interval_ms =
       recovery ? RECOVERY_SD_IMU_INTERVAL_MS : SDLOG_IMU_INTERVAL_MS;
   uint32_t baro_interval_ms =
       recovery ? RECOVERY_SD_BARO_INTERVAL_MS : SDLOG_BARO_INTERVAL_MS;
   uint32_t gps_interval_ms =
       recovery ? RECOVERY_SD_GPS_INTERVAL_MS : SDLOG_GPS_INTERVAL_MS;
   uint32_t power_interval_ms =
       recovery ? RECOVERY_SD_POWER_INTERVAL_MS : SDLOG_POWER_INTERVAL_MS;
   uint32_t sync_interval_ms =
       recovery ? RECOVERY_SD_SYNC_INTERVAL_MS : SDLOG_SYNC_INTERVAL_MS;
   if (
       (now_ms - sdlog_last_highg_ms) >=
       highg_interval_ms
   )
   {
       sdlog_last_highg_ms = now_ms;
       SDLOG_LogHighG(now_ms);
       if (!sdlog_ok)
       {
           return;
       }
   }
   if (
       (now_ms - sdlog_last_imu_ms) >=
       imu_interval_ms
   )
   {
       sdlog_last_imu_ms = now_ms;
       SDLOG_LogIMU(now_ms);
       if (!sdlog_ok)
       {
           return;
       }
   }
   if (
       (now_ms - sdlog_last_baro_ms) >=
       baro_interval_ms
   )
   {
       sdlog_last_baro_ms = now_ms;
       SDLOG_LogBaro(now_ms);
       if (!sdlog_ok)
       {
           return;
       }
   }
   if (
       (now_ms - sdlog_last_gps_ms) >=
       gps_interval_ms
   )
   {
       sdlog_last_gps_ms = now_ms;
       SDLOG_LogGPS(now_ms);
       if (!sdlog_ok)
       {
           return;
       }
   }
   if (
       (now_ms - sdlog_last_power_ms) >=
       power_interval_ms
   )
   {
       sdlog_last_power_ms = now_ms;
       SDLOG_LogPower(now_ms);
       if (!sdlog_ok)
       {
           return;
       }
   }
   /*
    * Once per second push both the software buffer and FatFs metadata
    * to the microSD. Sudden power removal can still lose the very tail,
    * but the whole flight file will not be sitting only in RAM/cache.
    */
   if (
       (now_ms - sdlog_last_sync_ms) >=
       sync_interval_ms
   )
   {
       sdlog_last_sync_ms = now_ms;
       if (!SDLOG_Sync())
       {
           sdlog_ok = 0;
           return;
       }
   }
}
