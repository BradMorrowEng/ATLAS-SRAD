       MillimetersToFeetX10(
           gps.vel_d_mmps
       );
   if (gps.last_fix_ms != 0)
   {
       payload.fix_age_ms =
           now_ms - gps.last_fix_ms;
   }
   payload.present = gps.present;
   payload.configured = gps.configured;
   payload.fix_ok = gps.fix_ok;
   payload.fix_type = gps.fix_type;
   payload.sats = gps.sats;
   snprintf(
       payload.flight_state,
       sizeof(payload.flight_state),
       "%s",
       FlightLogic_StateName(flight_state)
   );
   uint16_t status = 0;
   if (gps.present)
   {
       status |= (1U << 0);
   }
   if (gps.configured)
   {
       status |= (1U << 1);
   }
   if (gps.fix_ok)
   {
       status |= (1U << 2);
   }
   if (
       !SDLOG_AppendRecord(
           SDLOG_TYPE_GPS,
           now_ms,
           status,
           &payload,
           sizeof(payload)
       )
   )
