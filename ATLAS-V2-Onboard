static void FlightLogic_FormatEventName(
   char *out,
   size_t out_size,
   FlightEvent_t event_id
)
{
   if (!out || out_size == 0)
   {
       return;
   }
   if (event_id == FLIGHT_EVENT_MAIN_ALTITUDE_SET)
   {
       snprintf(
           out,
           out_size,
           "MAIN_ALT_%luFT",
           (unsigned long)flight_main_deploy_alt_ft
       );
       return;
   }
   if (event_id == FLIGHT_EVENT_MAIN_DEPLOYMENT_DETECTED)
   {
       snprintf(
           out,
           out_size,
           "%s",
           (flight_main_trigger == FLIGHT_MAIN_TRIGGER_EXCESSIVE_DESCENT) ?
               "MAIN_DETECT_FAST" :
               "MAIN_DETECT_ALT"
       );
       return;
   }
   if (event_id == FLIGHT_EVENT_MAIN_WOULD_FIRE)
   {
       snprintf(
           out,
           out_size,
           "%s",
           (flight_main_trigger == FLIGHT_MAIN_TRIGGER_EXCESSIVE_DESCENT) ?
               "MAIN_FIRE_FAST" :
               "MAIN_FIRE_ALT"
       );
       return;
   }
   snprintf(
       out,
       out_size,
       "%s",
       FlightLogic_EventName(event_id)
   );
}
static uint8_t FlightLogic_IsRecovery(void)
{
   return (
       flight_state == FLIGHT_STATE_LANDED ||
       flight_state == FLIGHT_STATE_RECOVERY
   );
}
static uint32_t FlightLogic_GetTelemetryInterval(
   uint32_t now_ms
)
{
   if (!FlightLogic_IsRecovery())
   {
       return TELEMETRY_INTERVAL_MS;
   }
   uint32_t since_landed_ms =
       now_ms - flight_landed_ms;
   if (since_landed_ms < RECOVERY_EARLY_DURATION_MS)
   {
       return RECOVERY_TELEMETRY_EARLY_MS;
   }
   if (since_landed_ms < RECOVERY_MID_DURATION_MS)
   {
       return RECOVERY_TELEMETRY_MID_MS;
   }
   return RECOVERY_TELEMETRY_LATE_MS;
}
static void FlightLogic_LogEvent(
   FlightEvent_t event_id,
   uint32_t now_ms
)
{
   /*
    * Event logging remains separated from indicator GPIO control.
    * The event state machine changes PB0/PA0/PA3 at the matching events.
    * This logging function itself does not change GPIO state.
    */
   if (blackbox_ok)
   {
       if (!BLACKBOX_LogFlightEvent(event_id, now_ms))
       {
           blackbox_ok = 0;
       }
   }
   if (sdlog_ok)
   {
       if (!SDLOG_LogFlightEvent(event_id, now_ms))
       {
           sdlog_ok = 0;
       }
   }
   uint32_t reference_time_ms = now_ms;
   uint32_t delay_ms = 0;
   uint8_t fire_would_be_high = 0;
   if (event_id == FLIGHT_EVENT_PYRO_ARM_WOULD_ENABLE)
   {
       reference_time_ms = flight_launch_ms;
       delay_ms = flight_launch_to_arm_ms;
   }
   else if (event_id == FLIGHT_EVENT_DROGUE_WOULD_FIRE)
   {
       reference_time_ms = flight_apogee_ms;
       delay_ms = flight_drogue_detect_to_fire_ms;
       fire_would_be_high = 1;
   }
   else if (event_id == FLIGHT_EVENT_MAIN_WOULD_FIRE)
   {
       reference_time_ms = flight_main_deploy_detected_ms;
       delay_ms = flight_main_detect_to_fire_ms;
       fire_would_be_high = 1;
   }
   if (sdlog_ok)
   {
       if (!SDLOG_LogFlightTrace(
               event_id,
               now_ms,
               reference_time_ms,
               delay_ms,
               fire_would_be_high))
       {
           sdlog_ok = 0;
       }
   }
   char formatted_event_name[24];
   FlightLogic_FormatEventName(
       formatted_event_name,
       sizeof(formatted_event_name),
       event_id
   );
   SDLOG_Debug(
       "\r\nFLIGHT,EVENT=%s,STATE=%s,EVENT_TIME_MS=%lu,REFERENCE_TIME_MS=%lu,"
       "DETECT_TO_OUTPUT_MS=%lu,FIRE_WOULD_HIGH=%u,ARM_WOULD_HIGH=%u,"
       "A1FT10=%ld,VSFT10S=%ld,RAWVSFT10S=%ld,MAINALTFT=%lu,MAINTRIG=%s,"
       "AMG=%lu,GYROMAG=%lu,GPSSPD=%lu,BT=%u,FLAGS=%08lX\r\n",
       formatted_event_name,
       FlightLogic_StateName(flight_state),
       (unsigned long)now_ms,
       (unsigned long)reference_time_ms,
       (unsigned long)delay_ms,
       (unsigned int)fire_would_be_high,
       (unsigned int)flight_pyro_arm_would_be_high,
       (long)baro_filtered_alt_ft10,
       (long)baro_descent_ft10s,
       (long)baro_raw_vertical_speed_ft10s,
       (unsigned long)flight_main_deploy_alt_ft,
       FlightLogic_MainTriggerName(flight_main_trigger),
       (unsigned long)flight_accel_mag_mg,
       (unsigned long)flight_gyro_mag_dps10,
       (unsigned long)gps.speed_3d_mmps,
       (unsigned int)flight_baro_trusted,
       (unsigned long)flight_event_flags
   );
}
static void FlightLogic_ResetBaroAfterHighSpeed(
   uint32_t now_ms
)
{
   /*
    * The barometer has been continuously sampled and logged, but its
    * high-speed data was intentionally ignored by the state machine.
    *
    * Re-seed the flight filter from the current pressure-derived altitude so
    * transonic pressure disturbances do not remain in the velocity filter.
    */
   baro_filtered_alt_ft10 = baro_alt_ft10;
   baro_velocity_alt_ft10 = baro_filtered_alt_ft10;
   baro_velocity_time_ms = now_ms;
   baro_descent_ft10s = 0;
   baro_raw_vertical_speed_ft10s = 0;
   baro_velocity_sample_sequence++;
   baro_filter_ready = 1;
   flight_max_alt_ft10 =
       baro_filtered_alt_ft10;
}
static void FlightLogic_Init(
   uint32_t now_ms
)
{
   flight_state = FLIGHT_STATE_WAIT_FOR_LAUNCH;
   flight_event_flags = 0;
   flight_baro_trusted = 0;
   flight_launch_detected = 0;
   flight_burnout_detected = 0;
   flight_apogee_detected = 0;
   flight_drogue_would_fire = 0;
   flight_main_would_fire = 0;
   flight_landed_detected = 0;
   flight_gyro_turnover_seen = 0;
   flight_main_trigger = FLIGHT_MAIN_TRIGGER_NONE;
   flight_pyro_arm_would_be_high = 0;
   FlightOutputs_Safe();
   flight_launch_ms = 0;
   flight_burnout_ms = 0;
   flight_baro_trusted_ms = 0;
   flight_apogee_ms = 0;
   flight_drogue_fire_would_high_ms = 0;
   flight_drogue_detect_to_fire_ms = 0;
   flight_main_deploy_detected_ms = 0;
   flight_main_fire_would_high_ms = 0;
   flight_main_detect_to_fire_ms = 0;
   flight_arm_would_high_ms = 0;
   flight_launch_to_arm_ms = 0;
   flight_landed_ms = 0;
   flight_last_logic_ms = now_ms;
   flight_launch_candidate_ms = 0;
   flight_burnout_candidate_ms = 0;
   flight_baro_trust_candidate_ms = 0;
   flight_apogee_candidate_ms = 0;
   flight_main_candidate_ms = 0;
   flight_main_emergency_candidate_ms = 0;
   flight_landing_candidate_ms = 0;
   flight_last_sensor_health_ms = now_ms;
   flight_accel_mag_mg = 0;
   flight_accel_filtered_mg = 0;
   flight_powered_peak_mg = 0;
   flight_gyro_mag_dps10 = 0;
   flight_max_alt_ft10 =
       baro_filtered_alt_ft10;
   flight_landing_reference_alt_ft10 =
       baro_filtered_alt_ft10;
   FlightLogic_LogEvent(
       FLIGHT_EVENT_INIT_COMPLETE,
       now_ms
   );
   /*
    * Always log the active default/current main altitude once at startup.
    * Any later GS change creates another MAIN_ALT_xxxxFT event, and the
    * last pre-launch value is the value used for the flight.
    */
   FlightLogic_LogEvent(
       FLIGHT_EVENT_MAIN_ALTITUDE_SET,
       now_ms
   );
}
static void FlightLogic_Service(
   uint32_t now_ms
)
{
   if (
       (now_ms - flight_last_logic_ms) <
       FLIGHT_LOGIC_INTERVAL_MS
   )
   {
       return;
   }
   flight_last_logic_ms = now_ms;
   /*
    * Refresh IMU identity independently from the slow telemetry path.
    * Each motion read also checks the SPI transaction result, so a bus error
    * cannot silently become a valid zeroed flight sample.
    */
   if (
       (now_ms - flight_last_sensor_health_ms) >=
       FLIGHT_SENSOR_HEALTH_RECHECK_MS
   )
   {
       flight_last_sensor_health_ms = now_ms;
       uint8_t who = 0;
       imu1_ok =
           IMU_ReadRegChecked(
               IMU1_CS_PORT,
               IMU1_CS_PIN,
               LSM6_WHO_AM_I,
               &who
           ) &&
           who == 0x69;
       who = 0;
       imu2_ok =
           IMU_ReadRegChecked(
               IMU2_CS_PORT,
               IMU2_CS_PIN,
               LSM6_WHO_AM_I,
               &who
           ) &&
           who == 0x69;
   }
   int32_t imu1_ax_local = 0;
   int32_t imu1_ay_local = 0;
   int32_t imu1_az_local = 0;
   int32_t imu1_gx_local = 0;
   int32_t imu1_gy_local = 0;
   int32_t imu1_gz_local = 0;
   int32_t imu2_ax_local = 0;
   int32_t imu2_ay_local = 0;
   int32_t imu2_az_local = 0;
   int32_t imu2_gx_local = 0;
   int32_t imu2_gy_local = 0;
   int32_t imu2_gz_local = 0;
   uint8_t imu1_motion_ok = 0;
   uint8_t imu2_motion_ok = 0;
   if (imu1_ok)
   {
       imu1_motion_ok =
           IMU_ReadChecked(
               IMU1_CS_PORT,
               IMU1_CS_PIN,
               &imu1_ax_local,
               &imu1_ay_local,
               &imu1_az_local,
               &imu1_gx_local,
               &imu1_gy_local,
               &imu1_gz_local
           );
       if (!imu1_motion_ok)
       {
           imu1_ok = 0;
       }
   }
   if (imu2_ok)
   {
       imu2_motion_ok =
           IMU_ReadChecked(
               IMU2_CS_PORT,
               IMU2_CS_PIN,
               &imu2_ax_local,
               &imu2_ay_local,
               &imu2_az_local,
               &imu2_gx_local,
               &imu2_gy_local,
               &imu2_gz_local
           );
       if (!imu2_motion_ok)
       {
           imu2_ok = 0;
       }
   }
   if (imu1_motion_ok)
   {
       flight_gyro_mag_dps10 =
           FlightLogic_VectorMagnitude(
               imu1_gx_local,
               imu1_gy_local,
               imu1_gz_local
           );
   }
   else if (imu2_motion_ok)
   {
       flight_gyro_mag_dps10 =
           FlightLogic_VectorMagnitude(
               imu2_gx_local,
               imu2_gy_local,
               imu2_gz_local
           );
   }
   else
   {
       flight_gyro_mag_dps10 = 0;
   }
   uint32_t imu1_accel_mag_mg = 0;
   uint32_t imu2_accel_mag_mg = 0;
   if (imu1_motion_ok)
   {
       imu1_accel_mag_mg =
           FlightLogic_VectorMagnitude(
               imu1_ax_local,
               imu1_ay_local,
               imu1_az_local
           );
   }
   if (imu2_motion_ok)
   {
       imu2_accel_mag_mg =
           FlightLogic_VectorMagnitude(
               imu2_ax_local,
               imu2_ay_local,
               imu2_az_local
           );
   }
   uint8_t highg_motion_ok = 0;
   int32_t highg_x = 0;
   int32_t highg_y = 0;
   int32_t highg_z = 0;
   uint32_t highg_accel_mag_mg = 0;
   if (highg_ok)
   {
       highg_motion_ok =
           ADXL372_ReadAccelMg(
               &highg_x,
               &highg_y,
               &highg_z
           );
       /* A single failed SPI sample does not permanently disable the high-G
        * sensor. The next flight-logic tick retries it.
        */
   }
   if (highg_motion_ok)
   {
       highg_accel_mag_mg =
           FlightLogic_VectorMagnitude(
               highg_x,
               highg_y,
               highg_z
           );
       flight_accel_mag_mg =
           highg_accel_mag_mg;
   }
   else if (imu1_motion_ok)
   {
       flight_accel_mag_mg =
           imu1_accel_mag_mg;
   }
   else if (imu2_motion_ok)
   {
       flight_accel_mag_mg =
           imu2_accel_mag_mg;
   }
   else
   {
       flight_accel_mag_mg = 0;
   }
   if (flight_accel_filtered_mg == 0)
   {
       flight_accel_filtered_mg =
           flight_accel_mag_mg;
   }
   else
   {
       flight_accel_filtered_mg =
           (
               flight_accel_filtered_mg * 3UL +
               flight_accel_mag_mg
           ) / 4UL;
   }
   switch (flight_state)
   {
       case FLIGHT_STATE_WAIT_FOR_LAUNCH:
       {
           /*
            * Redundant launch confirmation. With three accelerometers
            * available, ATLAS requires agreement from at least two healthy
            * sensors. One failed accelerometer therefore does not block
            * launch detection, while one bad sensor alone cannot arm flight.
            */
           uint8_t launch_valid_sensors = 0;
           uint8_t launch_votes = 0;
           if (highg_motion_ok)
           {
               launch_valid_sensors++;
               if (
                   highg_accel_mag_mg >=
                   FLIGHT_LAUNCH_HIGHG_THRESHOLD_MG
               )
               {
                   launch_votes++;
               }
           }
           if (imu1_motion_ok)
           {
               launch_valid_sensors++;
               if (
                   imu1_accel_mag_mg >=
                   FLIGHT_LAUNCH_IMU_FALLBACK_MG
               )
               {
                   launch_votes++;
               }
           }
           if (imu2_motion_ok)
           {
               launch_valid_sensors++;
               if (
                   imu2_accel_mag_mg >=
                   FLIGHT_LAUNCH_IMU_FALLBACK_MG
               )
               {
                   launch_votes++;
               }
           }
           uint8_t launch_condition =
               launch_valid_sensors >= 2U &&
               launch_votes >= 2U;
           if (launch_condition)
           {
               if (flight_launch_candidate_ms == 0)
               {
                   flight_launch_candidate_ms =
                       now_ms;
               }
               if (
                   (now_ms - flight_launch_candidate_ms) >=
                   FLIGHT_LAUNCH_CONFIRM_MS
               )
               {
                   flight_launch_detected = 1;
                   flight_launch_ms = now_ms;
                   flight_baro_trusted = 0;
                   flight_baro_trusted_ms = 0;
                   flight_event_flags |=
                       FLIGHT_FLAG_LAUNCH;
                   /*
                    * Confirmed launch: turn the PB0 ARM indicator HIGH.
                    * It remains HIGH until confirmed landing.
                    */
                   flight_pyro_arm_would_be_high = 1;
                   FlightOutputs_Arm();
                   flight_arm_would_high_ms = HAL_GetTick();
                   flight_launch_to_arm_ms =
                       flight_arm_would_high_ms - flight_launch_ms;
                   flight_event_flags |=
                       FLIGHT_FLAG_PYRO_ARM_ENABLED;
                   flight_state =
                       FLIGHT_STATE_ASCENT;
                   flight_powered_peak_mg =
                       flight_accel_filtered_mg;
                   flight_launch_candidate_ms = 0;
                   FlightLogic_LogEvent(
                       FLIGHT_EVENT_LAUNCH,
                       flight_launch_ms
                   );
                   FlightLogic_LogEvent(
                       FLIGHT_EVENT_PYRO_ARM_WOULD_ENABLE,
                       flight_arm_would_high_ms
                   );
               }
           }
           else
           {
               flight_launch_candidate_ms = 0;
           }
           break;
       }
       case FLIGHT_STATE_ASCENT:
       {
           if (
               flight_accel_filtered_mg >
               flight_powered_peak_mg
           )
           {
               flight_powered_peak_mg =
                   flight_accel_filtered_mg;
           }
           if (
               (now_ms - flight_launch_ms) >=
               FLIGHT_BURNOUT_MIN_AFTER_LAUNCH_MS
           )
           {
               /*
                * Burnout is intentionally conservative in this first
                * flight-along build. We wait for sustained low proper
                * acceleration rather than using a percentage drop from the
                * launch peak, because a thrust spike could otherwise create
                * a false early burnout.
                *
                * At very high speed aerodynamic drag can delay this detector
                * slightly after true motor burnout. That delay is safer than
                * declaring burnout too early because the barometer remains
                * locked out until burnout plus the separate high-speed test.
                */
               uint8_t burnout_valid_sensors = 0;
               uint8_t burnout_low_votes = 0;
               if (highg_motion_ok)
               {
                   burnout_valid_sensors++;
                   burnout_low_votes +=
                       highg_accel_mag_mg <=
                       FLIGHT_BURNOUT_LOW_ACCEL_MG;
               }
               if (imu1_motion_ok)
               {
                   burnout_valid_sensors++;
                   burnout_low_votes +=
                       imu1_accel_mag_mg <=
                       FLIGHT_BURNOUT_LOW_ACCEL_MG;
               }
               if (imu2_motion_ok)
               {
                   burnout_valid_sensors++;
                   burnout_low_votes +=
                       imu2_accel_mag_mg <=
                       FLIGHT_BURNOUT_LOW_ACCEL_MG;
               }
               uint8_t low_accel = 0;
               if (burnout_valid_sensors >= 2U)
               {
                   low_accel = burnout_low_votes >= 2U;
               }
               else if (burnout_valid_sensors == 1U)
               {
                   /* After launch, tolerate deeper sensor degradation so a
                    * single surviving accelerometer can still advance to COAST.
                    */
                   low_accel = burnout_low_votes == 1U;
               }
               if (low_accel)
               {
                   if (flight_burnout_candidate_ms == 0)
                   {
                       flight_burnout_candidate_ms =
                           now_ms;
                   }
                   if (
                       (now_ms - flight_burnout_candidate_ms) >=
                       FLIGHT_BURNOUT_CONFIRM_MS
                   )
                   {
                       flight_burnout_detected = 1;
                       flight_burnout_ms = now_ms;
                       flight_event_flags |=
                           FLIGHT_FLAG_BURNOUT;
                       flight_state =
                           FLIGHT_STATE_COAST;
                       flight_burnout_candidate_ms = 0;
                       flight_baro_trust_candidate_ms = 0;
                       FlightLogic_LogEvent(
                           FLIGHT_EVENT_BURNOUT,
                           now_ms
                       );
                   }
               }
               else
               {
                   flight_burnout_candidate_ms = 0;
               }
           }
           break;
       }
       case FLIGHT_STATE_COAST:
       {
           /*
            * Gyro is supporting evidence only.
            * It NEVER gates apogee detection.
            *
            * Total angular-rate magnitude does not distinguish roll from
            * pitch/yaw, so this is recorded as "significant turnover/rotation
            * evidence" rather than treated as an attitude solution.
            */
           if (
               !flight_gyro_turnover_seen &&
               flight_gyro_mag_dps10 >= 300UL
           )
           {
               flight_gyro_turnover_seen = 1;
               flight_event_flags |=
                   FLIGHT_FLAG_GYRO_TURNOVER_SEEN;
           }
           if (!flight_baro_trusted)
           {
               uint32_t since_burnout_ms =
                   now_ms - flight_burnout_ms;
               if (
                   since_burnout_ms >=
                   FLIGHT_BARO_TRUST_MIN_AFTER_BURNOUT_MS
               )
               {
                   uint8_t gps_speed_valid = 0;
                   if (
                       gps.fix_ok &&
                       gps.last_fix_ms != 0 &&
                       (now_ms - gps.last_fix_ms) <=
                           FLIGHT_BARO_TRUST_GPS_FRESH_MS
                   )
                   {
                       gps_speed_valid = 1;
                   }
                   if (
                       gps_speed_valid &&
                       gps.speed_3d_mmps <=
                           FLIGHT_BARO_TRUST_GPS_SPEED_MMPS
                   )
                   {
                       if (
                           flight_baro_trust_candidate_ms == 0
                       )
                       {
                           flight_baro_trust_candidate_ms =
                               now_ms;
                       }
                   }
                   else
                   {
                       flight_baro_trust_candidate_ms = 0;
                   }
                   uint8_t speed_confirmed = 0;
                   if (
                       flight_baro_trust_candidate_ms != 0 &&
                       (now_ms - flight_baro_trust_candidate_ms) >=
                           FLIGHT_BARO_TRUST_SPEED_CONFIRM_MS
                   )
                   {
                       speed_confirmed = 1;
                   }
                   /*
                    * Time fallback is used only when GPS speed is unavailable.
                    * If GPS is healthy and still reports high speed, ATLAS
                    * keeps the barometer locked out regardless of elapsed time.
                    */
                   uint8_t fallback_elapsed =
                       !gps_speed_valid &&
                       since_burnout_ms >=
                           FLIGHT_BARO_TRUST_FALLBACK_MS;
                   if (
                       baro_ok &&
                       (speed_confirmed || fallback_elapsed)
                   )
                   {
                       flight_baro_trusted = 1;
                       flight_baro_trusted_ms = now_ms;
                       flight_event_flags |=
                           FLIGHT_FLAG_BARO_TRUSTED;
                       FlightLogic_ResetBaroAfterHighSpeed(
                           now_ms
                       );
                       FlightLogic_LogEvent(
                           FLIGHT_EVENT_BARO_TRUSTED,
                           now_ms
                       );
                   }
               }
           }
           else if (baro_ok)
           {
               if (
                   baro_filtered_alt_ft10 >
                   flight_max_alt_ft10
               )
               {
                   flight_max_alt_ft10 =
                       baro_filtered_alt_ft10;
               }
               if (
                   (now_ms - flight_baro_trusted_ms) >=
                       FLIGHT_APOGEE_MIN_AFTER_BARO_TRUST_MS &&
                   flight_max_alt_ft10 >=
                       FLIGHT_APOGEE_MIN_ALT_FT10 &&
                   baro_filtered_alt_ft10 <=
                       (flight_max_alt_ft10 -
                        FLIGHT_APOGEE_DROP_FT10) &&
                   baro_descent_ft10s <=
                       FLIGHT_APOGEE_DESCENT_FT10S
               )
               {
                   if (flight_apogee_candidate_ms == 0)
                   {
                       flight_apogee_candidate_ms =
                           now_ms;
                   }
                   if (
                       (now_ms - flight_apogee_candidate_ms) >=
                       FLIGHT_APOGEE_CONFIRM_MS
                   )
                   {
                       flight_apogee_detected = 1;
                       flight_apogee_ms = now_ms;
                       flight_event_flags |=
                           FLIGHT_FLAG_APOGEE;
                       FlightLogic_LogEvent(
                           FLIGHT_EVENT_APOGEE,
                           flight_apogee_ms
                       );
                       /*
                        * Enter drogue descent immediately after confirmed
                        * apogee. PA0 remains LOW here. The separate drogue
                        * event raises PA0 exactly 1.0 second later.
                        */
                       flight_state =
                           FLIGHT_STATE_DROGUE_DESCENT;
                       flight_apogee_candidate_ms = 0;
                   }
               }
               else
               {
                   flight_apogee_candidate_ms = 0;
               }
           }
           break;
       }
       case FLIGHT_STATE_DROGUE_DESCENT:
       {
           /*
            * APO camera indicator:
            * PA0 goes HIGH 1.0 second after confirmed APOGEE_DETECTED.
            * FlightOutputs_Service() returns it LOW after 500 ms.
            */
           if (
               !flight_drogue_would_fire &&
               (now_ms - flight_apogee_ms) >=
                   FLIGHT_DROGUE_FIRE_DELAY_MS
           )
           {
               flight_drogue_would_fire = 1;
               flight_drogue_fire_would_high_ms = HAL_GetTick();
               FlightOutputs_TriggerApo(
                   flight_drogue_fire_would_high_ms
               );
               flight_drogue_detect_to_fire_ms =
                   flight_drogue_fire_would_high_ms -
                   flight_apogee_ms;
               flight_event_flags |=
                   FLIGHT_FLAG_DROGUE_WOULD_FIRE;
               FlightLogic_LogEvent(
                   FLIGHT_EVENT_DROGUE_WOULD_FIRE,
                   flight_drogue_fire_would_high_ms
               );
           }
           /*
            * HARD MAIN-INHIBIT RULE:
            *
            * No normal or emergency MAIN condition is evaluated until
            * APOGEE_DETECTED has been latched. This remains true even if
            * altitude or vertical-speed data looks like a main-deployment
            * condition during ascent or coast.
            */
           if (!flight_apogee_detected)
           {
               flight_main_candidate_ms = 0;
               flight_main_emergency_candidate_ms = 0;
               break;
           }
           if (!baro_ok || !flight_baro_trusted)
           {
               flight_main_candidate_ms = 0;
               flight_main_emergency_candidate_ms = 0;
               break;
           }
           uint32_t since_apogee_ms =
               now_ms - flight_apogee_ms;
           int32_t configured_main_alt_ft10 =
               (int32_t)(flight_main_deploy_alt_ft * 10UL);
           /*
            * Normal main deployment:
            * confirmed apogee -> drogue descent -> configured AGL altitude.
            */
           uint8_t normal_main_condition =
               since_apogee_ms >=
                   FLIGHT_MAIN_MIN_AFTER_APOGEE_MS &&
               baro_filtered_alt_ft10 <=
                   configured_main_alt_ft10 &&
               baro_descent_ft10s <=
                   FLIGHT_MAIN_DESCENT_FT10S;
           if (normal_main_condition)
           {
               if (flight_main_candidate_ms == 0)
               {
                   flight_main_candidate_ms =
                       now_ms;
               }
           }
           else
           {
               flight_main_candidate_ms = 0;
           }
           /*
            * Emergency main deployment:
            *
            * Use the existing filtered barometric vertical speed used by
            * flight control. The raw barometric vertical speed remains
            * logging-only and has no authority to trigger MAIN.
            *
            * The filtered descent rate must remain continuously at or below
            * -200 ft/s for 1.5 seconds. If it rises above the threshold
            * during confirmation, the timer resets immediately.
            */
           if (
               baro_descent_ft10s <=
               FLIGHT_MAIN_EMERGENCY_DESCENT_FT10S
           )
           {
               if (flight_main_emergency_candidate_ms == 0)
               {
                   flight_main_emergency_candidate_ms =
                       now_ms;
               }
           }
           else
           {
               flight_main_emergency_candidate_ms = 0;
           }
           uint8_t normal_main_confirmed =
               flight_main_candidate_ms != 0 &&
               (now_ms - flight_main_candidate_ms) >=
                   FLIGHT_MAIN_CONFIRM_MS;
           uint8_t emergency_main_confirmed =
               flight_main_emergency_candidate_ms != 0 &&
               (now_ms - flight_main_emergency_candidate_ms) >=
                   FLIGHT_MAIN_EMERGENCY_CONFIRM_MS;
           if (
               normal_main_confirmed ||
               emergency_main_confirmed
           )
           {
               /*
                * If both conditions become valid together, log the faster
                * descent condition as the reason because it is the more
                * urgent deployment path.
                */
               flight_main_trigger =
                   emergency_main_confirmed ?
                   FLIGHT_MAIN_TRIGGER_EXCESSIVE_DESCENT :
                   FLIGHT_MAIN_TRIGGER_ALTITUDE;
               flight_main_deploy_detected_ms = now_ms;
               /*
                * MAIN camera indicator. PA3 goes HIGH at the exact existing
                * MAIN_WOULD_FIRE decision point. FlightOutputs_Service()
                * returns it LOW after 500 ms.
                */
               flight_main_would_fire = 1;
               flight_main_fire_would_high_ms = HAL_GetTick();
               FlightOutputs_TriggerMain(
                   flight_main_fire_would_high_ms
               );
               flight_main_detect_to_fire_ms =
                   flight_main_fire_would_high_ms -
                   flight_main_deploy_detected_ms;
               flight_event_flags |=
                   FLIGHT_FLAG_MAIN_WOULD_FIRE;
               FlightLogic_LogEvent(
                   FLIGHT_EVENT_MAIN_DEPLOYMENT_DETECTED,
                   flight_main_deploy_detected_ms
               );
               flight_state =
                   FLIGHT_STATE_MAIN_DESCENT;
               FlightLogic_LogEvent(
                   FLIGHT_EVENT_MAIN_WOULD_FIRE,
                   flight_main_fire_would_high_ms
               );
               flight_main_candidate_ms = 0;
               flight_main_emergency_candidate_ms = 0;
               flight_landing_candidate_ms = 0;
           }
           break;
       }
       case FLIGHT_STATE_MAIN_DESCENT:
       {
           int32_t abs_vertical_speed =
               baro_descent_ft10s;
           if (abs_vertical_speed < 0)
           {
               abs_vertical_speed =
                   -abs_vertical_speed;
           }
           uint8_t landing_conditions =
               baro_ok &&
               flight_baro_trusted &&
               abs_vertical_speed <=
                   FLIGHT_LANDING_VS_ABS_FT10S &&
               flight_accel_mag_mg >=
                   FLIGHT_LANDING_ACCEL_MIN_MG &&
               flight_accel_mag_mg <=
                   FLIGHT_LANDING_ACCEL_MAX_MG &&
               flight_gyro_mag_dps10 <=
                   FLIGHT_LANDING_GYRO_MAX_DPS10;
           if (landing_conditions)
           {
               if (flight_landing_candidate_ms == 0)
               {
                   flight_landing_candidate_ms =
                       now_ms;
                   flight_landing_reference_alt_ft10 =
                       baro_filtered_alt_ft10;
               }
               int32_t altitude_delta =
                   baro_filtered_alt_ft10 -
                   flight_landing_reference_alt_ft10;
               if (altitude_delta < 0)
               {
                   altitude_delta =
                       -altitude_delta;
               }
               if (
                   altitude_delta >
                   FLIGHT_LANDING_ALT_WINDOW_FT10
               )
               {
                   flight_landing_candidate_ms = 0;
               }
               else if (
                   (now_ms - flight_landing_candidate_ms) >=
                   FLIGHT_LANDING_CONFIRM_MS
               )
               {
                   flight_landed_detected = 1;
                   flight_landed_ms = now_ms;
                   flight_event_flags |=
                       FLIGHT_FLAG_LANDED;
                   flight_state =
                       FLIGHT_STATE_LANDED;
                   FlightLogic_LogEvent(
                       FLIGHT_EVENT_LANDED,
                       now_ms
                   );
                   /*
                    * Confirmed landing: FIRE outputs LOW first, ARM LOW second.
                    * PB2 AUX also remains LOW.
                    */
                   FlightOutputs_Safe();
                   flight_pyro_arm_would_be_high = 0;
                   flight_event_flags |=
                       FLIGHT_FLAG_PYRO_ARM_DISABLED;
                   FlightLogic_LogEvent(
                       FLIGHT_EVENT_PYRO_ARM_WOULD_DISABLE,
                       now_ms
                   );
                   /*
                    * Landed is an important file-integrity boundary.
                    * Push the SD tail immediately if the card is healthy.
                    */
                   if (sdlog_ok)
                   {
                       if (!SDLOG_Sync())
                       {
                           sdlog_ok = 0;
                       }
                   }
                   flight_landing_candidate_ms = 0;
               }
           }
           else
           {
               flight_landing_candidate_ms = 0;
           }
           break;
       }
       case FLIGHT_STATE_LANDED:
       {
           if (
               (now_ms - flight_landed_ms) >=
               FLIGHT_RECOVERY_ENTRY_DELAY_MS
           )
           {
               flight_state =
                   FLIGHT_STATE_RECOVERY;
               flight_event_flags |=
                   FLIGHT_FLAG_RECOVERY;
               FlightLogic_LogEvent(
                   FLIGHT_EVENT_RECOVERY_MODE,
                   now_ms
               );
               /*
                * Recovery mode only needs periodic outbound beacons.
                * Put the RFM95 to sleep between those beacons.
                */
               if (lora_ok)
               {
                   LORA_Sleep();
               }
           }
           break;
       }
       case FLIGHT_STATE_RECOVERY:
       {
           /*
            * LANDED remains latched forever for this power cycle.
            * Movement during recovery does not return ATLAS to a flight state.
            */
           break;
       }
       case FLIGHT_STATE_INITIALIZING:
       case FLIGHT_STATE_FAULT:
       default:
           break;
   }
}
static uint8_t BLACKBOX_LogCurrentData(
   uint32_t timestamp_ms
);
int main(void)
{
   HAL_Init();
   SystemClock_Config();
   MX_GPIO_Init();
   /* Proven bench-test boot state: FIRE LOW first, ARM LOW second. */
   FlightOutputs_Safe();
   Battery_ADC_Init();
   MX_I2C1_Init();
   MX_SPI1_Init();
   MX_SPI2_Init();
   MX_SPI3_Init();
   MX_USART1_UART_Init();
   /* USART1 PA9 TX test for Nano Flip serial bridge */
   const char uart_test[] =
       "\r\nATLAS V2 USART1 PA9 TEST\r\n";
   HAL_UART_Transmit(
       &huart1,
       (uint8_t *)uart_test,
       (uint16_t)strlen(uart_test),
       1000
   );
   MX_USB_DEVICE_Init();
   /*
    * Register the CubeMX FatFs USER_Driver.
    * The actual microSD physical driver is user_diskio.c using SPI2 + PA8.
    */
   MX_FATFS_Init();
   HAL_GPIO_WritePin(IMU1_CS_PORT, IMU1_CS_PIN, GPIO_PIN_SET);
   HAL_GPIO_WritePin(IMU2_CS_PORT, IMU2_CS_PIN, GPIO_PIN_SET);
   HAL_GPIO_WritePin(ACCEL_CS_PORT, ACCEL_CS_PIN, GPIO_PIN_SET);
   HAL_GPIO_WritePin(FLASH_CS_PORT, FLASH_CS_PIN, GPIO_PIN_SET);
   HAL_GPIO_WritePin(SD_CS_PORT, SD_CS_PIN, GPIO_PIN_SET);
   HAL_GPIO_WritePin(LORA_CS_PORT, LORA_CS_PIN, GPIO_PIN_SET);
   /* ================================
    * W25Q128 FLASH JEDEC ID TEST
    * ================================ */
   uint8_t flash_manufacturer = 0;
   uint8_t flash_memory_type = 0;
   uint8_t flash_capacity = 0;
   FLASH_ReadJEDEC(
       &flash_manufacturer,
       &flash_memory_type,
       &flash_capacity
   );
   /* Check for W25Q128: EF 40 18 */
   if (
       flash_manufacturer == 0xEF &&
       flash_memory_type  == 0x40 &&
       flash_capacity     == 0x18
   )
   {
       /* FLASH FOUND - 2 slow LED blinks */
       for (uint8_t i = 0; i < 2; i++)
       {
           HAL_GPIO_WritePin(
               LED_PORT,
               LED_PIN,
               GPIO_PIN_SET
           );
           HAL_Delay(300);
           HAL_GPIO_WritePin(
               LED_PORT,
               LED_PIN,
               GPIO_PIN_RESET
           );
           HAL_Delay(300);
       }
   }
   else
   {
       /* FLASH NOT FOUND - 6 fast LED blinks */
       for (uint8_t i = 0; i < 6; i++)
       {
           HAL_GPIO_WritePin(
               LED_PORT,
               LED_PIN,
               GPIO_PIN_SET
           );
           HAL_Delay(80);
           HAL_GPIO_WritePin(
               LED_PORT,
               LED_PIN,
               GPIO_PIN_RESET
           );
           HAL_Delay(80);
       }
   }
   /* Continue normal ATLAS startup */
   Startup_Beep();
   imu1_ok = IMU_Init(IMU1_CS_PORT, IMU1_CS_PIN, &imu1_who);
   imu2_ok = IMU_Init(IMU2_CS_PORT, IMU2_CS_PIN, &imu2_who);
   highg_ok = ADXL372_Init();
   baro_ok = MS5607_Init();
   if (baro_ok)
   {
       Baro_SetBaseline();
   }
   gps.present = GPS_Init();
   lora_ok = LORA_Init();
   if (lora_ok)
   {
       LORA_RxContinuous();
   }
   /*
    * Start the microSD high-rate recorder.
    *
    * A NEW FLTxxxx.BIN file is created on every power-up.
    * Existing files are never overwritten.
    *
    * SD failure does NOT stop the rest of ATLAS.
    */
   sdlog_ok = SDLOG_Start();
   /*
    * Start the ATLAS V2 black-box logger.
    *
    * BLACKBOX_Init():
    *   - scans existing records
    *   - finds the next unused 128-byte slot
    *   - finds the highest previous session number
    *
    * BLACKBOX_StartSession():
    *   - creates a NEW session header for this power-up
    *   - does NOT erase any previous records
    *   - resets this session's data-record sequence to 0
    */
   blackbox_ok = BLACKBOX_Init();
   if (blackbox_ok)
   {
       blackbox_ok = BLACKBOX_StartSession();
   }
   if (blackbox_ok)
   {
       /*
        * Write and verify the first real data record for this session.
        *
        * 4 slow blinks =
        *   session header written + verified
        *   first data record written + verified
        */
       if (BLACKBOX_LogCurrentData(HAL_GetTick()))
       {
           for (uint8_t i = 0; i < 4; i++)
           {
               HAL_GPIO_WritePin(LED_PORT, LED_PIN, GPIO_PIN_SET);
               HAL_Delay(200);
               HAL_GPIO_WritePin(LED_PORT, LED_PIN, GPIO_PIN_RESET);
               HAL_Delay(200);
           }
       }
       else
       {
           blackbox_ok = 0;
       }
   }
   /*
    * Initialization is now complete. Enter WAIT_FOR_LAUNCH and write the
    * first explicit flight-state event into both onboard loggers.
    */
   FlightLogic_Init(HAL_GetTick());
   uint32_t packet_number = 0;
   uint32_t last_telemetry_ms = 0;
   uint32_t last_led_ms = 0;
   uint32_t last_lora_retry_ms = HAL_GetTick();
   uint32_t last_gps_retry_ms = HAL_GetTick();
   uint32_t last_gps_service_ms = 0;
   uint32_t last_gps_poll_ms = 0;
   uint32_t last_blackbox_ms = HAL_GetTick();
   uint32_t blackbox_debug_start_ms = HAL_GetTick();
   uint8_t blackbox_debug_sent = 0;
   uint32_t last_sd_start_retry_ms = HAL_GetTick();
   /* Start the runtime watchdog only after startup scanning/configuration. */
   ATLAS_WatchdogInit();
   while (1)
   {
       uint32_t now_ms = HAL_GetTick();
       /*
        * LoRa command RX gets FIRST priority in the superloop.
        *
        * Frequency-change and flash-info commands are checked before
        * barometer work, SD logging, or W25 black-box logging.
        */
       if (lora_ok && !FlightLogic_IsRecovery())
       {
           LORA_ServiceRx();
       }
       Baro_Service(now_ms);
       /*
        * Flight event/state detector.
        *
        * Flight-along camera-indicator logic. The state machine records the
        * same events and drives only the PB0/PA0/PA3 indicator outputs.
        */
       FlightLogic_Service(now_ms);
       /* Maintain PB0 ARM and finish any active 500 ms APO/MAIN pulse. */
       FlightOutputs_Service(HAL_GetTick());
       /*
        * Retry a transient boot-time SD start failure while still on the pad.
        * Once an SD session has started, later in-flight write failures are
        * latched instead of attempting a blocking remount during flight.
        */
       if (
           !sdlog_ok &&
           !sdlog_ever_started &&
           !flight_launch_detected &&
           (now_ms - last_sd_start_retry_ms) >=
               SDLOG_START_RETRY_INTERVAL_MS
       )
       {
           last_sd_start_retry_ms = now_ms;
           sdlog_ok = SDLOG_Start();
           if (sdlog_ok)
           {
               /* Re-create the current pre-launch context in the late-started
                * SD log without duplicating black-box events.
                */
               SDLOG_LogFlightEvent(
                   FLIGHT_EVENT_INIT_COMPLETE,
                   now_ms
               );
               SDLOG_LogFlightTrace(
                   FLIGHT_EVENT_INIT_COMPLETE,
                   now_ms,
                   now_ms,
                   0,
                   0
               );
               SDLOG_LogFlightEvent(
                   FLIGHT_EVENT_MAIN_ALTITUDE_SET,
                   now_ms
               );
               SDLOG_LogFlightTrace(
                   FLIGHT_EVENT_MAIN_ALTITUDE_SET,
                   now_ms,
                   now_ms,
                   0,
                   0
               );
           }
       }
       /*
        * High-rate microSD flight recorder.
        * Runs independently from LoRa telemetry and the W25 black box.
        */
       if (sdlog_ok)
       {
           SDLOG_Service(now_ms);
       }
       /*
        * Service LoRa again immediately after the SD logger because
        * FatFs writes/syncs are one of the longer blocking operations.
        */
       if (lora_ok && !FlightLogic_IsRecovery())
       {
           LORA_ServiceRx();
       }
       /*
        * Real black-box data logging at 10 Hz.
        * This is independent of the 2-second LoRa telemetry interval.
        */
       uint32_t current_blackbox_interval_ms =
           FlightLogic_IsRecovery() ?
           RECOVERY_BLACKBOX_INTERVAL_MS :
           BLACKBOX_LOG_INTERVAL_MS;
       if (
           blackbox_ok &&
           (now_ms - last_blackbox_ms) >=
               current_blackbox_interval_ms
       )
       {
           last_blackbox_ms = now_ms;
           if (!BLACKBOX_LogCurrentData(now_ms))
           {
               blackbox_ok = 0;
           }
       }
       /*
        * Service LoRa again after the W25 write/readback cycle.
        * W25Q128 and the RFM95 share SPI1, so the radio is checked
        * immediately after the flash transaction completes.
        */
       if (lora_ok && !FlightLogic_IsRecovery())
       {
           LORA_ServiceRx();
       }
       /*
        * One-time temporary black-box readback test.
        *
        * After ~1.5 s, enough 10 Hz records exist to inspect the
        * session header plus the first five data records.
        *
        * Output is sent on USART1 at 115200 baud as readable ASCII.
        */
       if (
           blackbox_ok &&
           !blackbox_debug_sent &&
           (now_ms - blackbox_debug_start_ms) >= BLACKBOX_DEBUG_DELAY_MS
       )
       {
           blackbox_debug_sent = 1;
           BLACKBOX_DebugReadCurrentSession();
       }
       uint32_t current_gps_service_interval_ms =
           FlightLogic_IsRecovery() ?
           RECOVERY_GPS_SERVICE_INTERVAL_MS :
           GPS_SERVICE_INTERVAL_MS;
       uint32_t current_gps_poll_interval_ms =
           FlightLogic_IsRecovery() ?
           RECOVERY_GPS_POLL_INTERVAL_MS :
           500UL;
       if (
           (now_ms - last_gps_service_ms) >=
           current_gps_service_interval_ms
       )
       {
           last_gps_service_ms = now_ms;
           GPS_Service();
       }
       if (
           gps.present &&
           (now_ms - last_gps_poll_ms) >=
               current_gps_poll_interval_ms
       )
       {
           last_gps_poll_ms = now_ms;
           GPS_PollNavPvt();
       }
       if (!lora_ok &&
           (now_ms - last_lora_retry_ms) >= LORA_RETRY_INTERVAL_MS)
       {
           last_lora_retry_ms = now_ms;
           lora_ok = LORA_Init();
           if (lora_ok)
           {
               if (FlightLogic_IsRecovery())
               {
                   LORA_Sleep();
               }
               else
               {
                   LORA_RxContinuous();
               }
           }
       }
       if ((!gps.present || !gps.configured) &&
           (now_ms - last_gps_retry_ms) >= GPS_RETRY_INTERVAL_MS)
       {
           last_gps_retry_ms = now_ms;
           if (!gps.present)
           {
               gps.present = GPS_Init();
           }
           else
           {
               gps.configured = GPS_Configure();
           }
       }
       uint32_t current_led_interval_ms =
           FlightLogic_IsRecovery() ?
           RECOVERY_LED_INTERVAL_MS :
           LED_INTERVAL_MS;
       if (
           (now_ms - last_led_ms) >=
           current_led_interval_ms
       )
       {
           last_led_ms = now_ms;
           HAL_GPIO_TogglePin(LED_PORT, LED_PIN);
       }
       uint32_t current_telemetry_interval_ms =
           FlightLogic_GetTelemetryInterval(now_ms);
       if (
           (now_ms - last_telemetry_ms) >=
           current_telemetry_interval_ms
       )
       {
           last_telemetry_ms = now_ms;
           packet_number++;
           imu1_who = IMU_ReadReg(IMU1_CS_PORT, IMU1_CS_PIN, LSM6_WHO_AM_I);
           imu2_who = IMU_ReadReg(IMU2_CS_PORT, IMU2_CS_PIN, LSM6_WHO_AM_I);
           imu1_ok = (imu1_who == 0x69);
           imu2_ok = (imu2_who == 0x69);
           if (imu1_ok)
           {
               IMU_Read(IMU1_CS_PORT, IMU1_CS_PIN,
                        &imu_ax, &imu_ay, &imu_az,
                        &imu_gx, &imu_gy, &imu_gz);
           }
           else
           {
               imu_ax = imu_ay = imu_az = 0;
               imu_gx = imu_gy = imu_gz = 0;
           }
           char latitude[20] = "---";
           char longitude[20] = "---";
           char gps_altitude[16] = "---";
           char gps_vertical_speed[16] = "---";
           char baro_altitude[16] = "---";
           char descent_rate[16] = "---";
           char ax_s[16] = "---";
           char ay_s[16] = "---";
           char az_s[16] = "---";
           char gx_s[16] = "---";
           char gy_s[16] = "---";
           char gz_s[16] = "---";
           const char *gps_status = "FAIL";
           const char *gps_fix_type = "---";
           uint32_t gps_age_ms = 0;
           if (gps.present)
           {
               gps_status = gps.fix_ok ? "FIX" : "NOFIX";
               switch (gps.fix_type)
               {
                   case 1:
                       gps_fix_type = "DR";
                       break;
                   case 2:
                       gps_fix_type = "2D";
                       break;
                   case 3:
                       gps_fix_type = "3D";
                       break;
                   case 4:
                       gps_fix_type = "GNSS+DR";
                       break;
                   case 5:
                       gps_fix_type = "TIME";
                       break;
                   default:
                       gps_fix_type = "NOFIX";
                       break;
               }
               if (gps.last_fix_ms != 0)
               {
                   /*
                    * Read HAL_GetTick() here instead of using now_ms from
                    * the top of the loop. GPS_Service() may have updated
                    * last_fix_ms after now_ms was captured.
                    */
                   gps_age_ms = HAL_GetTick() - gps.last_fix_ms;
                   FormatCoordE7(latitude, sizeof(latitude), gps.lat_e7);
                   FormatCoordE7(longitude, sizeof(longitude), gps.lon_e7);
                   FormatSigned1(
                       gps_altitude,
                       sizeof(gps_altitude),
                       MillimetersToFeetX10(gps.hmsl_mm)
                   );
                   /*
                    * UBX NAV-PVT velD is positive downward.
                    * Positive GPSVSFTS therefore means descending.
                    */
                   FormatSigned1(
                       gps_vertical_speed,
                       sizeof(gps_vertical_speed),
                       MillimetersToFeetX10(gps.vel_d_mmps)
                   );
               }
           }
           if (baro_ok)
           {
               FormatSigned1(baro_altitude, sizeof(baro_altitude),
                             baro_filtered_alt_ft10);
               FormatSigned1(descent_rate, sizeof(descent_rate),
                             baro_descent_ft10s);
           }
           if (imu1_ok)
           {
               FormatSigned3(ax_s, sizeof(ax_s), imu_ax);
               FormatSigned3(ay_s, sizeof(ay_s), imu_ay);
               FormatSigned3(az_s, sizeof(az_s), imu_az);
               FormatSigned1(gx_s, sizeof(gx_s), imu_gx);
               FormatSigned1(gy_s, sizeof(gy_s), imu_gy);
               FormatSigned1(gz_s, sizeof(gz_s), imu_gz);
           }
           uint32_t battery_mv = Battery_ReadMillivolts();
           char battery_voltage[16];
           snprintf(battery_voltage,
                    sizeof(battery_voltage),
                    "%lu.%02lu",
                    (unsigned long)(battery_mv / 1000UL),
                    (unsigned long)((battery_mv % 1000UL) / 10UL));
           char packet[256];
           snprintf(packet, sizeof(packet),
                    "AT1,PKT=%lu,RFHZ=%lu,BATV=%s,FS=%u,BT=%u,ARM=%u,EV=%lX,"
                    "GPS=%s,FIX=%s,SATS=%u,"
                    "LAT=%s,LON=%s,GPSAGE=%lu,GPSALTFT=%s,GPSVSFTS=%s,"
                    "B1=%s,A1FT=%s,DESCFTS=%s,"
                    "I1=%s,I2=%s,AX=%s,AY=%s,AZ=%s,GX=%s,GY=%s,GZ=%s",
                    (unsigned long)packet_number,
                    (unsigned long)actual_lora_frequency_hz,
                    battery_voltage,
                    (unsigned int)flight_state,
                    (unsigned int)flight_baro_trusted,
                    (unsigned int)flight_pyro_arm_would_be_high,
                    (unsigned long)flight_event_flags,
                    gps_status,
                    gps_fix_type,
                    (unsigned int)gps.sats,
                    latitude,
                    longitude,
                    (unsigned long)gps_age_ms,
                    gps_altitude,
                    gps_vertical_speed,
                    baro_ok ? "OK" : "FAIL",
                    baro_altitude,
                    descent_rate,
                    imu1_ok ? "OK" : "FAIL",
                    imu2_ok ? "OK" : "FAIL",
                    ax_s, ay_s, az_s, gx_s, gy_s, gz_s);
           if (lora_ok)
           {
               if (!LORA_Send((uint8_t *)packet,
                              (uint8_t)strlen(packet),
                              1000))
               {
                   lora_ok = 0;
               }
               else
               {
                   if (FlightLogic_IsRecovery())
                   {
                       LORA_Sleep();
                   }
                   else
                   {
                       LORA_RxContinuous();
                   }
               }
           }
       }
       ATLAS_WatchdogKick();
   }
}
static int16_t SaturateI32ToI16(int32_t value)
{
   if (value > 32767L)
   {
       return 32767;
   }
   if (value < -32768L)
   {
       return -32768;
   }
   return (int16_t)value;
}
static void ATLAS_WatchdogInit(void)
{
   /* Configure IWDG without adding a CubeMX/HAL-IWDG dependency. */
   IWDG->KR = 0xCCCCU;  /* Start IWDG and its LSI clock. */
   IWDG->KR = 0x5555U;  /* Enable PR/RLR writes. */
   IWDG->PR = ATLAS_IWDG_PRESCALER_BITS;
   IWDG->RLR = ATLAS_IWDG_RELOAD_VALUE;
   while (IWDG->SR != 0U)
   {
       /* Wait until prescaler/reload updates reach the watchdog domain. */
   }
   IWDG->KR = 0xAAAAU;
}
static void ATLAS_WatchdogKick(void)
{
   IWDG->KR = 0xAAAAU;
}
static void Battery_ADC_Init(void)
{
   __HAL_RCC_ADC1_CLK_ENABLE();
   /* ADC clock = PCLK2 / 4 */
   ADC->CCR &= ~(3UL << 16);
   ADC->CCR |=  (1UL << 16);
   ADC1->CR1 = 0;
   ADC1->CR2 = 0;
   /*
    * One regular conversion at a time.
    *
    * ADC1_IN1 = PA1 = APO voltage-divider sense
    * ADC1_IN2 = PA2 = MAIN voltage-divider sense
    * ADC1_IN9 = PB1 = onboard battery sense
    */
   ADC1->SQR1 = 0;
   ADC1->SQR3 = 9;
   /* Long 480-cycle sample time on channels 1, 2 and 9. */
   ADC1->SMPR2 &= ~(
       (7UL << 3) |
       (7UL << 6) |
       (7UL << 27)
   );
   ADC1->SMPR2 |= (
       (7UL << 3) |
       (7UL << 6) |
       (7UL << 27)
   );
   ADC1->CR2 |= ADC_CR2_ADON;
   HAL_Delay(5);
}
static uint16_t ADC1_ReadChannelRaw(uint8_t channel)
{
   /*
    * PB2 AUX always stays LOW.
    *
    * Do not force PB0, PA0, or PA3 LOW here. Battery and continuity ADC
    * reads run throughout flight, and doing so would cancel the ARM state
    * or shorten an active 500 ms APO/MAIN camera-indicator pulse.
    */
   HAL_GPIO_WritePin(
       AUX_FIRE_PORT,
       AUX_FIRE_PIN,
       GPIO_PIN_RESET
   );
   if (channel > 18U)
   {
       return 0;
   }
   ADC1->SQR3 = (uint32_t)channel;
   ADC1->SR = 0;
   ADC1->CR2 |= ADC_CR2_SWSTART;
   uint32_t start_ms = HAL_GetTick();
   while ((ADC1->SR & ADC_SR_EOC) == 0)
   {
       HAL_GPIO_WritePin(
           AUX_FIRE_PORT,
           AUX_FIRE_PIN,
           GPIO_PIN_RESET
       );
       if ((HAL_GetTick() - start_ms) > 20UL)
       {
           return 0;
       }
   }
   return (uint16_t)ADC1->DR;
}
static uint16_t ADC1_ReadChannelAverage(
   uint8_t channel,
   uint32_t samples
)
{
   if (samples == 0)
   {
       return 0;
   }
   uint32_t sum = 0;
   for (uint32_t i = 0; i < samples; i++)
   {
       sum += ADC1_ReadChannelRaw(channel);
   }
   return (uint16_t)(sum / samples);
}
static uint16_t Battery_ADC_ReadRaw(void)
{
   return ADC1_ReadChannelRaw(9U);
}
static uint32_t Battery_ReadMillivolts(void)
{
   uint32_t average_raw =
       ADC1_ReadChannelAverage(
           9U,
           BAT_ADC_SAMPLES
       );
   uint64_t sense_mv =
       ((uint64_t)average_raw * BAT_ADC_REFERENCE_MV) /
       BAT_ADC_MAX_COUNT;
   uint64_t battery_mv =
       sense_mv *
       (BAT_DIV_TOP_OHMS + BAT_DIV_BOTTOM_OHMS) /
       BAT_DIV_BOTTOM_OHMS;
   return (uint32_t)battery_mv;
}
static uint16_t Continuity_ReadApoRaw(void)
{
   return ADC1_ReadChannelAverage(
       1U,
       CONT_ADC_SAMPLES
   );
}
static uint16_t Continuity_ReadMainRaw(void)
{
   return ADC1_ReadChannelAverage(
       2U,
       CONT_ADC_SAMPLES
   );
}
static void FLASH_Select(void)
{
   HAL_GPIO_WritePin(FLASH_CS_PORT, FLASH_CS_PIN, GPIO_PIN_RESET);
}
static void FLASH_Unselect(void)
{
   HAL_GPIO_WritePin(FLASH_CS_PORT, FLASH_CS_PIN, GPIO_PIN_SET);
}
static void FLASH_ReadJEDEC(uint8_t *manufacturer,
                           uint8_t *memory_type,
                           uint8_t *capacity)
{
   uint8_t tx[4] = {0x9F, 0x00, 0x00, 0x00};
   uint8_t rx[4] = {0};
   FLASH_Select();
   HAL_SPI_TransmitReceive(&hspi1, tx, rx, 4, 100);
   FLASH_Unselect();
   *manufacturer = rx[1];
   *memory_type = rx[2];
   *capacity = rx[3];
}
static uint8_t FLASH_ReadStatus1(void)
{
   uint8_t tx[2] = {0x05, 0x00};
   uint8_t rx[2] = {0};
   FLASH_Select();
   HAL_SPI_TransmitReceive(&hspi1, tx, rx, 2, 100);
   FLASH_Unselect();
   return rx[1];
}
static void FLASH_WriteEnable(void)
{
   uint8_t command = 0x06;
   FLASH_Select();
   HAL_SPI_Transmit(&hspi1, &command, 1, 100);
   FLASH_Unselect();
}
static void FLASH_WaitBusy(void)
{
   while (FLASH_ReadStatus1() & 0x01)
   {
       FlightOutputs_Service(HAL_GetTick());
       HAL_Delay(1);
   }
}
static uint8_t FLASH_WaitBusyTimeout(uint32_t timeout_ms)
{
   uint32_t start_ms = HAL_GetTick();
   while (FLASH_ReadStatus1() & 0x01)
   {
       /* PB2 AUX remains LOW during flash maintenance. */
       HAL_GPIO_WritePin(
           AUX_FIRE_PORT,
           AUX_FIRE_PIN,
           GPIO_PIN_RESET
       );
       if ((HAL_GetTick() - start_ms) >= timeout_ms)
       {
           return 0;
       }
       HAL_Delay(10);
   }
   return 1;
}
static uint8_t FLASH_ChipErase(void)
{
   uint8_t command = 0xC7;
   FLASH_WriteEnable();
   FLASH_Select();
   HAL_SPI_Transmit(
       &hspi1,
       &command,
       1,
       100
   );
   FLASH_Unselect();
   uint32_t start_ms = HAL_GetTick();
   uint32_t last_progress_ms = start_ms;
   while (FLASH_ReadStatus1() & 0x01)
   {
       ATLAS_WatchdogKick();
       HAL_GPIO_WritePin(
           AUX_FIRE_PORT,
           AUX_FIRE_PIN,
           GPIO_PIN_RESET
       );
       if (
           HAL_GetTick() - last_progress_ms >= 2000UL
       )
       {
           const char progress[] =
               "FLASHCLEAR_PROGRESS";
           LORA_Send(
               (uint8_t *)progress,
               (uint8_t)strlen(progress),
               1000
           );
           LORA_RxContinuous();
           last_progress_ms =
               HAL_GetTick();
       }
       if (
           HAL_GetTick() - start_ms >=
           180000UL
       )
       {
           return 0;
       }
       HAL_Delay(20);
   }
   return 1;
}
static uint32_t FLASH_FindUsedBytes(void)
{
   uint8_t record[BLACKBOX_RECORD_SIZE];
   for (
       uint32_t address = BLACKBOX_START_ADDR;
       (address + BLACKBOX_RECORD_SIZE) <= BLACKBOX_END_ADDR;
       address += BLACKBOX_RECORD_SIZE
   )
   {
       FLASH_ReadData(address, record, sizeof(record));
       uint8_t erased = 1;
       for (uint32_t i = 0; i < sizeof(record); i++)
       {
           if (record[i] != 0xFF)
           {
               erased = 0;
               break;
           }
       }
       if (erased)
       {
           return address - BLACKBOX_START_ADDR;
       }
   }
   return BLACKBOX_END_ADDR - BLACKBOX_START_ADDR;
}
static uint8_t FLASH_VerifyErasedSamples(void)
{
   uint8_t data[256];
   uint32_t last_progress_ms =
       HAL_GetTick();
   for (
       uint32_t address = 0x000000UL;
       address < 0x1000000UL;
       address += sizeof(data)
   )
   {
       ATLAS_WatchdogKick();
       HAL_GPIO_WritePin(
           AUX_FIRE_PORT,
           AUX_FIRE_PIN,
           GPIO_PIN_RESET
       );
       FLASH_ReadData(
           address,
           data,
           sizeof(data)
       );
       for (
           uint32_t i = 0;
           i < sizeof(data);
           i++
       )
       {
           if (data[i] != 0xFF)
           {
               return 0;
           }
       }
       if (
           HAL_GetTick() - last_progress_ms >=
           2000UL
       )
       {
           const char progress[] =
               "FLASHVERIFY_PROGRESS";
           LORA_Send(
               (uint8_t *)progress,
               (uint8_t)strlen(progress),
               1000
           );
           LORA_RxContinuous();
           last_progress_ms =
               HAL_GetTick();
       }
   }
   return 1;
}
static void FLASH_EraseSector4K(uint32_t address)
{
   uint8_t command[4];
   command[0] = 0x20;
   command[1] = (uint8_t)((address >> 16) & 0xFF);
   command[2] = (uint8_t)((address >> 8) & 0xFF);
   command[3] = (uint8_t)(address & 0xFF);
   FLASH_WriteEnable();
   FLASH_Select();
   HAL_SPI_Transmit(&hspi1, command, 4, 100);
   FLASH_Unselect();
   FLASH_WaitBusy();
}
static void FLASH_WritePage(uint32_t address,
                           const uint8_t *data,
                           uint16_t len)
{
   uint8_t command[4];
   if (len == 0)
   {
       return;
   }
   if (len > 256)
   {
       len = 256;
   }
   command[0] = 0x02;
   command[1] = (uint8_t)((address >> 16) & 0xFF);
   command[2] = (uint8_t)((address >> 8) & 0xFF);
   command[3] = (uint8_t)(address & 0xFF);
   FLASH_WriteEnable();
   FLASH_Select();
   HAL_SPI_Transmit(&hspi1, command, 4, 100);
   HAL_SPI_Transmit(&hspi1, (uint8_t *)data, len, 100);
   FLASH_Unselect();
   FLASH_WaitBusy();
}
static void FLASH_ReadData(uint32_t address,
                          uint8_t *data,
                          uint16_t len)
{
   uint8_t command[4];
   if (len == 0)
   {
       return;
   }
   command[0] = 0x03;
   command[1] = (uint8_t)((address >> 16) & 0xFF);
   command[2] = (uint8_t)((address >> 8) & 0xFF);
   command[3] = (uint8_t)(address & 0xFF);
   FLASH_Select();
   HAL_SPI_Transmit(&hspi1, command, 4, 100);
   HAL_SPI_Receive(&hspi1, data, len, 100);
   FLASH_Unselect();
}
static uint8_t FLASH_IsRegionEmpty(
   uint32_t address,
   uint16_t length
)
{
   uint8_t buffer[32];
   if (length > sizeof(buffer))
   {
       return 0;
   }
   FLASH_ReadData(
       address,
       buffer,
       length
   );
   for (uint16_t i = 0; i < length; i++)
   {
       if (buffer[i] != 0xFF)
       {
           return 0;
       }
   }
   return 1;
}
static uint16_t BLACKBOX_CRC16(
   const uint8_t *data,
   uint16_t length
)
{
   uint16_t crc = 0xFFFFU;
   for (uint16_t i = 0; i < length; i++)
   {
       crc ^= (uint16_t)data[i] << 8;
       for (uint8_t bit = 0; bit < 8; bit++)
       {
           if (crc & 0x8000U)
           {
               crc = (uint16_t)((crc << 1) ^ 0x1021U);
           }
           else
           {
               crc <<= 1;
           }
       }
   }
   return crc;
}
static uint8_t BLACKBOX_WriteRecord(
   BlackBoxRecord_t *record
)
{
   if (!record)
   {
       return 0;
   }
   if (
       blackbox_next_address < BLACKBOX_START_ADDR ||
       blackbox_next_address + BLACKBOX_RECORD_SIZE > BLACKBOX_END_ADDR
   )
   {
       return 0;
   }
   record->crc16 = 0;
   record->crc16 =
       BLACKBOX_CRC16(
           (const uint8_t *)record,
           (uint16_t)(sizeof(BlackBoxRecord_t) - sizeof(record->crc16))
       );
   /*
    * BLACKBOX_RECORD_SIZE is 128 bytes and BLACKBOX_START_ADDR is
    * 256-byte aligned, so each record fits fully inside one W25Q128 page.
    */
   FLASH_WritePage(
       blackbox_next_address,
       (const uint8_t *)record,
       sizeof(BlackBoxRecord_t)
   );
   BlackBoxRecord_t verify;
   FLASH_ReadData(
       blackbox_next_address,
       (uint8_t *)&verify,
       sizeof(verify)
   );
   if (
       memcmp(
           record,
           &verify,
           sizeof(BlackBoxRecord_t)
       ) != 0
   )
   {
       return 0;
   }
   uint16_t verify_crc =
       BLACKBOX_CRC16(
           (const uint8_t *)&verify,
           (uint16_t)(sizeof(BlackBoxRecord_t) - sizeof(verify.crc16))
       );
   if (verify_crc != verify.crc16)
   {
       return 0;
   }
   blackbox_next_address += BLACKBOX_RECORD_SIZE;
   return 1;
}
static uint8_t BLACKBOX_LogCurrentData(
   uint32_t timestamp_ms
)
{
   /*
    * Read IMU1 specifically for the black-box record so its data rate
    * is independent of the slower LoRa telemetry packet.
    */
   int32_t bb_ax = 0;
   int32_t bb_ay = 0;
   int32_t bb_az = 0;
   int32_t bb_gx = 0;
   int32_t bb_gy = 0;
   int32_t bb_gz = 0;
   int32_t bb2_ax = 0;
   int32_t bb2_ay = 0;
   int32_t bb2_az = 0;
   int32_t bb2_gx = 0;
   int32_t bb2_gy = 0;
   int32_t bb2_gz = 0;
   uint8_t imu1_current_ok =
       (IMU_ReadReg(
           IMU1_CS_PORT,
           IMU1_CS_PIN,
           LSM6_WHO_AM_I
       ) == 0x69);
   if (imu1_current_ok)
   {
       IMU_Read(
           IMU1_CS_PORT,
           IMU1_CS_PIN,
           &bb_ax,
           &bb_ay,
           &bb_az,
           &bb_gx,
           &bb_gy,
           &bb_gz
       );
   }
   uint8_t imu2_current_ok =
       (IMU_ReadReg(
           IMU2_CS_PORT,
           IMU2_CS_PIN,
           LSM6_WHO_AM_I
       ) == 0x69);
   if (imu2_current_ok)
   {
       IMU_Read(
           IMU2_CS_PORT,
           IMU2_CS_PIN,
           &bb2_ax,
           &bb2_ay,
           &bb2_az,
           &bb2_gx,
           &bb2_gy,
           &bb2_gz
       );
   }
   int32_t bb_highg_x_mg = 0;
   int32_t bb_highg_y_mg = 0;
   int32_t bb_highg_z_mg = 0;
   uint8_t highg_current_ok = 0;
   if (highg_ok)
   {
       highg_current_ok =
           ADXL372_ReadAccelMg(
               &bb_highg_x_mg,
               &bb_highg_y_mg,
               &bb_highg_z_mg
           );
       if (highg_current_ok)
       {
           highg_x_mg = bb_highg_x_mg;
           highg_y_mg = bb_highg_y_mg;
           highg_z_mg = bb_highg_z_mg;
       }
   }
   BlackBoxRecord_t record;
   memset(
       &record,
       0,
       sizeof(record)
   );
   record.magic = BLACKBOX_MAGIC;
   record.version = BLACKBOX_VERSION;
   record.record_type = BLACKBOX_RECORD_DATA;
   /*
    * status_flags:
    * bit 0 = barometer OK
    * bit 1 = GPS present
    * bit 2 = GPS fix valid
    * bit 3 = IMU1 OK
    * bit 4 = IMU2 OK
    * bit 5 = LoRa OK
    * bit 6 = ADXL372 high-G OK
    */
   if (baro_ok)
   {
       record.status_flags |= (1U << 0);
   }
   if (gps.present)
   {
       record.status_flags |= (1U << 1);
   }
   if (gps.fix_ok)
   {
       record.status_flags |= (1U << 2);
   }
   if (imu1_current_ok)
   {
       record.status_flags |= (1U << 3);
   }
   if (imu2_current_ok)
   {
       record.status_flags |= (1U << 4);
   }
   if (lora_ok)
   {
       record.status_flags |= (1U << 5);
   }
   if (highg_current_ok)
   {
       record.status_flags |= (1U << 6);
   }
   if (flight_baro_trusted)
   {
       record.status_flags |= (1U << 7);
   }
   if (flight_launch_detected)
   {
       record.status_flags |= (1U << 8);
   }
   if (flight_burnout_detected)
   {
       record.status_flags |= (1U << 9);
   }
   if (flight_apogee_detected)
   {
       record.status_flags |= (1U << 10);
   }
   if (flight_drogue_would_fire)
   {
       record.status_flags |= (1U << 11);
   }
   if (flight_main_would_fire)
   {
       record.status_flags |= (1U << 12);
   }
   if (flight_landed_detected)
   {
       record.status_flags |= (1U << 13);
   }
   record.timestamp_ms = timestamp_ms;
   record.session_number = blackbox_session_number;
   record.record_sequence = blackbox_record_sequence;
   record.baro_pressure_pa = baro_pressure_pa;
   record.baro_temp_c100 = (int16_t)baro_temp_c100;
   record.baro_alt_ft10 = baro_filtered_alt_ft10;
   record.vertical_speed_ft10s = baro_descent_ft10s;
   record.battery_mv = Battery_ReadMillivolts();
   record.gps_lat_e7 = gps.lat_e7;
   record.gps_lon_e7 = gps.lon_e7;
   record.gps_alt_ft10 =
       MillimetersToFeetX10(gps.hmsl_mm);
   /*
    * UBX velD is positive downward.
    * Keep the same convention used by GPSVSFTS telemetry.
    */
   record.gps_vertical_speed_ft10s =
       MillimetersToFeetX10(gps.vel_d_mmps);
   record.gps_fix_type = gps.fix_type;
   record.gps_sats = gps.sats;
   record.gps_present = gps.present;
   record.gps_fix_ok = gps.fix_ok;
   record.imu1_ax_g1000 = SaturateI32ToI16(bb_ax);
   record.imu1_ay_g1000 = SaturateI32ToI16(bb_ay);
   record.imu1_az_g1000 = SaturateI32ToI16(bb_az);
   record.imu1_gx_dps10 = SaturateI32ToI16(bb_gx);
   record.imu1_gy_dps10 = SaturateI32ToI16(bb_gy);
   record.imu1_gz_dps10 = SaturateI32ToI16(bb_gz);
   record.imu2_ax_g1000 = SaturateI32ToI16(bb2_ax);
   record.imu2_ay_g1000 = SaturateI32ToI16(bb2_ay);
   record.imu2_az_g1000 = SaturateI32ToI16(bb2_az);
   record.imu2_gx_dps10 = SaturateI32ToI16(bb2_gx);
   record.imu2_gy_dps10 = SaturateI32ToI16(bb2_gy);
   record.imu2_gz_dps10 = SaturateI32ToI16(bb2_gz);
   /*
    * ADXL372 high-G values are stored in mg.
    * Scale is 100 mg/LSB from the signed 12-bit sensor output.
    */
   record.highg_x_mg = bb_highg_x_mg;
   record.highg_y_mg = bb_highg_y_mg;
   record.highg_z_mg = bb_highg_z_mg;
   /* Magnetometer driver is still pending. */
   record.mag_x = 0;
   record.mag_y = 0;
   record.mag_z = 0;
   /*
    * PA1 = APO voltage-divider sense, ADC1 channel 1.
    * PA2 = MAIN voltage-divider sense, ADC1 channel 2.
    *
    * Keep the permanent black-box format unchanged by storing the same
    * raw 12-bit ADC values already used by the SD power log.
    * PB2 AUX remains excluded and always stays LOW.
    */
   record.apo_sense_raw = Continuity_ReadApoRaw();
   record.main_sense_raw = Continuity_ReadMainRaw();
   /*
    * Camera-indicator GPIO state at this black-box sample:
    * bit 0 = PA0 APO indicator currently HIGH
    * bit 1 = PA3 MAIN indicator currently HIGH
    *
    * Reserved bytes carry both machine-readable flags and readable state:
    *   reserved[0]      = FlightState_t
    *   reserved[1..4]   = flight_event_flags
    *   reserved[5]      = simulated ARM GPIO state
    *   reserved[6..17]  = compact readable state name
    *
    * baroTrusted is already stored in status_flags bit 7.
    */
   record.pyro_state = 0;
   if (HAL_GPIO_ReadPin(APO_FIRE_PORT, APO_FIRE_PIN) == GPIO_PIN_SET)
   {
       record.pyro_state |= (1U << 0);
   }
   if (HAL_GPIO_ReadPin(MAIN_FIRE_PORT, MAIN_FIRE_PIN) == GPIO_PIN_SET)
   {
       record.pyro_state |= (1U << 1);
   }
   record.fault_flags = 0;
   record.reserved[0] =
       (uint8_t)flight_state;
   memcpy(
       &record.reserved[1],
       &flight_event_flags,
       sizeof(flight_event_flags)
   );
   record.reserved[5] =
       flight_pyro_arm_would_be_high;
   const char *bb_state_name =
       FlightLogic_StateName(flight_state);
   if (flight_state == FLIGHT_STATE_WAIT_FOR_LAUNCH)
   {
       bb_state_name = "WAIT_LAUNCH";
   }
   else if (flight_state == FLIGHT_STATE_DROGUE_DESCENT)
   {
       bb_state_name = "DROGUE_DESC";
   }
   else if (flight_state == FLIGHT_STATE_MAIN_DESCENT)
   {
       bb_state_name = "MAIN_DESC";
   }
   else if (flight_state == FLIGHT_STATE_INITIALIZING)
   {
       bb_state_name = "INITIALIZE";
   }
   snprintf(
       (char *)&record.reserved[6],
       12,
       "%s",
       bb_state_name
   );
   if (!BLACKBOX_WriteRecord(&record))
   {
       return 0;
   }
   blackbox_record_sequence++;
   return 1;
}
static void BLACKBOX_DebugReadCurrentSession(void)
{
   char line[220];
   /*
    * Read the current session header.
    */
   BlackBoxSessionRecord_t session;
   FLASH_ReadData(
       blackbox_session_start_address,
       (uint8_t *)&session,
       sizeof(session)
   );
   uint16_t session_crc =
       BLACKBOX_CRC16(
           (const uint8_t *)&session,
           (uint16_t)(sizeof(session) - sizeof(session.crc16))
       );
   int length = snprintf(
       line,
       sizeof(line),
       "\r\nBBDBG,TYPE=SESSION,VER=%u,SESSION=%lu,SEQ=HEADER,TIME=%lu,"
       "BATMV=%lu,PRESSPA=%ld,BASEPA=%ld,TEMPC100=%d,RFHZ=%lu,HIG=%s,CRC=%s\r\n",
       (unsigned int)session.version,
       (unsigned long)session.session_number,
       (unsigned long)session.timestamp_ms,
       (unsigned long)session.startup_battery_mv,
       (long)session.startup_pressure_pa,
       (long)session.startup_baro_base_pa,
       (int)session.startup_temp_c100,
       (unsigned long)session.lora_frequency_hz,
       session.highg_ok ? "OK" : "FAIL",
       (session_crc == session.crc16) ? "OK" : "FAIL"
   );
   if (length > 0)
   {
       HAL_UART_Transmit(
           &huart1,
           (uint8_t *)line,
           (uint16_t)length,
           200
       );
   }
   /*
    * Read the first eight records from this session.
    * Flight-event records are now interleaved with normal 10 Hz data records.
    */
   for (uint32_t i = 0; i < 8UL; i++)
   {
       uint32_t address =
           blackbox_session_start_address +
           BLACKBOX_RECORD_SIZE +
           (i * BLACKBOX_RECORD_SIZE);
       union
       {
           BlackBoxRecord_t data;
           BlackBoxEventRecord_t event;
           uint8_t raw[BLACKBOX_RECORD_SIZE];
       } record;
       FLASH_ReadData(
           address,
           record.raw,
           sizeof(record.raw)
       );
       /*
        * The common header occupies the same offsets in DATA and EVENT
        * records. Stop at the first unwritten/corrupt/non-session slot.
        */
       if (
           record.data.magic != BLACKBOX_MAGIC ||
           record.data.version != BLACKBOX_VERSION ||
           record.data.session_number != blackbox_session_number
       )
       {
           break;
       }
       if (
           record.data.record_type ==
           BLACKBOX_RECORD_DATA
       )
       {
           uint16_t record_crc =
               BLACKBOX_CRC16(
                   record.raw,
                   BLACKBOX_RECORD_SIZE - 2U
               );
           length = snprintf(
               line,
               sizeof(line),
               "BBDBG,TYPE=DATA,SESSION=%lu,SEQ=%lu,TIME=%lu,"
               "BATMV=%lu,PRESSPA=%ld,TEMPC100=%d,A1FT10=%ld,VSFT10S=%ld,"
               "GPSFIX=%u,SATS=%u,I1AX=%d,I2AX=%d,"
               "HIGXMG=%ld,HIGYMG=%ld,HIGZMG=%ld,STATE=%s,BT=%u,CRC=%s\r\n",
               (unsigned long)record.data.session_number,
               (unsigned long)record.data.record_sequence,
               (unsigned long)record.data.timestamp_ms,
               (unsigned long)record.data.battery_mv,
               (long)record.data.baro_pressure_pa,
               (int)record.data.baro_temp_c100,
               (long)record.data.baro_alt_ft10,
               (long)record.data.vertical_speed_ft10s,
               (unsigned int)record.data.gps_fix_type,
               (unsigned int)record.data.gps_sats,
               (int)record.data.imu1_ax_g1000,
               (int)record.data.imu2_ax_g1000,
               (long)record.data.highg_x_mg,
               (long)record.data.highg_y_mg,
               (long)record.data.highg_z_mg,
               FlightLogic_StateName((FlightState_t)record.data.reserved[0]),
               (unsigned int)((record.data.status_flags >> 7) & 0x01U),
               (record_crc == record.data.crc16) ? "OK" : "FAIL"
           );
       }
       else if (
           record.event.record_type ==
           BLACKBOX_RECORD_EVENT
       )
       {
           uint16_t event_crc =
               BLACKBOX_CRC16(
                   record.raw,
                   BLACKBOX_RECORD_SIZE - 2U
               );
           length = snprintf(
               line,
               sizeof(line),
               "BBDBG,TYPE=EVENT,SESSION=%lu,SEQ=%lu,EVENT_TIME_MS=%lu,"
               "EVENT=%s,STATE=%s,BT=%u,ARM=%u,FIRE_HIGH=%u,"
               "REFERENCE_TIME_MS=%lu,DETECT_TO_OUTPUT_MS=%lu,FLAGS=%08lX,"
               "A1FT10=%ld,VSFT10S=%ld,RAWVSFT10S=%ld,MAINALTFT=%u,MAINTRIG=%u,"
               "AMG=%lu,GYROMAG=%lu,GPSSPD=%lu,CRC=%s\r\n",
               (unsigned long)record.event.session_number,
               (unsigned long)record.event.record_sequence,
               (unsigned long)record.event.timestamp_ms,
               (char *)&record.event.reserved[26],
               (char *)&record.event.reserved[10],
               (unsigned int)record.event.baro_trusted,
               (unsigned int)record.event.reserved[0],
               (unsigned int)record.event.reserved[1],
               (unsigned long)(
                   ((uint32_t)record.event.reserved[2]) |
                   ((uint32_t)record.event.reserved[3] << 8) |
                   ((uint32_t)record.event.reserved[4] << 16) |
                   ((uint32_t)record.event.reserved[5] << 24)
               ),
               (unsigned long)(
                   ((uint32_t)record.event.reserved[6]) |
                   ((uint32_t)record.event.reserved[7] << 8) |
                   ((uint32_t)record.event.reserved[8] << 16) |
                   ((uint32_t)record.event.reserved[9] << 24)
               ),
               (unsigned long)record.event.event_flags,
               (long)record.event.baro_alt_ft10,
               (long)record.event.vertical_speed_ft10s,
               (long)(
                   ((uint32_t)record.event.reserved[46]) |
                   ((uint32_t)record.event.reserved[47] << 8) |
                   ((uint32_t)record.event.reserved[48] << 16) |
                   ((uint32_t)record.event.reserved[49] << 24)
               ),
               (unsigned int)(
                   ((uint16_t)record.event.reserved[50]) |
                   ((uint16_t)record.event.reserved[51] << 8)
               ),
               (unsigned int)record.event.reserved[52],
               (unsigned long)record.event.accel_mag_mg,
               (unsigned long)record.event.gyro_mag_dps10,
               (unsigned long)record.event.gps_speed_3d_mmps,
               (event_crc == record.event.crc16) ? "OK" : "FAIL"
           );
       }
       else
       {
           continue;
       }
       if (length > 0)
       {
           HAL_UART_Transmit(
               &huart1,
               (uint8_t *)line,
               (uint16_t)length,
               200
           );
       }
   }
}
