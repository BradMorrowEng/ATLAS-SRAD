static void LORA_Select(void)
{
   HAL_GPIO_WritePin(LORA_CS_PORT, LORA_CS_PIN, GPIO_PIN_RESET);
}
static void LORA_Unselect(void)
{
   HAL_GPIO_WritePin(LORA_CS_PORT, LORA_CS_PIN, GPIO_PIN_SET);
}
static uint8_t LORA_ReadReg(uint8_t addr)
{
   uint8_t tx[2] = {addr & 0x7F, 0x00};
   uint8_t rx[2] = {0};
   LORA_Select();
   HAL_SPI_TransmitReceive(&hspi1, tx, rx, 2, 100);
   LORA_Unselect();
   return rx[1];
}
static void LORA_WriteReg(uint8_t addr, uint8_t value)
{
   uint8_t tx[2] = {addr | 0x80, value};
   LORA_Select();
   HAL_SPI_Transmit(&hspi1, tx, 2, 100);
   LORA_Unselect();
}
static void LORA_WriteFIFO(uint8_t value)
{
   LORA_WriteReg(REG_FIFO, value);
}
static void LORA_SetFrequency(uint32_t frequency_hz)
{
   uint64_t frf = (((uint64_t)frequency_hz << 19) + 16000000ULL) / 32000000ULL;
   LORA_WriteReg(REG_FRF_MSB, (uint8_t)(frf >> 16));
   LORA_WriteReg(REG_FRF_MID, (uint8_t)(frf >> 8));
   LORA_WriteReg(REG_FRF_LSB, (uint8_t)frf);
}
static uint32_t LORA_ReadFrequency(void)
{
   uint32_t frf =
       ((uint32_t)LORA_ReadReg(REG_FRF_MSB) << 16) |
       ((uint32_t)LORA_ReadReg(REG_FRF_MID) << 8) |
       ((uint32_t)LORA_ReadReg(REG_FRF_LSB));
   uint64_t frequency_hz = ((uint64_t)frf * 32000000ULL) >> 19;
   return (uint32_t)frequency_hz;
}
static uint8_t LORA_Init(void)
{
   HAL_Delay(50);
   if (LORA_ReadReg(REG_VERSION) != 0x12)
   {
       return 0;
   }
   LORA_WriteReg(REG_OP_MODE, MODE_LONG_RANGE_MODE | MODE_SLEEP);
   HAL_Delay(10);
   LORA_WriteReg(REG_FIFO_TX_BASE_ADDR, 0x00);
   LORA_WriteReg(REG_FIFO_RX_BASE_ADDR, 0x00);
   LORA_SetFrequency(current_lora_frequency_hz);
   actual_lora_frequency_hz = LORA_ReadFrequency();
   LORA_WriteReg(REG_PA_CONFIG, 0x8F);
   LORA_WriteReg(REG_OCP, 0x2B);
   LORA_WriteReg(REG_LNA, 0x23);
   LORA_WriteReg(REG_MODEM_CONFIG_1, 0x72);
   LORA_WriteReg(REG_MODEM_CONFIG_2, 0x74);
   LORA_WriteReg(REG_MODEM_CONFIG_3, 0x04);
   LORA_WriteReg(REG_PREAMBLE_MSB, 0x00);
   LORA_WriteReg(REG_PREAMBLE_LSB, 0x08);
   LORA_WriteReg(REG_SYNC_WORD, 0x12);
   LORA_WriteReg(REG_PA_DAC, 0x84);
   LORA_WriteReg(REG_IRQ_FLAGS, 0xFF);
   LORA_Standby();
   return 1;
}
static void LORA_Sleep(void)
{
   LORA_WriteReg(
       REG_OP_MODE,
       MODE_LONG_RANGE_MODE | MODE_SLEEP
   );
}
static void LORA_Standby(void)
{
   LORA_WriteReg(REG_OP_MODE, MODE_LONG_RANGE_MODE | MODE_STDBY);
}
static void LORA_RxContinuous(void)
{
   LORA_Standby();
   LORA_WriteReg(REG_DIO_MAPPING_1, 0x00);
   LORA_WriteReg(REG_IRQ_FLAGS, 0xFF);
   LORA_WriteReg(REG_OP_MODE, MODE_LONG_RANGE_MODE | MODE_RX_CONTINUOUS);
}
static uint8_t LORA_Send(uint8_t *data, uint8_t len, uint32_t timeout_ms)
{
   uint32_t start_ms = HAL_GetTick();
   LORA_Standby();
   LORA_WriteReg(REG_DIO_MAPPING_1, 0x40);
   LORA_WriteReg(REG_IRQ_FLAGS, 0xFF);
   LORA_WriteReg(REG_FIFO_ADDR_PTR, 0x00);
   for (uint8_t i = 0; i < len; i++)
   {
       LORA_WriteFIFO(data[i]);
   }
   LORA_WriteReg(REG_PAYLOAD_LENGTH, len);
   LORA_WriteReg(REG_OP_MODE, MODE_LONG_RANGE_MODE | MODE_TX);
   while ((HAL_GetTick() - start_ms) < timeout_ms)
   {
       FlightOutputs_Service(HAL_GetTick());
       uint8_t irq = LORA_ReadReg(REG_IRQ_FLAGS);
       if (irq & IRQ_TX_DONE_MASK)
       {
           LORA_WriteReg(REG_IRQ_FLAGS, IRQ_TX_DONE_MASK);
           LORA_Standby();
           return 1;
       }
   }
   LORA_Standby();
   return 0;
}
static uint8_t LORA_ReadPacket(uint8_t *buf, uint8_t max_len)
{
   uint8_t irq = LORA_ReadReg(REG_IRQ_FLAGS);
   if (!(irq & IRQ_RX_DONE_MASK))
   {
       return 0;
   }
   LORA_WriteReg(REG_IRQ_FLAGS, 0xFF);
   if (irq & IRQ_PAYLOAD_CRC_ERROR)
   {
       return 0;
   }
   uint8_t len = LORA_ReadReg(REG_RX_NB_BYTES);
   uint8_t current_addr = LORA_ReadReg(REG_FIFO_RX_CURRENT_ADDR);
   if (len > max_len)
   {
       len = max_len;
   }
   LORA_WriteReg(REG_FIFO_ADDR_PTR, current_addr);
   for (uint8_t i = 0; i < len; i++)
   {
       buf[i] = LORA_ReadReg(REG_FIFO);
   }
   return len;
}
static void LORA_ServiceRx(void)
{
   uint8_t buffer[80];
   uint8_t len = LORA_ReadPacket(buffer, sizeof(buffer) - 1);
   if (len == 0)
   {
       return;
   }
   buffer[len] = '\0';
   /*
    * Lightweight health query is safe even after launch. It avoids making
    * the already-near-maximum AT1 telemetry packet longer.
    */
   if (strcmp((char *)buffer, "CMD,HEALTH") == 0)
   {
       char health[96];
       snprintf(
           health,
           sizeof(health),
           "HEALTH,BB=%s,SD=%s,MAINALTFT=%lu,STATE=%s",
           blackbox_ok ? "OK" : "FAIL",
           sdlog_ok ? "OK" : "FAIL",
           (unsigned long)flight_main_deploy_alt_ft,
           FlightLogic_StateName(flight_state)
       );
       LORA_Send(
           (uint8_t *)health,
           (uint8_t)strlen(health),
           1000
       );
       LORA_RxContinuous();
       return;
   }
   /*
    * Once launch is latched, maintenance commands are ignored.
    *
    * FLASHINFO scans the flash, FLASHCLEAR can block for a long erase, and
    * frequency changes intentionally contain delays. None of those operations
    * belong in the active-flight path.
    */
   if (
       flight_launch_detected &&
       strncmp((char *)buffer, "CMD,", 4) == 0
   )
   {
       LORA_RxContinuous();
       return;
   }
   /*
    * Main deployment altitude configuration.
    *
    * Accepted only before launch because the generic post-launch CMD gate
    * above rejects every maintenance/configuration command once launch is
    * latched.
    *
    * Command example:
    *   CMD,MAINALTFT=1500
    *
    * Altitude is AGL relative to the launch-pad barometric baseline.
    */
   if (strncmp((char *)buffer, "CMD,MAINALTFT=", 14) == 0)
   {
       char *end_ptr = NULL;
       unsigned long requested_main_alt_ft =
           strtoul(
               (char *)buffer + 14,
               &end_ptr,
               10
           );
       if (
           end_ptr != ((char *)buffer + 14) &&
           *end_ptr == '\0' &&
           requested_main_alt_ft >=
               FLIGHT_MAIN_DEPLOY_MIN_ALT_FT &&
           requested_main_alt_ft <=
               FLIGHT_MAIN_DEPLOY_MAX_ALT_FT
       )
       {
           flight_main_deploy_alt_ft =
               (uint32_t)requested_main_alt_ft;
           char ack[48];
           snprintf(
               ack,
               sizeof(ack),
               "MAINALTACK=%lu",
               (unsigned long)flight_main_deploy_alt_ft
           );
           LORA_Send(
               (uint8_t *)ack,
               (uint8_t)strlen(ack),
               1000
           );
           LORA_RxContinuous();
           /*
            * Store every accepted change in both onboard event logs.
            * The formatted trace name is MAIN_ALT_xxxxFT, so the selected
            * value remains obvious during post-flight review.
            */
           FlightLogic_LogEvent(
               FLIGHT_EVENT_MAIN_ALTITUDE_SET,
               HAL_GetTick()
           );
           return;
       }
       char nak[64];
       snprintf(
           nak,
           sizeof(nak),
           "MAINALTNAK,MIN=%lu,MAX=%lu",
           (unsigned long)FLIGHT_MAIN_DEPLOY_MIN_ALT_FT,
           (unsigned long)FLIGHT_MAIN_DEPLOY_MAX_ALT_FT
       );
       LORA_Send(
           (uint8_t *)nak,
           (uint8_t)strlen(nak),
           1000
       );
       LORA_RxContinuous();
       return;
   }
   if (
       strcmp(
           (char *)buffer,
           "CMD,FLASHINFO"
       ) == 0
   )
   {
       uint32_t used_bytes = FLASH_FindUsedBytes();
       uint32_t total_bytes =
           BLACKBOX_END_ADDR - BLACKBOX_START_ADDR;
       char info[96];
       snprintf(
           info,
           sizeof(info),
           "FLASHINFO,USED=%lu,TOTAL=%lu",
           (unsigned long)used_bytes,
           (unsigned long)total_bytes
       );
       LORA_Send(
           (uint8_t *)info,
           (uint8_t)strlen(info),
           1000
       );
       LORA_RxContinuous();
       return;
   }
   /*
    * Explicit competition black-box erase command.
    *
    * The long confirmation token is intentional so random/corrupt packets
    * cannot accidentally trigger a destructive erase.
    */
   if (
       strcmp(
           (char *)buffer,
           "CMD,FLASHCLEAR,CONFIRM=ERASE_W25Q128"
       ) == 0
   )
   {
       const char started[] = "FLASHCLEAR_STARTED";
       /*
        * Acknowledge BEFORE starting the long erase operation.
        */
       LORA_Send(
           (uint8_t *)started,
           (uint8_t)strlen(started),
           1000
       );
       /* FLASHCLEAR is pre-launch only. Force the proven safe state once. */
       FlightOutputs_Safe();
       uint8_t erase_ok = FLASH_ChipErase();
       uint8_t verify_ok = 0;
       if (erase_ok)
       {
           const char verify_started[] =
               "FLASHVERIFY_STARTED";
           LORA_Send(
               (uint8_t *)verify_started,
               (uint8_t)strlen(verify_started),
               1000
           );
           LORA_RxContinuous();
           verify_ok =
               FLASH_VerifyErasedSamples();
       }
       /*
        * IMPORTANT:
        * Do not let the current boot immediately start filling the freshly
        * erased black box again. Disable W25 logging until the NEXT power-up.
        *
        * On the next boot BLACKBOX_Init() will see an empty chip and the new
        * flight session will begin at 0x000000.
        */
       blackbox_ok = 0;
       blackbox_next_address = BLACKBOX_START_ADDR;
       blackbox_session_start_address = BLACKBOX_START_ADDR;
       blackbox_session_number = 0;
       blackbox_record_sequence = 0;
       if (erase_ok && verify_ok)
       {
           const char ok[] = "FLASHCLEAR_OK,BYTES=16777216,VERIFY=FULL";
           LORA_Send(
               (uint8_t *)ok,
               (uint8_t)strlen(ok),
               1000
           );
       }
       else
       {
           const char failed[] = "FLASHCLEAR_FAIL,VERIFY=FAIL";
           LORA_Send(
               (uint8_t *)failed,
               (uint8_t)strlen(failed),
               1000
           );
       }
       LORA_RxContinuous();
       return;
   }
   if (strncmp((char *)buffer, "CMD,FREQ=", 9) == 0)
   {
       uint32_t requested_frequency_hz =
           strtoul((char *)buffer + 9, NULL, 10);
       if (requested_frequency_hz >= 902300000UL &&
           requested_frequency_hz <= 927500000UL)
       {
           const char frequency_ack[] = "FREQACK";
           /*
            * IMPORTANT:
            * Send the ACK several times on the OLD frequency before
            * changing channels. If the GS misses one ACK, it still has
            * more chances to receive confirmation and switch with us.
            *
            * This prevents the exact failure mode where ATLAS V2 changes
            * frequency but ATLAS V1 reports NO_ACK and stays behind.
            */
           for (uint8_t ack_try = 0; ack_try < 4; ack_try++)
           {
               LORA_Send(
                   (uint8_t *)frequency_ack,
                   (uint8_t)strlen(frequency_ack),
                   1000
               );
               HAL_Delay(80);
           }
           /*
            * Leave enough time for ATLAS V1 to receive an ACK,
            * report the change to the ESP32, and prepare to retune.
            */
           HAL_Delay(500);
           LORA_Standby();
           LORA_SetFrequency(requested_frequency_hz);
           current_lora_frequency_hz = requested_frequency_hz;
           actual_lora_frequency_hz = LORA_ReadFrequency();
           LORA_RxContinuous();
           return;
       }
   }
   LORA_RxContinuous();
}
static void SPI3_SetModeIMU(void)
{
   /*
    * LSM6 devices are currently operated in SPI mode 3:
    * CPOL = 1, CPHA = 1.
    */
   __HAL_SPI_DISABLE(&hspi3);
   SET_BIT(hspi3.Instance->CR1, SPI_CR1_CPOL | SPI_CR1_CPHA);
   __HAL_SPI_ENABLE(&hspi3);
}
static void SPI3_SetModeADXL372(void)
{
   /*
    * ADXL372 requires SPI mode 0:
    * CPOL = 0, CPHA = 0.
    */
   __HAL_SPI_DISABLE(&hspi3);
   CLEAR_BIT(hspi3.Instance->CR1, SPI_CR1_CPOL | SPI_CR1_CPHA);
   __HAL_SPI_ENABLE(&hspi3);
}
static void ADXL372_Select(void)
{
   IMU_AllUnselect();
   SPI3_SetModeADXL372();
   HAL_GPIO_WritePin(ACCEL_CS_PORT, ACCEL_CS_PIN, GPIO_PIN_RESET);
}
static void ADXL372_Unselect(void)
{
   HAL_GPIO_WritePin(ACCEL_CS_PORT, ACCEL_CS_PIN, GPIO_PIN_SET);
   /*
    * Return SPI3 to the mode used by both LSM6 IMUs so an ADXL372
    * transaction can never leave the bus in the wrong mode.
    */
   SPI3_SetModeIMU();
}
static uint8_t ADXL372_ReadReg(uint8_t reg)
{
   uint8_t tx[2] =
   {
       ADXL372_REG_READ(reg),
       0x00
   };
   uint8_t rx[2] = {0};
   ADXL372_Select();
   HAL_StatusTypeDef status =
       HAL_SPI_TransmitReceive(
           &hspi3,
           tx,
           rx,
           2,
           100
       );
   ADXL372_Unselect();
   if (status != HAL_OK)
   {
       return 0xFF;
   }
   return rx[1];
}
static void ADXL372_WriteReg(uint8_t reg, uint8_t value)
{
   uint8_t tx[2] =
   {
       ADXL372_REG_WRITE(reg),
       value
   };
   ADXL372_Select();
   HAL_SPI_Transmit(
       &hspi3,
       tx,
       2,
       100
   );
   ADXL372_Unselect();
}
static uint8_t ADXL372_ReadRegs(
   uint8_t start_reg,
   uint8_t *data,
   uint8_t len
)
{
   if (!data || len == 0)
   {
       return 0;
   }
   uint8_t command =
       ADXL372_REG_READ(start_reg);
   ADXL372_Select();
   HAL_StatusTypeDef tx_status =
       HAL_SPI_Transmit(
           &hspi3,
           &command,
           1,
           100
       );
   HAL_StatusTypeDef rx_status = HAL_ERROR;
   if (tx_status == HAL_OK)
   {
       rx_status =
           HAL_SPI_Receive(
               &hspi3,
               data,
               len,
               100
           );
   }
   ADXL372_Unselect();
   if (tx_status != HAL_OK || rx_status != HAL_OK)
   {
       memset(data, 0, len);
       return 0;
   }
   return 1;
}
static int16_t ADXL372_Unpack12(
   uint8_t high_byte,
   uint8_t low_byte
)
{
   /*
    * ADXL372 output is a signed 12-bit two's-complement value:
    * high byte = bits 11:4
    * low byte bits 7:4 = bits 3:0
    */
   int16_t value =
       (int16_t)(
           ((uint16_t)high_byte << 4) |
           ((uint16_t)low_byte >> 4)
       );
   if (value & 0x0800)
   {
       value |= (int16_t)0xF000;
   }
   return value;
}
static uint8_t ADXL372_Init(void)
{
   /*
    * The ADXL372 is on SPI3 with PC13 as CS.
    * Device IDs expected:
    *   DEVID_AD  = 0xAD
    *   DEVID_MST = 0x1D
    *   PARTID    = 0xFA
    */
   HAL_GPIO_WritePin(ACCEL_CS_PORT, ACCEL_CS_PIN, GPIO_PIN_SET);
   HAL_Delay(10);
   uint8_t devid_ad =
       ADXL372_ReadReg(ADXL372_DEVID_AD);
   uint8_t devid_mst =
       ADXL372_ReadReg(ADXL372_DEVID_MST);
   uint8_t partid =
       ADXL372_ReadReg(ADXL372_PARTID);
   if (
       devid_ad != ADXL372_DEVID_AD_VALUE ||
       devid_mst != ADXL372_DEVID_MST_VALUE ||
       partid != ADXL372_PARTID_VALUE
   )
   {
       return 0;
   }
   /*
    * Software reset, then configure:
    *   ODR       = 3200 Hz
    *   bandwidth = 1600 Hz
    *   settle    = 16 ms
    *   mode      = full-bandwidth measurement
    */
   ADXL372_WriteReg(
       ADXL372_RESET,
       ADXL372_RESET_CODE
   );
   HAL_Delay(10);
   /* Confirm the device still identifies correctly after reset. */
   if (
       ADXL372_ReadReg(ADXL372_DEVID_AD) != ADXL372_DEVID_AD_VALUE ||
       ADXL372_ReadReg(ADXL372_DEVID_MST) != ADXL372_DEVID_MST_VALUE ||
       ADXL372_ReadReg(ADXL372_PARTID) != ADXL372_PARTID_VALUE
   )
   {
       return 0;
   }
   ADXL372_WriteReg(
       ADXL372_TIMING,
       ADXL372_TIMING_3200HZ
   );
   ADXL372_WriteReg(
       ADXL372_MEASURE,
       ADXL372_MEASURE_1600HZ_BW
   );
   ADXL372_WriteReg(
       ADXL372_POWER_CTL,
       ADXL372_POWER_FULL_BW
   );
   /* 16 ms filter-settle setting before valid full-bandwidth data. */
   HAL_Delay(20);
   return 1;
}
static uint8_t ADXL372_ReadAccelMg(
   int32_t *x_mg,
   int32_t *y_mg,
   int32_t *z_mg
)
{
   if (!x_mg || !y_mg || !z_mg)
   {
       return 0;
   }
   uint8_t data[6] = {0};
   /*
    * Always burst-read X/Y/Z together so all three axes are from
    * the same concurrent sample set.
    */
   if (
       !ADXL372_ReadRegs(
           ADXL372_XDATA_H,
           data,
           sizeof(data)
       )
   )
   {
       return 0;
   }
   int16_t x_raw =
       ADXL372_Unpack12(
           data[0],
           data[1]
       );
   int16_t y_raw =
       ADXL372_Unpack12(
           data[2],
           data[3]
       );
   int16_t z_raw =
       ADXL372_Unpack12(
           data[4],
           data[5]
       );
   *x_mg =
       (int32_t)x_raw *
       ADXL372_MG_PER_LSB;
   *y_mg =
       (int32_t)y_raw *
       ADXL372_MG_PER_LSB;
   *z_mg =
       (int32_t)z_raw *
       ADXL372_MG_PER_LSB;
   return 1;
}
static void IMU_AllUnselect(void)
{
   HAL_GPIO_WritePin(IMU1_CS_PORT, IMU1_CS_PIN, GPIO_PIN_SET);
   HAL_GPIO_WritePin(IMU2_CS_PORT, IMU2_CS_PIN, GPIO_PIN_SET);
   HAL_GPIO_WritePin(ACCEL_CS_PORT, ACCEL_CS_PIN, GPIO_PIN_SET);
}
static uint8_t IMU_ReadReg(GPIO_TypeDef *cs_port, uint16_t cs_pin, uint8_t reg)
{
