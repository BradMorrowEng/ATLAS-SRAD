static uint8_t BLACKBOX_Init(void)
{
   /*
    * Scan the append region without erasing anything.
    *
    * - The first completely erased 128-byte slot becomes the next write address.
    * - Valid VERSION 3 session-header records are used to recover the
    *   highest previous session number.
    * - Old VERSION 1 data records are simply treated as occupied space.
    * - A partially written/corrupt occupied record is skipped, not overwritten.
    */
   uint8_t raw[BLACKBOX_RECORD_SIZE];
   uint32_t highest_session = 0;
   /* Default unless a valid prior MAIN_ALTITUDE_SET event is recovered. */
   flight_main_deploy_alt_ft = FLIGHT_MAIN_DEPLOY_DEFAULT_ALT_FT;
   blackbox_next_address = BLACKBOX_END_ADDR;
   for (
       uint32_t address = BLACKBOX_START_ADDR;
       address + BLACKBOX_RECORD_SIZE <= BLACKBOX_END_ADDR;
       address += BLACKBOX_RECORD_SIZE
   )
   {
       FLASH_ReadData(
           address,
           raw,
           sizeof(raw)
       );
       uint8_t empty = 1;
       for (uint16_t i = 0; i < sizeof(raw); i++)
       {
           if (raw[i] != 0xFF)
           {
               empty = 0;
               break;
           }
       }
       if (empty)
       {
           blackbox_next_address = address;
           break;
       }
       uint32_t magic =
           ((uint32_t)raw[0]) |
           ((uint32_t)raw[1] << 8) |
           ((uint32_t)raw[2] << 16) |
           ((uint32_t)raw[3] << 24);
       if (
           magic == BLACKBOX_MAGIC &&
           raw[4] == BLACKBOX_VERSION &&
           raw[5] == BLACKBOX_RECORD_SESSION
       )
       {
           uint16_t stored_crc =
               (uint16_t)raw[126] |
               ((uint16_t)raw[127] << 8);
           uint16_t calculated_crc =
               BLACKBOX_CRC16(
                   raw,
                   BLACKBOX_RECORD_SIZE - 2U
               );
           if (stored_crc == calculated_crc)
           {
               uint32_t session_number =
                   ((uint32_t)raw[12]) |
                   ((uint32_t)raw[13] << 8) |
                   ((uint32_t)raw[14] << 16) |
                   ((uint32_t)raw[15] << 24);
               if (session_number > highest_session)
               {
                   highest_session = session_number;
               }
           }
       }
       else if (
           magic == BLACKBOX_MAGIC &&
           raw[4] == BLACKBOX_VERSION &&
           raw[5] == BLACKBOX_RECORD_EVENT
       )
       {
           BlackBoxEventRecord_t event_record;
           memcpy(&event_record, raw, sizeof(event_record));
           uint16_t calculated_crc =
               BLACKBOX_CRC16(
                   raw,
                   BLACKBOX_RECORD_SIZE - 2U
               );
           if (
               calculated_crc == event_record.crc16 &&
               event_record.event_id ==
                   FLIGHT_EVENT_MAIN_ALTITUDE_SET
           )
           {
               uint16_t stored_main_alt_ft = 0;
               memcpy(
                   &stored_main_alt_ft,
                   &event_record.reserved[50],
                   sizeof(stored_main_alt_ft)
               );
               if (
                   stored_main_alt_ft >=
                       FLIGHT_MAIN_DEPLOY_MIN_ALT_FT &&
                   stored_main_alt_ft <=
                       FLIGHT_MAIN_DEPLOY_MAX_ALT_FT
               )
               {
                   /* Records are scanned in append order, so the last valid
                    * setting encountered is the setting from the latest boot.
                    */
                   flight_main_deploy_alt_ft =
                       stored_main_alt_ft;
               }
           }
       }
   }
   if (blackbox_next_address >= BLACKBOX_END_ADDR)
   {
       return 0;
   }
   blackbox_session_number = highest_session + 1UL;
   blackbox_record_sequence = 0;
   return 1;
}
static uint8_t BLACKBOX_StartSession(void)
{
   BlackBoxSessionRecord_t record;
   memset(
       &record,
       0,
       sizeof(record)
   );
   record.magic = BLACKBOX_MAGIC;
   record.version = BLACKBOX_VERSION;
   record.record_type = BLACKBOX_RECORD_SESSION;
   record.timestamp_ms = HAL_GetTick();
   record.session_number = blackbox_session_number;
   /*
    * Session-header records do not consume a data-record sequence number.
    * 0xFFFFFFFF makes that explicit in the stored file.
    */
   record.record_sequence = 0xFFFFFFFFUL;
   record.startup_battery_mv = Battery_ReadMillivolts();
   /*
    * Baro_SetBaseline() has already completed before the black-box
    * session is created. If no live service sample has populated
    * baro_pressure_pa yet, use the valid baseline pressure instead of 0.
    */
   record.startup_pressure_pa =
       (baro_pressure_pa != 0) ? baro_pressure_pa : baro_base_pa;
   record.startup_baro_base_pa = baro_base_pa;
   record.startup_temp_c100 = (int16_t)baro_temp_c100;
   record.lora_frequency_hz = actual_lora_frequency_hz;
   record.gps_present = gps.present;
   record.gps_fix_ok = gps.fix_ok;
   record.gps_fix_type = gps.fix_type;
   record.gps_sats = gps.sats;
   record.imu1_ok = imu1_ok;
   record.imu2_ok = imu2_ok;
   record.highg_ok = highg_ok;
   record.mag_ok = 0;
   /*
    * Basic startup status flags:
    * bit 0 = barometer OK
    * bit 1 = GPS present
    * bit 2 = GPS fix valid
    * bit 3 = IMU1 OK
    * bit 4 = IMU2 OK
    * bit 5 = LoRa OK
    * bit 6 = ADXL372 high-G OK
    */
   if (baro_ok)
   {
       record.status_flags |= (1U << 0);
   }
   if (gps.present)
   {
       record.status_flags |= (1U << 1);
   }
   if (gps.fix_ok)
   {
       record.status_flags |= (1U << 2);
   }
   if (imu1_ok)
   {
       record.status_flags |= (1U << 3);
   }
   if (imu2_ok)
   {
       record.status_flags |= (1U << 4);
   }
   if (lora_ok)
   {
       record.status_flags |= (1U << 5);
   }
   if (highg_ok)
   {
       record.status_flags |= (1U << 6);
   }
   blackbox_session_start_address = blackbox_next_address;
   if (!BLACKBOX_WriteSessionRecord(&record))
   {
       return 0;
   }
   blackbox_record_sequence = 0;
   return 1;
}
