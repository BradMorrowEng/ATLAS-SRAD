        "CMD,FLASHCLEAR,CONFIRM=ERASE_W25Q128";

    uint8_t sent = LORA_Send(
        (uint8_t *)command,
        (uint8_t)strlen(command),
        1000
    );
    LORA_RxContinuous();
    return sent;
}

static uint8_t GS_SendFrequencyCommand(
    uint32_t frequency_hz
)
{
    char command[48];

    snprintf(
        command,
        sizeof(command),
        "CMD,FREQ=%lu",
        (unsigned long)frequency_hz
    );

    uint8_t sent = LORA_Send(
        (uint8_t *)command,
        strlen(command),
        1000
    );
    /* Listen before any blocking UART status output. */
    LORA_RxContinuous();
    return sent;
}

static uint8_t GS_WaitForFrequencyAck(
    uint32_t timeout_ms
)
{
    uint8_t buffer[64];
    uint32_t start_time = HAL_GetTick();

    /* GS_SendFrequencyCommand already enabled RX. Restarting RX here
     * clears IRQ flags and could discard an ACK received during UART output.
     */

    while (
        (HAL_GetTick() - start_time) <
        timeout_ms
    )
    {
        uint8_t length =
            LORA_ReadPacket(
                buffer,
                sizeof(buffer) - 1
            );

        if (length > 0)
        {
            buffer[length] = '\0';

            if (
                strcmp(
                    (char *)buffer,
                    "FREQACK"
                ) == 0
            )
            {
                LORA_Standby();
                return 1;
            }
        }
    }

    LORA_Standby();

    return 0;
}

static void LORA_SetFrequency(uint32_t frequency_hz)
{
    uint64_t frf;

    frf = (((uint64_t)frequency_hz << 19) + 16000000ULL)
          / 32000000ULL;

    LORA_WriteReg(REG_FRF_MSB, (uint8_t)(frf >> 16));
    LORA_WriteReg(REG_FRF_MID, (uint8_t)(frf >> 8));
    LORA_WriteReg(REG_FRF_LSB, (uint8_t)frf);
}

static void LORA_Standby(void)
{
    LORA_WriteReg(REG_OP_MODE, MODE_LONG_RANGE_MODE | MODE_STDBY);
}

static void LORA_RxContinuous(void)
{
    LORA_Standby();
    LORA_WriteReg(REG_DIO_MAPPING_1, 0x00);
    LORA_WriteReg(REG_IRQ_FLAGS, 0xFF);
    LORA_WriteReg(REG_OP_MODE, MODE_LONG_RANGE_MODE | MODE_RX_CONTINUOUS);
}

static uint8_t LORA_Send(uint8_t *data, uint8_t len, uint32_t timeout_ms)
{
    uint32_t start = HAL_GetTick();

    LORA_Standby();
    LORA_WriteReg(REG_DIO_MAPPING_1, 0x40);
    LORA_WriteReg(REG_IRQ_FLAGS, 0xFF);
    LORA_WriteReg(REG_FIFO_ADDR_PTR, 0x00);

    for (uint8_t i = 0; i < len; i++)
    {
        LORA_WriteFIFO(data[i]);
    }

    LORA_WriteReg(REG_PAYLOAD_LENGTH, len);
    LORA_WriteReg(REG_OP_MODE, MODE_LONG_RANGE_MODE | MODE_TX);

    while ((HAL_GetTick() - start) < timeout_ms)
    {
        uint8_t irq = LORA_ReadReg(REG_IRQ_FLAGS);

        if (irq & IRQ_TX_DONE_MASK)
        {
            LORA_WriteReg(REG_IRQ_FLAGS, IRQ_TX_DONE_MASK);
            LORA_Standby();
            return 1;
        }
    }

    LORA_Standby();
    return 0;
}

static uint8_t LORA_ReadPacket(uint8_t *buf, uint8_t max_len)
{
    uint8_t irq = LORA_ReadReg(REG_IRQ_FLAGS);

    if (!(irq & IRQ_RX_DONE_MASK))
    {
        return 0;
    }

    LORA_WriteReg(REG_IRQ_FLAGS, 0xFF);

    if (irq & IRQ_PAYLOAD_CRC_ERROR)
    {
        return 0;
    }

    uint8_t len = LORA_ReadReg(REG_RX_NB_BYTES);
    uint8_t current_addr = LORA_ReadReg(REG_FIFO_RX_CURRENT_ADDR);

    int8_t raw_snr =
        (int8_t)LORA_ReadReg(REG_PKT_SNR_VALUE);

    last_lora_snr =
        ((float)raw_snr) / 4.0f;

    uint8_t raw_rssi =
        LORA_ReadReg(REG_PKT_RSSI_VALUE);

    last_lora_rssi =
        -157 + raw_rssi;
    if (len > max_len)
    {
        len = max_len;
    }

    LORA_WriteReg(REG_FIFO_ADDR_PTR, current_addr);

    for (uint8_t i = 0; i < len; i++)
    {
        buf[i] = LORA_ReadReg(REG_FIFO);
    }

    return len;
}

static void LORA_Reset(void)
{
    /* V2 reference uses no MCU-driven radio reset pin. */
    HAL_Delay(50);
}

static void LORA_Select(void)
{
    HAL_GPIO_WritePin(LORA_CS_PORT, LORA_CS_PIN, GPIO_PIN_RESET);
}

static void LORA_Unselect(void)
{
    HAL_GPIO_WritePin(LORA_CS_PORT, LORA_CS_PIN, GPIO_PIN_SET);
}

static uint8_t LORA_ReadReg(uint8_t addr)
{
    uint8_t tx[2] = {addr & 0x7F, 0x00};
    uint8_t rx[2] = {0};

    LORA_Select();
    HAL_SPI_TransmitReceive(&hspi1, tx, rx, 2, 100);
    LORA_Unselect();

    return rx[1];
}

static void LORA_WriteReg(uint8_t addr, uint8_t value)
{
    uint8_t tx[2] = {addr | 0x80, value};

    LORA_Select();
    HAL_SPI_Transmit(&hspi1, tx, 2, 100);
    LORA_Unselect();
}

static void LORA_WriteFIFO(uint8_t value)
{
    LORA_WriteReg(REG_FIFO, value);
}

static void LED_Blink(GPIO_TypeDef *port, uint16_t pin, uint8_t times, uint16_t delay_ms)
{
    for (uint8_t i = 0; i < times; i++)
    {
        HAL_GPIO_WritePin(port, pin, GPIO_PIN_SET);
        HAL_Delay(delay_ms);
        HAL_GPIO_WritePin(port, pin, GPIO_PIN_RESET);
        HAL_Delay(delay_ms);
    }
}
/*
 * Find the next unused ground-station log file.
 *
 * Every ground-station power-up gets its own file:
 *
 *   GS0001.CSV
 *   GS0002.CSV
 *   GS0003.CSV
 *   ...
 *
 * Existing files are never overwritten.
 */
static uint8_t AT2_SD_FindNextFile(
    char *filename,
    size_t filename_size
)
{
    if (!filename || filename_size < 11U)
    {
        return 0;
    }

    DIR directory;
    FILINFO info;

    FRESULT result =
        f_opendir(
            &directory,
            USERPath
        );

    if (result != FR_OK)
    {
        return 0;
    }

    uint32_t highest = 0;

    while (1)
    {
        result =
            f_readdir(
                &directory,
                &info
            );

        if (result != FR_OK)
        {
            f_closedir(&directory);
            return 0;
        }

        if (info.fname[0] == '\0')
        {
            break;
        }

        /*
         * Accept only:
         * GS0001.CSV through GS9999.CSV
         */
        if (
            strlen(info.fname) == 10U &&
            info.fname[0] == 'G' &&
            info.fname[1] == 'S' &&
            info.fname[6] == '.' &&
            info.fname[7] == 'C' &&
            info.fname[8] == 'S' &&
            info.fname[9] == 'V'
        )
        {
            uint32_t number = 0;
            uint8_t valid = 1;

            for (uint8_t i = 2; i <= 5; i++)
            {
                if (
                    info.fname[i] < '0' ||
                    info.fname[i] > '9'
                )
                {
                    valid = 0;
                    break;
                }

                number =
                    (number * 10UL) +
                    (uint32_t)(
                        info.fname[i] - '0'
                    );
            }

            if (
                valid &&
                number > highest
            )
            {
                highest = number;
            }
        }
    }

    f_closedir(&directory);

    if (highest >= 9999UL)
    {
        return 0;
    }

    uint32_t next_number =
        highest + 1UL;

    snprintf(
        filename,
        filename_size,
        "GS%04lu.CSV",
        (unsigned long)next_number
    );

    return 1;
}

static void AT2_SD_Init(void)
{
    FRESULT res;
    UINT bw = 0;

    at2_sd_ok = 0;
    at2_sd_lines = 0;
    at2_sd_fail = 0;

    res =
        f_mount(
            &USERFatFS,
            (TCHAR const *)USERPath,
            1
        );

    if (res != FR_OK)
    {
        at2_sd_fail++;
        return;
    }

    char filename[16];

    if (
        !AT2_SD_FindNextFile(
            filename,
            sizeof(filename)
        )
    )
    {
        at2_sd_fail++;
        return;
    }

    /*
     * FA_CREATE_NEW is intentional.
     * Even if the file scan somehow fails/races,
     * an existing ground-station log can never be overwritten.
     */
    res =
        f_open(
            &at2_log_file,
            filename,
            FA_CREATE_NEW | FA_WRITE
        );

    if (res != FR_OK)
    {
        at2_sd_fail++;
        return;
    }

    const char *header =
        "ms,raw_radio_packet,esp32_line\r\n";

    res =
        f_write(
            &at2_log_file,
            header,
            strlen(header),
            &bw
        );

    if (
        res != FR_OK ||
        bw != strlen(header)
    )
    {
        at2_sd_fail++;
        f_close(&at2_log_file);
        return;
    }

    /*
     * Commit the new file + header immediately.
     */
    if (f_sync(&at2_log_file) != FR_OK)
    {
        at2_sd_fail++;
        f_close(&at2_log_file);
        return;
    }

    at2_sd_ok = 1;
}

static void AT2_SD_WriteQuoted(const char *s)
{
    UINT bw = 0;

    f_write(&at2_log_file, "\"", 1, &bw);

    while (*s)
    {
        if (*s == '"')
        {
            f_write(&at2_log_file, "\"\"", 2, &bw);
        }
        else
        {
            f_write(&at2_log_file, s, 1, &bw);
        }

        s++;
    }

    f_write(&at2_log_file, "\"", 1, &bw);
}

static void AT2_SD_LogPacket(const char *raw, const char *esp_line)
{
    if (!at2_sd_ok)
    {
        return;
    }

    FRESULT res;
    UINT bw = 0;
    char start[32];

    snprintf(start, sizeof(start), "%lu,", (unsigned long)HAL_GetTick());

    res = f_write(&at2_log_file, start, strlen(start), &bw);

    if (res != FR_OK)
    {
        at2_sd_ok = 0;
        at2_sd_fail++;
        return;
    }

    AT2_SD_WriteQuoted(raw);

    res = f_write(&at2_log_file, ",", 1, &bw);

    if (res != FR_OK)
    {
        at2_sd_ok = 0;
        at2_sd_fail++;
        return;
    }

    AT2_SD_WriteQuoted(esp_line);

    res = f_write(&at2_log_file, "\r\n", 2, &bw);

    if (res != FR_OK)
    {
        at2_sd_ok = 0;
        at2_sd_fail++;
        return;
    }

    at2_sd_lines++;

    f_sync(&at2_log_file);
}
