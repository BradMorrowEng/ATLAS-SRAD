int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_SPI3_Init();
    MX_UART4_Init();
    MX_SDIO_SD_Init();
    MX_FATFS_Init();
    AT2_SD_Init();
    MX_GPIO_Init();
    GS_BatteryADC_Init();
    MX_SPI3_Init();

    HAL_GPIO_WritePin(LORA_CS_PORT, LORA_CS_PIN, GPIO_PIN_SET);
    HAL_GPIO_WritePin(LORA_RST_PORT, LORA_RST_PIN, GPIO_PIN_SET);

    LED_Blink(LED1_PORT, LED1_PIN, 5, 80);

    uint8_t lora_ok = LORA_Init();

    if (!lora_ok)
    {
        while (1)
        {
            LED_Blink(LED2_PORT, LED2_PIN, 3, 120);
            HAL_Delay(500);
        }
    }

    ESP_SendLine("DATA,PKT=0,A1FT=---,A2FT=---,AX=---,AY=---,AZ=---,GX=---,GY=---,GZ=---");

    LORA_RxContinuous();

    uint8_t rx_buf[256];
    char raw[256];
    char esp_line[400];

    uint32_t last_gs_battery_send = 0;
    char gs_battery_value[16];
    char gs_battery_line[40];

    while (1)
    {
    	ESP_ReadCommands();
        GS_ServiceMainAltitudeCommand();

        if ((HAL_GetTick() - last_gs_battery_send) >= 1000)
        {
            last_gs_battery_send = HAL_GetTick();

            GS_FormatBatteryVoltage(
                gs_battery_value,
                sizeof(gs_battery_value)
            );

            snprintf(
                gs_battery_line,
                sizeof(gs_battery_line),
                "GS,GSBATV=%s",
                gs_battery_value
            );

            ESP_SendLine(gs_battery_line);
        }

        uint8_t len = LORA_ReadPacket(
            rx_buf,
            sizeof(rx_buf) - 1
        );

        if (len > 0)
        {
            rx_buf[len] = 0;

            strncpy(
                raw,
                (char *)rx_buf,
                sizeof(raw) - 1
            );

            raw[sizeof(raw) - 1] = 0;

            if (strncmp(raw, "FLASHINFO,", 10) == 0)
            {
                char info_line[128];

                snprintf(
                    info_line,
                    sizeof(info_line),
                    "GS,%s",
                    raw
                );

                ESP_SendLine(info_line);
                LORA_RxContinuous();
                continue;
            }

            if (strcmp(raw, "FLASHCLEAR_PROGRESS") == 0)
            {
                flash_clear_pending = 1;
                GS_SendFlashStatus("CLEARING");
                LORA_RxContinuous();
                continue;
            }

            if (strcmp(raw, "FLASHVERIFY_STARTED") == 0)
            {
                flash_clear_pending = 1;
                GS_SendFlashStatus("VERIFYING");
                LORA_RxContinuous();
                continue;
            }

            if (strcmp(raw, "FLASHVERIFY_PROGRESS") == 0)
            {
                flash_clear_pending = 1;
                GS_SendFlashStatus("VERIFYING");
                LORA_RxContinuous();
                continue;
            }

            if (strncmp(raw, "FLASHCLEAR_STARTED", 18) == 0)
            {
                flash_clear_pending = 1;
                strncpy(
                    flash_status,
                    "CLEARING",
                    sizeof(flash_status) - 1
                );
                flash_status[sizeof(flash_status) - 1] = '\0';

                GS_SendFlashStatus("CLEARING");
                LORA_RxContinuous();
                continue;
            }

            if (strncmp(raw, "FLASHCLEAR_OK", 13) == 0)
            {
                flash_clear_pending = 0;
                strncpy(
                    flash_status,
                    "EMPTY",
                    sizeof(flash_status) - 1
                );
                flash_status[sizeof(flash_status) - 1] = '\0';

                /*
                 * Forward the full proof line from ATLAS V2 to ESP32.
                 */
                char proof_line[128];

                snprintf(
                    proof_line,
                    sizeof(proof_line),
                    "GS,FLASHSTATUS=EMPTY,%s",
                    raw + 14
                );

                ESP_SendLine(proof_line);
                LORA_RxContinuous();
                continue;
            }

            if (strncmp(raw, "FLASHCLEAR_FAIL", 15) == 0)
            {
                flash_clear_pending = 0;
                strncpy(
                    flash_status,
                    "FAILED",
                    sizeof(flash_status) - 1
                );
                flash_status[sizeof(flash_status) - 1] = '\0';

                ESP_SendLine(
                    "GS,FLASHSTATUS=FAILED,VERIFY=FAIL"
                );

                LORA_RxContinuous();
                continue;
            }

            if (strncmp(raw, "HEALTH,", 7) == 0)
            {
                /*
                 * HEALTH is safe to request at any time and gives the GS the
                 * active onboard MAIN altitude, including a value restored
                 * from ATLAS V2 flash after a power cycle.
                 */
                char main_alt_text[16];

                GetValue(
                    raw,
                    "MAINALTFT",
                    main_alt_text,
                    sizeof(main_alt_text)
                );

                if (main_alt_text[0] != '-' &&
                    main_alt_text[0] != '\0')
                {
                    uint32_t reported_main_altitude_ft =
                        strtoul(main_alt_text, NULL, 10);

                    if (GS_MainAltitudeAllowed(reported_main_altitude_ft))
                    {
                        current_main_altitude_ft =
                            reported_main_altitude_ft;
                    }
                }

                char health_line[160];

                snprintf(
                    health_line,
                    sizeof(health_line),
                    "GS,%s",
                    raw
                );

                ESP_SendLine(health_line);
                LORA_RxContinuous();
                continue;
            }

            if (strncmp(raw, "MAINALTACK=", 11) == 0)
            {
                char *end_ptr = NULL;

                uint32_t confirmed_altitude_ft =
                    strtoul(
                        raw + 11,
                        &end_ptr,
                        10
                    );

                if (
                    end_ptr != (raw + 11) &&
                    *end_ptr == '\0' &&
                    GS_MainAltitudeAllowed(confirmed_altitude_ft)
                )
                {
                    current_main_altitude_ft =
                        confirmed_altitude_ft;

                    main_altitude_change_pending = 0;
                    main_altitude_command_ms = 0;

                    GS_SendMainAltitudeStatus(
                        "CHANGED",
                        current_main_altitude_ft
                    );
                }
                else
                {
                    main_altitude_change_pending = 0;
                    main_altitude_command_ms = 0;

                    GS_SendMainAltitudeStatus(
                        "BAD_ACK",
                        current_main_altitude_ft
                    );
                }

                LORA_RxContinuous();
                continue;
            }

            if (strncmp(raw, "MAINALTNAK", 10) == 0)
            {
                main_altitude_change_pending = 0;
                main_altitude_command_ms = 0;

                GS_SendMainAltitudeStatus(
                    "REJECTED",
                    current_main_altitude_ft
                );

                LORA_RxContinuous();
                continue;
            }

            if (strncmp(raw, "AT1,", 4) == 0)
            {
                MakeDataLine(
                    raw,
                    esp_line,
                    sizeof(esp_line)
                );

                if (frequency_change_pending)
                {
                    uint32_t new_frequency_hz =
                        pending_lora_frequency_hz;

                    if (
                        GS_SendFrequencyCommand(
                            new_frequency_hz
                        )
                    )
                    {
                        GS_SendFrequencyStatus(
                            "COMMAND_SENT",
                            new_frequency_hz
                        );

                        if (
                        	GS_WaitForFrequencyAck(3000)
                        )
                        {
                            /*
                             * The onboard radio confirmed
                             * the command on the old frequency.
                             */
                            LORA_Standby();

                            LORA_SetFrequency(
                                new_frequency_hz
                            );

                            current_lora_frequency_hz =
                                new_frequency_hz;

                            pending_lora_frequency_hz = 0;
                            frequency_change_pending = 0;

                            GS_SendFrequencyStatus(
                                "CHANGED",
                                current_lora_frequency_hz
                            );
                        }
                        else
                        {
                            GS_SendFrequencyStatus(
                                "NO_ACK",
                                current_lora_frequency_hz
                            );

                            pending_lora_frequency_hz = 0;
                            frequency_change_pending = 0;

                            LORA_RxContinuous();
                        }
                    }
                    else
                    {
                        GS_SendFrequencyStatus(
                            "SEND_FAILED",
                            current_lora_frequency_hz
                        );

                        pending_lora_frequency_hz = 0;
                        frequency_change_pending = 0;

                        LORA_RxContinuous();
                    }
                }
                else
                {
                    char ack[40];
                    char pkt[20];

                    GetValue(
                        raw,
                        "PKT",
                        pkt,
                        sizeof(pkt)
                    );

                    snprintf(
                        ack,
                        sizeof(ack),
                        "ACK,PKT=%s",
                        pkt
                    );

                    LORA_Send(
                        (uint8_t *)ack,
                        strlen(ack),
                        1000
                    );
                }

                ESP_SendLine(esp_line);

                LED_Blink(
                    LED2_PORT,
                    LED2_PIN,
                    2,
                    60
                );

                HAL_GPIO_TogglePin(
                    LED1_PORT,
                    LED1_PIN
                );

                AT2_SD_LogPacket(
                    raw,
                    esp_line
                );
            }

            LORA_RxContinuous();
        }
    }
}

static void GS_BatteryADC_Init(void)
{
    /*
     * Enable ADC1 clock.
     */
    __HAL_RCC_ADC1_CLK_ENABLE();

    /*
     * ADC clock = PCLK2 divided by 4.
     */
    ADC->CCR &= ~(3UL << 16);
    ADC->CCR |=  (1UL << 16);

    /*
     * Reset ADC1 settings.
     */
    ADC1->CR1 = 0;
    ADC1->CR2 = 0;

    /*
     * One regular conversion.
     */
    ADC1->SQR1 = 0;

    /*
     * PC2 is ADC channel 12.
     */
    ADC1->SQR3 = 12;

    /*
     * Channel 12 sampling time = 480 cycles.
     */
    ADC1->SMPR1 &= ~(7UL << 6);
    ADC1->SMPR1 |=  (7UL << 6);

    /*
     * Turn ADC1 on.
     */
    ADC1->CR2 |= ADC_CR2_ADON;

    HAL_Delay(2);
}

static uint16_t GS_BatteryADC_ReadRaw(void)
{
    uint32_t start_time = HAL_GetTick();

    /*
     * Clear old ADC status flags.
     */
    ADC1->SR = 0;

    /*
     * Start one ADC conversion.
     */
    ADC1->CR2 |= ADC_CR2_SWSTART;

    /*
     * Wait for the conversion to finish.
     */
    while ((ADC1->SR & ADC_SR_EOC) == 0)
    {
        if ((HAL_GetTick() - start_time) > 10)
        {
            return 0;
        }
    }

    /*
     * Reading DR clears the EOC flag.
     */
    return (uint16_t)ADC1->DR;
}

static uint32_t GS_ReadBatteryMillivolts(void)
{
    uint32_t raw_sum = 0;

    for (uint32_t i = 0; i < GS_BAT_ADC_SAMPLES; i++)
    {
        raw_sum += GS_BatteryADC_ReadRaw();
    }

    uint32_t average_raw =
        raw_sum / GS_BAT_ADC_SAMPLES;

    uint64_t battery_millivolts =
        (uint64_t)average_raw *
        GS_BAT_ADC_REFERENCE_MV *
        (GS_BAT_R_TOP_OHMS + GS_BAT_R_BOTTOM_OHMS);

    battery_millivolts /=
        (uint64_t)GS_BAT_ADC_MAX_COUNT *
        GS_BAT_R_BOTTOM_OHMS;

    return (uint32_t)battery_millivolts;
}

static void GS_FormatBatteryVoltage(char *out, uint16_t out_size)
{
    uint32_t battery_millivolts =
        GS_ReadBatteryMillivolts();

    uint32_t whole_volts =
        battery_millivolts / 1000UL;

    uint32_t hundredths =
        (battery_millivolts % 1000UL) / 10UL;

    snprintf(
        out,
        out_size,
        "%lu.%02lu",
        (unsigned long)whole_volts,
        (unsigned long)hundredths
    );
}

static void MakeDataLine(char *raw, char *out, uint16_t out_size)
{
    char pkt[20];
    char a1ft[20];
    char descfts[20];
    char mach[16];
    char ax[20];
    char ay[20];
    char az[20];
    char gx[20];
    char gy[20];
    char gz[20];
    char i1[12];
    char i2[12];
    char gps_status[12];
    char gps_fix[12];
    char sats[12];
    char lat[24];
    char lon[24];
    char gps_age[20];
    char gps_alt_ft[20];
    char gps_vs_fts[20];
    char radio_frequency_hz[20];

    char onboard_battery[16];
    char gs_battery[16];

    GetValue(raw, "PKT", pkt, sizeof(pkt));
    GetValue(raw, "A1FT", a1ft, sizeof(a1ft));
    GetValue(raw, "DESCFTS", descfts, sizeof(descfts));
    GetValue(raw, "MACH", mach, sizeof(mach));
    GetValue(raw, "AX", ax, sizeof(ax));
    GetValue(raw, "AY", ay, sizeof(ay));
    GetValue(raw, "AZ", az, sizeof(az));
    GetValue(raw, "GX", gx, sizeof(gx));
    GetValue(raw, "GY", gy, sizeof(gy));
    GetValue(raw, "GZ", gz, sizeof(gz));
    GetValue(raw, "I1", i1, sizeof(i1));
    GetValue(raw, "I2", i2, sizeof(i2));
    GetValue(raw, "GPS", gps_status, sizeof(gps_status));
    GetValue(raw, "FIX", gps_fix, sizeof(gps_fix));
    GetValue(raw, "SATS", sats, sizeof(sats));
    GetValue(raw, "LAT", lat, sizeof(lat));
    GetValue(raw, "LON", lon, sizeof(lon));
    GetValue(raw, "GPSAGE", gps_age, sizeof(gps_age));
    GetValue(raw, "GPSALTFT", gps_alt_ft, sizeof(gps_alt_ft));
    GetValue(raw, "GPSVSFTS", gps_vs_fts, sizeof(gps_vs_fts));

    GetValue(
        raw,
        "RFHZ",
        radio_frequency_hz,
        sizeof(radio_frequency_hz)
    );

    GetValue(
        raw,
        "BATV",
        onboard_battery,
        sizeof(onboard_battery)
    );

    GS_FormatBatteryVoltage(
        gs_battery,
        sizeof(gs_battery)
    );

    snprintf(
        out,
        out_size,
        "DATA,PKT=%s,A1FT=%s,A2FT=0.0,DESCFTS=%s,MACH=%s,"
        "AX=%s,AY=%s,AZ=%s,"
        "GX=%s,GY=%s,GZ=%s,"
        "I1=%s,I2=%s,GPS=%s,FIX=%s,SATS=%s,"
        "LAT=%s,LON=%s,GPSAGE=%s,GPSALTFT=%s,GPSVSFTS=%s,"
        "RFHZ=%s,BATV=%s,GSBATV=%s,"
        "RSSI=%d,SNR=%d.%02d",
        pkt,
        a1ft,
        descfts,
        mach,
        ax,
        ay,
        az,
        gx,
        gy,
        gz,
        i1,
        i2,
        gps_status,
        gps_fix,
        sats,
        lat,
        lon,
        gps_age,
        gps_alt_ft,
        gps_vs_fts,
        radio_frequency_hz,
        onboard_battery,
        gs_battery,
        last_lora_rssi,
        (int)last_lora_snr,
        abs((int)(last_lora_snr * 100.0f) % 100)
    );
}

static void GetValue(char *line, const char *key, char *out, uint16_t out_size)
{
    char search[24];

    snprintf(search, sizeof(search), "%s=", key);

    char *start = strstr(line, search);

    if (start == NULL)
    {
        strncpy(out, "---", out_size);
        out[out_size - 1] = 0;
        return;
    }

    start += strlen(search);

    char *end = strchr(start, ',');

    uint16_t len = 0;

    if (end == NULL)
    {
        len = strlen(start);
    }
    else
    {
        len = end - start;
    }

    if (len >= out_size)
    {
        len = out_size - 1;
    }

    memcpy(out, start, len);
    out[len] = 0;
}

static void ESP_SendLine(const char *line)
{
    HAL_UART_Transmit(&huart4, (uint8_t *)line, strlen(line), 100);
    HAL_UART_Transmit(&huart4, (uint8_t *)"\r\n", 2, 100);
}

static uint8_t LORA_Init(void)
{
    LORA_Reset();

    if (LORA_ReadReg(REG_VERSION) != 0x12)
    {
        return 0;
    }

    LORA_WriteReg(REG_OP_MODE, MODE_LONG_RANGE_MODE | MODE_SLEEP);
    HAL_Delay(10);

    LORA_WriteReg(REG_FIFO_TX_BASE_ADDR, 0x00);
    LORA_WriteReg(REG_FIFO_RX_BASE_ADDR, 0x00);

    LORA_SetFrequency(current_lora_frequency_hz);

    LORA_WriteReg(REG_PA_CONFIG, 0x8F);
    LORA_WriteReg(REG_OCP, 0x2B);
    LORA_WriteReg(REG_LNA, 0x23);

    LORA_WriteReg(REG_MODEM_CONFIG_1, 0x72);
    LORA_WriteReg(REG_MODEM_CONFIG_2, 0x74);
    LORA_WriteReg(REG_MODEM_CONFIG_3, 0x04);

    LORA_WriteReg(REG_PREAMBLE_MSB, 0x00);
    LORA_WriteReg(REG_PREAMBLE_LSB, 0x08);

    LORA_WriteReg(REG_SYNC_WORD, 0x12);
    LORA_WriteReg(REG_PA_DAC, 0x84);
    LORA_WriteReg(REG_IRQ_FLAGS, 0xFF);

    LORA_Standby();

    return 1;
}

static uint8_t GS_FrequencyAllowed(uint32_t frequency_hz)
{
    if (
        frequency_hz >= 902300000UL &&
        frequency_hz <= 927500000UL
    )
    {
        return 1;
    }

    return 0;
}

static void GS_SendFrequencyStatus(
    const char *status,
    uint32_t frequency_hz
)
{
    char line[80];

    uint32_t whole_mhz =
        frequency_hz / 1000000UL;

    uint32_t decimal_mhz =
        (frequency_hz % 1000000UL) / 100000UL;

    snprintf(
        line,
        sizeof(line),
        "GS,FREQ=%lu.%01lu,FREQSTATUS=%s",
        (unsigned long)whole_mhz,
        (unsigned long)decimal_mhz,
        status
    );

    ESP_SendLine(line);
}

static void ESP_ReadCommands(void)
{
    uint8_t received_character;

    while (
        HAL_UART_Receive(
            &huart4,
            &received_character,
            1,
            1
        ) == HAL_OK
    )
    {
        if (
            received_character == '\n' ||
            received_character == '\r'
        )
        {
            if (esp_rx_index > 0)
            {
                esp_rx_line[esp_rx_index] = '\0';

                ESP_HandleCommand(esp_rx_line);

                esp_rx_index = 0;
            }
        }
        else
        {
            if (
                esp_rx_index <
                sizeof(esp_rx_line) - 1
            )
            {
                esp_rx_line[esp_rx_index++] =
                    (char)received_character;
            }
            else
            {
                esp_rx_index = 0;
            }
        }
    }
}

static void ESP_HandleCommand(const char *command)
{
    if (strcmp(command, "FLASHINFO") == 0)
    {
        const char query[] = "CMD,FLASHINFO";

        if (!LORA_Send(
            (uint8_t *)query,
            (uint8_t)strlen(query),
            1000
        ))
        {
            ESP_SendLine(
                "GS,FLASHINFOSTATUS=SEND_FAILED"
            );
        }

        LORA_RxContinuous();
        return;
    }

    /*
     * Destructive W25Q128 erase command.
     * Require the exact confirmation token from the ESP32 UI.
     */
    if (
        strcmp(
            command,
            "CLEARFLASH,CONFIRM=ERASE_W25Q128"
        ) == 0
    )
    {
        if (flash_clear_pending)
        {
            GS_SendFlashStatus("CLEARING");
            return;
        }

        if (GS_SendFlashClearCommand())
        {
            flash_clear_pending = 1;

            strncpy(
                flash_status,
                "COMMAND_SENT",
                sizeof(flash_status) - 1
            );
            flash_status[sizeof(flash_status) - 1] = '\0';

            GS_SendFlashStatus("COMMAND_SENT");

            LORA_RxContinuous();
        }
        else
        {
            flash_clear_pending = 0;

            strncpy(
                flash_status,
                "SEND_FAILED",
                sizeof(flash_status) - 1
            );
            flash_status[sizeof(flash_status) - 1] = '\0';

            GS_SendFlashStatus("SEND_FAILED");

            LORA_RxContinuous();
        }

        return;
    }

    if (strcmp(command, "HEALTH") == 0)
    {
        if (!GS_SendHealthQuery())
        {
            GS_SendMainAltitudeStatus(
                "HEALTH_SEND_FAILED",
                current_main_altitude_ft
            );
        }

        LORA_RxContinuous();
        return;
    }

    if (strncmp(command, "SETMAINALT,", 11) == 0)
    {
        char *end_ptr = NULL;

        uint32_t requested_main_altitude_ft =
            strtoul(
                command + 11,
                &end_ptr,
                10
            );

        if (
            end_ptr == (command + 11) ||
            *end_ptr != '\0' ||
            !GS_MainAltitudeAllowed(requested_main_altitude_ft)
        )
        {
            GS_SendMainAltitudeStatus(
                "INVALID",
                current_main_altitude_ft
            );

            return;
        }

        if (main_altitude_change_pending)
        {
            GS_SendMainAltitudeStatus(
                "BUSY",
                current_main_altitude_ft
            );

            return;
        }

        if (
            current_main_altitude_ft != 0 &&
            requested_main_altitude_ft ==
                current_main_altitude_ft
        )
        {
            GS_SendMainAltitudeStatus(
                "ALREADY_SET",
                current_main_altitude_ft
            );

            return;
        }

        if (
            GS_SendMainAltitudeCommand(
                requested_main_altitude_ft
            )
        )
        {
            main_altitude_change_pending = 1;
            main_altitude_command_ms = HAL_GetTick();

            GS_SendMainAltitudeStatus(
                "COMMAND_SENT",
                current_main_altitude_ft
            );

            LORA_RxContinuous();
        }
        else
        {
            main_altitude_change_pending = 0;
            main_altitude_command_ms = 0;

            GS_SendMainAltitudeStatus(
                "SEND_FAILED",
                current_main_altitude_ft
            );

            LORA_RxContinuous();
        }

        return;
    }

    if (strncmp(command, "SETFREQ,", 8) != 0)
    {
        return;
    }

    uint32_t requested_frequency_hz =
        strtoul(
            command + 8,
            NULL,
            10
        );

    if (!GS_FrequencyAllowed(requested_frequency_hz))
    {
        GS_SendFrequencyStatus(
            "INVALID",
            current_lora_frequency_hz
        );

        return;
    }

    if (
        requested_frequency_hz ==
        current_lora_frequency_hz
    )
    {
        GS_SendFrequencyStatus(
            "ALREADY_SET",
            current_lora_frequency_hz
        );

        return;
    }

    /*
     * Send the frequency command IMMEDIATELY.
     *
     * Older code queued the request and waited for the next AT1 telemetry
     * packet before sending CMD,FREQ. That made frequency changes depend on
     * normal telemetry timing and could fail after a long flash erase.
     *
     * Frequency changing is now independent of telemetry packets.
     */
    pending_lora_frequency_hz =
        requested_frequency_hz;

    frequency_change_pending = 0;

    if (
        GS_SendFrequencyCommand(
            requested_frequency_hz
        )
    )
    {
        GS_SendFrequencyStatus(
            "COMMAND_SENT",
            requested_frequency_hz
        );

        if (
            GS_WaitForFrequencyAck(3000)
        )
        {
            /*
             * ATLAS V2 acknowledged on the OLD frequency.
             * Now retune ATLAS V1 to the requested frequency.
             */
            LORA_Standby();

            LORA_SetFrequency(
                requested_frequency_hz
            );

            current_lora_frequency_hz =
                requested_frequency_hz;

            pending_lora_frequency_hz = 0;

            GS_SendFrequencyStatus(
                "CHANGED",
                current_lora_frequency_hz
            );

            LORA_RxContinuous();
        }
        else
        {
            /*
             * Do NOT retune if V2 never acknowledged.
             * Stay on the current frequency so the link is preserved.
             */
            pending_lora_frequency_hz = 0;

            GS_SendFrequencyStatus(
                "NO_ACK",
                current_lora_frequency_hz
            );

            LORA_RxContinuous();
        }
    }
    else
    {
        pending_lora_frequency_hz = 0;

        GS_SendFrequencyStatus(
            "SEND_FAILED",
            current_lora_frequency_hz
        );

        LORA_RxContinuous();
    }
}

static uint8_t GS_MainAltitudeAllowed(
    uint32_t altitude_ft
)
{
    return (
        altitude_ft >= MAIN_ALTITUDE_MIN_FT &&
        altitude_ft <= MAIN_ALTITUDE_MAX_FT
    );
}

static void GS_SendMainAltitudeStatus(
    const char *status,
    uint32_t altitude_ft
)
{
    char line[96];

    if (altitude_ft != 0)
    {
        snprintf(
            line,
            sizeof(line),
            "GS,MAINALTFT=%lu,MAINALTSTATUS=%s",
            (unsigned long)altitude_ft,
            status
        );
    }
    else
    {
        snprintf(
            line,
            sizeof(line),
            "GS,MAINALTFT=UNKNOWN,MAINALTSTATUS=%s",
            status
        );
    }

    ESP_SendLine(line);
