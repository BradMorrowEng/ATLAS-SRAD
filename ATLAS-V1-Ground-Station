static uint8_t GSGPS_SendUBX(uint8_t msg_class, uint8_t msg_id,
                          const uint8_t *payload, uint16_t payload_len)
{
   if (payload_len > 80)
   {
       return 0;
   }
   uint8_t frame[88];
   uint16_t index = 0;
   uint8_t ck_a = 0;
   uint8_t ck_b = 0;
   frame[index++] = 0xB5;
   frame[index++] = 0x62;
   frame[index++] = msg_class;
   frame[index++] = msg_id;
   frame[index++] = (uint8_t)(payload_len & 0xFF);
   frame[index++] = (uint8_t)(payload_len >> 8);
   for (uint16_t i = 2; i < index; i++)
   {
       ck_a = (uint8_t)(ck_a + frame[i]);
       ck_b = (uint8_t)(ck_b + ck_a);
   }
   for (uint16_t i = 0; i < payload_len; i++)
   {
       frame[index++] = payload[i];
       ck_a = (uint8_t)(ck_a + payload[i]);
       ck_b = (uint8_t)(ck_b + ck_a);
   }
   frame[index++] = ck_a;
   frame[index++] = ck_b;
   return HAL_I2C_Master_Transmit(&hi2c1,
                                   GSGPS_I2C_ADDRESS,
                                   frame,
                                   index,
                                   100) == HAL_OK;
}
static void GSGPS_PutU4LE(uint8_t *p, uint32_t value)
{
   p[0] = (uint8_t)(value & 0xFF);
   p[1] = (uint8_t)((value >> 8) & 0xFF);
   p[2] = (uint8_t)((value >> 16) & 0xFF);
   p[3] = (uint8_t)((value >> 24) & 0xFF);
}
static void GSGPS_PutU2LE(uint8_t *p, uint16_t value)
{
   p[0] = (uint8_t)(value & 0xFF);
   p[1] = (uint8_t)(value >> 8);
}
static uint8_t GSGPS_Configure(void)
{
   uint8_t payload[64] = {0};
   uint16_t i = 0;
   payload[i++] = 0x00;
   payload[i++] = 0x01;
   payload[i++] = 0x00;
   payload[i++] = 0x00;
   GSGPS_PutU4LE(&payload[i], GSGPS_CFG_I2C_ENABLED);
   i += 4;
   payload[i++] = 1;
   GSGPS_PutU4LE(&payload[i], GSGPS_CFG_I2CINPROT_UBX);
   i += 4;
   payload[i++] = 1;
   GSGPS_PutU4LE(&payload[i], GSGPS_CFG_I2COUTPROT_UBX);
   i += 4;
   payload[i++] = 1;
   GSGPS_PutU4LE(&payload[i], GSGPS_CFG_I2COUTPROT_NMEA);
   i += 4;
   payload[i++] = 0;
   GSGPS_PutU4LE(&payload[i], GSGPS_CFG_MSGOUT_NAV_PVT_I2C);
   i += 4;
   payload[i++] = 1;
   GSGPS_PutU4LE(&payload[i], GSGPS_CFG_RATE_MEAS);
   i += 4;
   GSGPS_PutU2LE(&payload[i], 250);
   i += 2;
   GSGPS_PutU4LE(&payload[i], GSGPS_CFG_RATE_NAV);
   i += 4;
   GSGPS_PutU2LE(&payload[i], 1);
   i += 2;
   GSGPS_PutU4LE(&payload[i], GSGPS_CFG_NAVSPG_DYNMODEL);
   i += 4;
   payload[i++] = GSGPS_DYNMODEL_AIRBORNE_4G;
   if (!GSGPS_SendUBX(0x06, 0x8A, payload, i))
   {
       return 0;
   }
   HAL_Delay(100);
   return 1;
}
static uint8_t GSGPS_Init(void)
{
   if (HAL_I2C_IsDeviceReady(&hi2c1,
                             GSGPS_I2C_ADDRESS,
                             3,
                             100) != HAL_OK)
   {
       gs_gps.present = 0;
       gs_gps.configured = 0;
       gs_gps.fix_ok = 0;
       return 0;
   }
   gs_gps.present = 1;
   gs_gps.configured = GSGPS_Configure();
   gs_gps.fix_ok = 0;
   memset(&gs_gps_parser, 0, sizeof(gs_gps_parser));
   return 1;
}
static void GSGPS_PollNavPvt(void)
{
   if (!gs_gps.present)
   {
       return;
   }
   GSGPS_SendUBX(0x01, 0x07, NULL, 0);
}
static int32_t GSGPS_ReadI4LE(const uint8_t *p)
{
   uint32_t value =
       ((uint32_t)p[0]) |
       ((uint32_t)p[1] << 8) |
       ((uint32_t)p[2] << 16) |
       ((uint32_t)p[3] << 24);
   return (int32_t)value;
}
static void GSGPS_HandleMessage(uint8_t msg_class, uint8_t msg_id,
                             const uint8_t *payload, uint16_t payload_len)
{
   if (msg_class != 0x01 || msg_id != 0x07 || payload_len != 92)
   {
       return;
   }
   gs_gps.present = 1;
   gs_gps.last_message_ms = HAL_GetTick();
   gs_gps.fix_type = payload[20];
   gs_gps.sats = payload[23];
   uint8_t flags = payload[21];
   uint8_t flags3_lsb = payload[78];
   uint8_t invalid_llh = flags3_lsb & 0x01;
   gs_gps.fix_ok =
       ((flags & 0x01) != 0) &&
       (gs_gps.fix_type >= 2) &&
       (gs_gps.fix_type <= 4) &&
       !invalid_llh;
   if (gs_gps.fix_ok)
   {
       gs_gps.lon_e7 = GSGPS_ReadI4LE(&payload[24]);
       gs_gps.lat_e7 = GSGPS_ReadI4LE(&payload[28]);
       gs_gps.hmsl_mm = GSGPS_ReadI4LE(&payload[36]);
       gs_gps.hacc_mm = (uint32_t)GSGPS_ReadI4LE(&payload[40]);
       gs_gps.vacc_mm = (uint32_t)GSGPS_ReadI4LE(&payload[44]);
       gs_gps.sacc_mmps = (uint32_t)GSGPS_ReadI4LE(&payload[68]);
       gs_gps.itow_ms = (uint32_t)GSGPS_ReadI4LE(&payload[0]);
       int32_t vel_n_mmps =
           GSGPS_ReadI4LE(&payload[48]);
       int32_t vel_e_mmps =
           GSGPS_ReadI4LE(&payload[52]);
       gs_gps.vel_d_mmps =
           GSGPS_ReadI4LE(&payload[56]);
       gs_gps.speed_3d_mmps =
           GSGPS_FlightLogic_VectorMagnitude(
               vel_n_mmps,
               vel_e_mmps,
               gs_gps.vel_d_mmps
           );
       gs_gps.last_fix_ms = gs_gps.last_message_ms;
   }
}
static void GSGPS_FeedByte(uint8_t byte)
{
   switch (gs_gps_parser.state)
   {
       case 0:
           if (byte == 0xB5)
           {
               gs_gps_parser.state = 1;
           }
           break;
       case 1:
           if (byte == 0x62)
           {
               gs_gps_parser.state = 2;
               gs_gps_parser.ck_a = 0;
               gs_gps_parser.ck_b = 0;
               gs_gps_parser.payload_index = 0;
               gs_gps_parser.overflow = 0;
           }
           else if (byte != 0xB5)
           {
               gs_gps_parser.state = 0;
           }
           break;
       case 2:
           gs_gps_parser.msg_class = byte;
           gs_gps_parser.ck_a = (uint8_t)(gs_gps_parser.ck_a + byte);
           gs_gps_parser.ck_b = (uint8_t)(gs_gps_parser.ck_b + gs_gps_parser.ck_a);
           gs_gps_parser.state = 3;
           break;
       case 3:
           gs_gps_parser.msg_id = byte;
           gs_gps_parser.ck_a = (uint8_t)(gs_gps_parser.ck_a + byte);
           gs_gps_parser.ck_b = (uint8_t)(gs_gps_parser.ck_b + gs_gps_parser.ck_a);
           gs_gps_parser.state = 4;
           break;
       case 4:
           gs_gps_parser.payload_len = byte;
           gs_gps_parser.ck_a = (uint8_t)(gs_gps_parser.ck_a + byte);
           gs_gps_parser.ck_b = (uint8_t)(gs_gps_parser.ck_b + gs_gps_parser.ck_a);
           gs_gps_parser.state = 5;
           break;
       case 5:
           gs_gps_parser.payload_len |= ((uint16_t)byte << 8);
           gs_gps_parser.ck_a = (uint8_t)(gs_gps_parser.ck_a + byte);
           gs_gps_parser.ck_b = (uint8_t)(gs_gps_parser.ck_b + gs_gps_parser.ck_a);
           gs_gps_parser.payload_index = 0;
           gs_gps_parser.overflow = gs_gps_parser.payload_len > sizeof(gs_gps_parser.payload);
           gs_gps_parser.state = (gs_gps_parser.payload_len == 0) ? 7 : 6;
           break;
       case 6:
           if (!gs_gps_parser.overflow &&
               gs_gps_parser.payload_index < sizeof(gs_gps_parser.payload))
           {
               gs_gps_parser.payload[gs_gps_parser.payload_index] = byte;
           }
           gs_gps_parser.payload_index++;
           gs_gps_parser.ck_a = (uint8_t)(gs_gps_parser.ck_a + byte);
           gs_gps_parser.ck_b = (uint8_t)(gs_gps_parser.ck_b + gs_gps_parser.ck_a);
           if (gs_gps_parser.payload_index >= gs_gps_parser.payload_len)
           {
               gs_gps_parser.state = 7;
           }
           break;
       case 7:
           gs_gps_parser.received_ck_a = byte;
           gs_gps_parser.state = 8;
           break;
       case 8:
           if (gs_gps_parser.received_ck_a == gs_gps_parser.ck_a &&
               byte == gs_gps_parser.ck_b &&
               !gs_gps_parser.overflow)
           {
               GSGPS_HandleMessage(gs_gps_parser.msg_class,
                                 gs_gps_parser.msg_id,
                                 gs_gps_parser.payload,
                                 gs_gps_parser.payload_len);
           }
           gs_gps_parser.state = 0;
           break;
       default:
           gs_gps_parser.state = 0;
           break;
   }
}
static void GSGPS_Service(void)
{
   static uint8_t fail_count = 0;
   uint8_t length_bytes[2] = {0};
   if (!gs_gps.present)
   {
       return;
   }
   if (HAL_I2C_Mem_Read(&hi2c1,
                        GSGPS_I2C_ADDRESS,
                        0xFD,
                        I2C_MEMADD_SIZE_8BIT,
                        length_bytes,
                        2,
                        30) != HAL_OK)
   {
       fail_count++;
       if (fail_count >= 5)
       {
           gs_gps.present = 0;
           gs_gps.configured = 0;
           gs_gps.fix_ok = 0;
           fail_count = 0;
       }
       return;
   }
   fail_count = 0;
   uint16_t available = ((uint16_t)length_bytes[0] << 8) | length_bytes[1];
   if (available == 0)
   {
       if (gs_gps.last_message_ms != 0 &&
           (HAL_GetTick() - gs_gps.last_message_ms) > 2000UL)
       {
           gs_gps.fix_ok = 0;
       }
       return;
   }
   if (available > 512)
   {
       available = 512;
   }
   uint8_t buffer[128];
   while (available > 0)
   {
       uint16_t chunk = available > sizeof(buffer) ? sizeof(buffer) : available;
       if (HAL_I2C_Mem_Read(&hi2c1,
                            GSGPS_I2C_ADDRESS,
                            0xFF,
                            I2C_MEMADD_SIZE_8BIT,
                            buffer,
                            chunk,
                            50) != HAL_OK)
       {
           break;
       }
       for (uint16_t i = 0; i < chunk; i++)
       {
           GSGPS_FeedByte(buffer[i]);
       }
       available -= chunk;
   }
   if (gs_gps.last_message_ms != 0 &&
       (HAL_GetTick() - gs_gps.last_message_ms) > 2000UL)
   {
       gs_gps.fix_ok = 0;
   }
}
static void GSGPS_FormatCoordE7(char *out, size_t out_size, int32_t value_e7)
{
   int64_t value = value_e7;
   const char *sign = "";
   if (value < 0)
   {
       sign = "-";
       value = -value;
   }
   snprintf(out,
            out_size,
            "%s%ld.%07ld",
            sign,
            (long)(value / 10000000LL),
            (long)(value % 10000000LL));
}
static uint32_t GSGPS_FlightLogic_VectorMagnitude(
   int32_t x,
   int32_t y,
   int32_t z
)
{
   float xf = (float)x;
   float yf = (float)y;
   float zf = (float)z;
   float magnitude =
       sqrtf(
           xf * xf +
           yf * yf +
           zf * zf
       );
   if (magnitude <= 0.0f)
   {
       return 0;
   }
   if (magnitude >= 4294967040.0f)
   {
       return 0xFFFFFFFFUL;
   }
   return (uint32_t)(magnitude + 0.5f);
}
static void MX_I2C1_Init(void)
{
   hi2c1.Instance = I2C1;
   hi2c1.Init.ClockSpeed = 200000;
   hi2c1.Init.DutyCycle = I2C_DUTYCYCLE_2;
   hi2c1.Init.OwnAddress1 = 0;
   hi2c1.Init.AddressingMode = I2C_ADDRESSINGMODE_7BIT;
   hi2c1.Init.DualAddressMode = I2C_DUALADDRESS_DISABLE;
   hi2c1.Init.OwnAddress2 = 0;
   hi2c1.Init.GeneralCallMode = I2C_GENERALCALL_DISABLE;
   hi2c1.Init.NoStretchMode = I2C_NOSTRETCH_DISABLE;
   if (HAL_I2C_Init(&hi2c1) != HAL_OK)
   {
       Error_Handler();
   }
}

static void GSGPS_Task(void)
{
    static uint32_t service_ms = 0, poll_ms = 0, retry_ms = 0, report_ms = 0;
    uint32_t now = HAL_GetTick();
    if (now - service_ms >= 50UL) {
        service_ms = now;
        GSGPS_Service();
    }
    if (gs_gps.present && now - poll_ms >= 500UL) {
        poll_ms = now;
        GSGPS_PollNavPvt();
    }
    if ((!gs_gps.present || !gs_gps.configured) && now - retry_ms >= 3000UL) {
        retry_ms = now;
        if (!gs_gps.present) GSGPS_Init();
        else gs_gps.configured = GSGPS_Configure();
    }
    now = HAL_GetTick();
    if (now - report_ms < 1000UL) return;
    report_ms = now;
    uint8_t fresh = gs_gps.last_message_ms != 0U &&
        now - gs_gps.last_message_ms <= 2000UL;
    uint8_t fix = gs_gps.present && fresh && gs_gps.fix_ok &&
        gs_gps.last_fix_ms != 0U && now - gs_gps.last_fix_ms <= 2000UL;
    char lat[20] = "---", lon[20] = "---", line[192];
    if (fix) {
        GSGPS_FormatCoordE7(lat, sizeof(lat), gs_gps.lat_e7);
        GSGPS_FormatCoordE7(lon, sizeof(lon), gs_gps.lon_e7);
    }
    snprintf(line, sizeof(line),
        "GS,GSGPS=%s,GSFIX=%u,GSSATS=%u,GSLAT=%s,GSLON=%s,GSAGE=%lu",
        !gs_gps.present ? "FAIL" : (!fresh ? "STALE" : (fix ? "FIX" : "NOFIX")),
        (unsigned int)(fix ? gs_gps.fix_type : 0U),
        (unsigned int)(fresh ? gs_gps.sats : 0U), lat, lon,
        (unsigned long)(gs_gps.last_fix_ms ? now - gs_gps.last_fix_ms : UINT32_MAX));
    ESP_SendLine(line);

    /* One local GPS diagnostic row per second, alongside AT1/ATSTAT rows.
     * Keep the existing three CSV columns and ESP wire message unchanged.
     * raw_radio_packet also holds these LOCAL records, identified by GSGPS=.
     * GSALTMM is MSL altitude, GSVDMMPS is positive down, GSSPDMMPS is 3-D.
     * HACC/VACC are receiver position accuracy estimates in mm; SACC is mm/s.
     * Missing/stale fixes use --- rather than reusing old measurements.
     * GSAGE is fix age; GSMSGAGE is age of the latest accepted NAV-PVT.
     * GSITOWMS identifies the valid fix's GNSS epoch (GPS time of week).
     */
    char measurements[224];
    if (fix) {
        snprintf(measurements, sizeof(measurements),
            "GSALTMM=%ld,GSVDMMPS=%ld,GSSPDMMPS=%lu,"
            "GSHACCMM=%lu,GSVACCMM=%lu,GSSACCMMPS=%lu,GSITOWMS=%lu",
            (long)gs_gps.hmsl_mm, (long)gs_gps.vel_d_mmps,
            (unsigned long)gs_gps.speed_3d_mmps,
            (unsigned long)gs_gps.hacc_mm, (unsigned long)gs_gps.vacc_mm,
            (unsigned long)gs_gps.sacc_mmps, (unsigned long)gs_gps.itow_ms);
    } else {
        snprintf(measurements, sizeof(measurements),
            "GSALTMM=---,GSVDMMPS=---,GSSPDMMPS=---,"
            "GSHACCMM=---,GSVACCMM=---,GSSACCMMPS=---,GSITOWMS=---");
    }
    char log_line[448];
    int log_length = snprintf(log_line, sizeof(log_line),
        "%s,GSMSGAGE=%lu,%s", line + 3,
        (unsigned long)(gs_gps.last_message_ms ?
            now - gs_gps.last_message_ms : UINT32_MAX), measurements);
    if (log_length > 0 && (size_t)log_length < sizeof(log_line)) {
        AT2_SD_LogPacket(log_line, line);
    }
}

int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_SPI1_Init();
    MX_USART1_UART_Init();
    MX_I2C1_Init();
    GSGPS_Init();
    MX_SPI2_Init();
    MX_FATFS_Init();
    AT2_SD_Init();
    GS_BatteryADC_Init();

    HAL_GPIO_WritePin(LORA_CS_PORT, LORA_CS_PIN, GPIO_PIN_SET);

    LED_Blink(LED1_PORT, LED1_PIN, 5, 80);

    uint8_t lora_ok = LORA_Init();

    if (!lora_ok)
    {
        while (1)
        {
            LED_Blink(LED2_PORT, LED2_PIN, 3, 120);
            HAL_Delay(500);
        }
    }

    ESP_SendLine("DATA,PKT=0,A1FT=---,A2FT=---,AX=---,AY=---,AZ=---,GX=---,GY=---,GZ=---");

    LORA_RxContinuous();

    uint8_t rx_buf[256];
    char raw[256];
    char esp_line[768];

    uint32_t last_gs_battery_send = 0;
    char gs_battery_value[16];
    char gs_battery_line[40];

    while (1)
    {
    	ESP_ReadCommands();
        GSGPS_Task();
        GS_ServiceMainAltitudeCommand();
        if (flash_clear_pending &&
            HAL_GetTick() - flash_last_activity_ms >= 240000UL)
        {
            flash_clear_pending = 0;
            GS_SendFlashStatus("TIMEOUT");
        }

        if ((HAL_GetTick() - last_gs_battery_send) >= 1000)
        {
            last_gs_battery_send = HAL_GetTick();

            GS_FormatBatteryVoltage(
                gs_battery_value,
                sizeof(gs_battery_value)
            );

            snprintf(
                gs_battery_line,
                sizeof(gs_battery_line),
                "GS,GSBATV=%s",
                gs_battery_value
            );

            ESP_SendLine(gs_battery_line);
        }

        uint8_t len = LORA_ReadPacket(
            rx_buf,
            sizeof(rx_buf) - 1
        );

        if (len > 0)
        {
            rx_buf[len] = 0;

            strncpy(
                raw,
                (char *)rx_buf,
                sizeof(raw) - 1
            );

            raw[sizeof(raw) - 1] = 0;

            /* Forward onboard test acknowledgements and continuity unchanged. */
            if (strncmp(raw, "GTEST,", 6) == 0 ||
                strncmp(raw, "ATSTAT,", 7) == 0)
            {
                char status_line[272];
                snprintf(status_line, sizeof(status_line), "GS,%s", raw);
                ESP_SendLine(status_line);
                /* Preserve each received speed/Mach/continuity status packet
                 * as its own timestamped CSV row, including invalid/stale
                 * quality flags. Never merge it with an older AT1 sample.
                 */
                if (strncmp(raw, "ATSTAT,", 7) == 0)
                {
                    AT2_SD_LogPacket(raw, status_line);
                }
                /* Already in continuous RX. Preserve newly received packets. */
                continue;
            }
            if (strncmp(raw, "FLASHINFO,", 10) == 0)
            {
                char info_line[192];
                /* A reply proves the blocking erase handler has returned. */
                flash_clear_pending = 0;

                snprintf(
                    info_line,
                    sizeof(info_line),
                    "GS,%s",
                    raw
                );

                ESP_SendLine(info_line);
                continue;
            }

            if (strcmp(raw, "FLASHCLEAR_PROGRESS") == 0)
            {
                flash_clear_pending = 1;
                flash_last_activity_ms = HAL_GetTick();
                GS_SendFlashStatus("CLEARING");
                continue;
            }

            if (strcmp(raw, "FLASHVERIFY_STARTED") == 0)
            {
                flash_clear_pending = 1;
                flash_last_activity_ms = HAL_GetTick();
                GS_SendFlashStatus("VERIFYING");
                continue;
            }

            if (strcmp(raw, "FLASHVERIFY_PROGRESS") == 0)
            {
                flash_clear_pending = 1;
                flash_last_activity_ms = HAL_GetTick();
                GS_SendFlashStatus("VERIFYING");
                continue;
            }

            if (strncmp(raw, "FLASHCLEAR_STARTED", 18) == 0)
            {
                flash_clear_pending = 1;
                flash_last_activity_ms = HAL_GetTick();
                strncpy(
                    flash_status,
                    "CLEARING",
                    sizeof(flash_status) - 1
                );
                flash_status[sizeof(flash_status) - 1] = '\0';

                GS_SendFlashStatus("CLEARING");
                continue;
            }

            if (strncmp(raw, "FLASHCLEAR_OK", 13) == 0)
            {
                flash_clear_pending = 0;
                strncpy(
                    flash_status,
                    "EMPTY",
                    sizeof(flash_status) - 1
                );
                flash_status[sizeof(flash_status) - 1] = '\0';

                /*
                 * Forward the full proof line from ATLAS V2 to ESP32.
                 */
                char proof_line[128];

                snprintf(
                    proof_line,
                    sizeof(proof_line),
                    "GS,FLASHSTATUS=EMPTY,%s",
                    raw + 14
                );

                ESP_SendLine(proof_line);
                continue;
            }

            if (strncmp(raw, "FLASHCLEAR_FAIL", 15) == 0)
            {
                flash_clear_pending = 0;
                strncpy(
                    flash_status,
                    "FAILED",
                    sizeof(flash_status) - 1
                );
                flash_status[sizeof(flash_status) - 1] = '\0';

                ESP_SendLine(
                    "GS,FLASHSTATUS=FAILED,VERIFY=FAIL"
                );

                continue;
            }

            if (strncmp(raw, "HEALTH,", 7) == 0)
            {
                /*
                 * HEALTH is safe to request at any time and gives the GS the
                 * active onboard MAIN altitude, including a value restored
                 * from ATLAS V2 flash after a power cycle.
                 */
                char main_alt_text[16];

                GetValue(
                    raw,
                    "MAINALTFT",
                    main_alt_text,
                    sizeof(main_alt_text)
                );

                if (main_alt_text[0] != '-' &&
                    main_alt_text[0] != '\0')
                {
                    uint32_t reported_main_altitude_ft =
                        strtoul(main_alt_text, NULL, 10);

                    if (GS_MainAltitudeAllowed(reported_main_altitude_ft))
                    {
                        current_main_altitude_ft =
                            reported_main_altitude_ft;
                    }
                }

                char health_line[160];

                snprintf(
                    health_line,
                    sizeof(health_line),
                    "GS,%s",
                    raw
                );

                ESP_SendLine(health_line);
                LORA_RxContinuous();
                continue;
            }

            if (strncmp(raw, "MAINALTACK=", 11) == 0)
            {
                char *end_ptr = NULL;

                uint32_t confirmed_altitude_ft =
                    strtoul(
                        raw + 11,
                        &end_ptr,
                        10
                    );

                if (
                    end_ptr != (raw + 11) &&
                    *end_ptr == '\0' &&
                    GS_MainAltitudeAllowed(confirmed_altitude_ft)
                )
                {
                    current_main_altitude_ft =
                        confirmed_altitude_ft;

                    main_altitude_change_pending = 0;
                    main_altitude_command_ms = 0;

                    GS_SendMainAltitudeStatus(
                        "CHANGED",
                        current_main_altitude_ft
                    );
                }
                else
                {
                    main_altitude_change_pending = 0;
                    main_altitude_command_ms = 0;

                    GS_SendMainAltitudeStatus(
                        "BAD_ACK",
                        current_main_altitude_ft
                    );
                }

                LORA_RxContinuous();
                continue;
            }

            if (strncmp(raw, "MAINALTNAK", 10) == 0)
            {
                main_altitude_change_pending = 0;
                main_altitude_command_ms = 0;

                GS_SendMainAltitudeStatus(
                    "REJECTED",
                    current_main_altitude_ft
                );

                LORA_RxContinuous();
                continue;
            }

            if (strncmp(raw, "AT1,", 4) == 0)
            {
                MakeDataLine(
                    raw,
                    esp_line,
                    sizeof(esp_line)
                );

                if (frequency_change_pending)
                {
                    uint32_t new_frequency_hz =
                        pending_lora_frequency_hz;

                    if (
                        GS_SendFrequencyCommand(
                            new_frequency_hz
                        )
                    )
                    {
                        GS_SendFrequencyStatus(
                            "COMMAND_SENT",
                            new_frequency_hz
                        );

                        if (
                        	GS_WaitForFrequencyAck(3000)
                        )
                        {
                            /*
                             * The onboard radio confirmed
                             * the command on the old frequency.
                             */
                            LORA_Standby();

                            LORA_SetFrequency(
                                new_frequency_hz
                            );

                            current_lora_frequency_hz =
                                new_frequency_hz;

                            pending_lora_frequency_hz = 0;
                            frequency_change_pending = 0;

                            GS_SendFrequencyStatus(
                                "CHANGED",
                                current_lora_frequency_hz
                            );
                        }
                        else
                        {
                            GS_SendFrequencyStatus(
                                "NO_ACK",
                                current_lora_frequency_hz
                            );

                            pending_lora_frequency_hz = 0;
                            frequency_change_pending = 0;

                            LORA_RxContinuous();
                        }
                    }
                    else
                    {
                        GS_SendFrequencyStatus(
                            "SEND_FAILED",
                            current_lora_frequency_hz
                        );

                        pending_lora_frequency_hz = 0;
                        frequency_change_pending = 0;

                        LORA_RxContinuous();
                    }
                }
                else
                {
                    char ack[40];
                    char pkt[20];

                    GetValue(
                        raw,
                        "PKT",
                        pkt,
                        sizeof(pkt)
                    );

                    snprintf(
                        ack,
                        sizeof(ack),
                        "ACK,PKT=%s",
                        pkt
                    );

                    LORA_Send(
                        (uint8_t *)ack,
                        strlen(ack),
                        1000
                    );
                }

                /* Resume RX before UART output or SD work. */
                LORA_RxContinuous();
                ESP_SendLine(esp_line);

                /* Non-blocking packet indicator keeps UART command polling live. */
                HAL_GPIO_TogglePin(LED2_PORT, LED2_PIN);

                HAL_GPIO_TogglePin(
                    LED1_PORT,
                    LED1_PIN
                );

                AT2_SD_LogPacket(
                    raw,
                    esp_line
                );
                /* Do not clear IRQ flags for a packet arriving during SD work. */
                continue;
            }

            LORA_RxContinuous();
        }
    }
}

static void GS_BatteryADC_Init(void)
{
    /*
     * Enable ADC1 clock.
     */
    __HAL_RCC_ADC1_CLK_ENABLE();

    /*
     * ADC clock = PCLK2 divided by 4.
     */
    ADC->CCR &= ~(3UL << 16);
    ADC->CCR |=  (1UL << 16);

    /*
     * Reset ADC1 settings.
     */
    ADC1->CR1 = 0;
    ADC1->CR2 = 0;

    /*
     * One regular conversion.
     */
    ADC1->SQR1 = 0;

    /*
     * PB1 is ADC channel 9.
     */
    ADC1->SQR3 = 9;

    /*
     * Channel 9 sampling time = 480 cycles.
     */
    ADC1->SMPR2 &= ~(7UL << 27);
    ADC1->SMPR2 |=  (7UL << 27);

    /*
     * Turn ADC1 on.
     */
    ADC1->CR2 |= ADC_CR2_ADON;

    HAL_Delay(2);
}

static uint16_t GS_BatteryADC_ReadRaw(void)
{
    uint32_t start_time = HAL_GetTick();

    /*
     * Clear old ADC status flags.
     */
    ADC1->SR = 0;

    /*
     * Start one ADC conversion.
     */
    ADC1->CR2 |= ADC_CR2_SWSTART;

    /*
     * Wait for the conversion to finish.
     */
    while ((ADC1->SR & ADC_SR_EOC) == 0)
    {
        if ((HAL_GetTick() - start_time) > 10)
        {
            return 0;
        }
    }

    /*
     * Reading DR clears the EOC flag.
     */
    return (uint16_t)ADC1->DR;
}

static uint32_t GS_ReadBatteryMillivolts(void)
{
    uint32_t raw_sum = 0;

    for (uint32_t i = 0; i < GS_BAT_ADC_SAMPLES; i++)
    {
        raw_sum += GS_BatteryADC_ReadRaw();
    }

    uint32_t average_raw =
        raw_sum / GS_BAT_ADC_SAMPLES;

    uint64_t battery_millivolts =
        (uint64_t)average_raw *
        GS_BAT_ADC_REFERENCE_MV *
        (GS_BAT_R_TOP_OHMS + GS_BAT_R_BOTTOM_OHMS);

    battery_millivolts /=
        (uint64_t)GS_BAT_ADC_MAX_COUNT *
        GS_BAT_R_BOTTOM_OHMS;

    return (uint32_t)battery_millivolts;
}

static void GS_FormatBatteryVoltage(char *out, uint16_t out_size)
{
    uint32_t battery_millivolts =
        GS_ReadBatteryMillivolts();

    uint32_t whole_volts =
        battery_millivolts / 1000UL;

    uint32_t hundredths =
        (battery_millivolts % 1000UL) / 10UL;

    snprintf(
        out,
        out_size,
        "%lu.%02lu",
        (unsigned long)whole_volts,
        (unsigned long)hundredths
    );
}

static void MakeDataLine(char *raw, char *out, uint16_t out_size)
{
    char pkt[20];
    char flight_state[12], arm_state[12], baro_trust[12], event_flags[12];
    char a1ft[20];
    char descfts[20];
    char mach[16];
    char ax[20];
    char ay[20];
    char az[20];
    char gx[20];
    char gy[20];
    char gz[20];
    char i1[12];
    char i2[12];
    char gps_status[12];
    char gps_fix[12];
    char sats[12];
    char lat[24];
    char lon[24];
    char gps_age[20];
    char gps_alt_ft[20];
    char gps_vs_fts[20];
    char radio_frequency_hz[20];

    char onboard_battery[16];
    char gs_battery[16];

    GetValue(raw, "PKT", pkt, sizeof(pkt));
    GetValue(raw, "FS", flight_state, sizeof(flight_state));
    GetValue(raw, "ARM", arm_state, sizeof(arm_state));
    GetValue(raw, "BT", baro_trust, sizeof(baro_trust));
    GetValue(raw, "EV", event_flags, sizeof(event_flags));
    GetValue(raw, "A1FT", a1ft, sizeof(a1ft));
    GetValue(raw, "DESCFTS", descfts, sizeof(descfts));
    GetValue(raw, "MACH", mach, sizeof(mach));
    GetValue(raw, "AX", ax, sizeof(ax));
    GetValue(raw, "AY", ay, sizeof(ay));
    GetValue(raw, "AZ", az, sizeof(az));
    GetValue(raw, "GX", gx, sizeof(gx));
    GetValue(raw, "GY", gy, sizeof(gy));
    GetValue(raw, "GZ", gz, sizeof(gz));
    GetValue(raw, "I1", i1, sizeof(i1));
    GetValue(raw, "I2", i2, sizeof(i2));
    GetValue(raw, "GPS", gps_status, sizeof(gps_status));
    GetValue(raw, "FIX", gps_fix, sizeof(gps_fix));
    GetValue(raw, "SATS", sats, sizeof(sats));
    GetValue(raw, "LAT", lat, sizeof(lat));
    GetValue(raw, "LON", lon, sizeof(lon));
    GetValue(raw, "GPSAGE", gps_age, sizeof(gps_age));
    GetValue(raw, "GPSALTFT", gps_alt_ft, sizeof(gps_alt_ft));
    GetValue(raw, "GPSVSFTS", gps_vs_fts, sizeof(gps_vs_fts));

    GetValue(
        raw,
        "RFHZ",
        radio_frequency_hz,
        sizeof(radio_frequency_hz)
    );

    GetValue(
        raw,
        "BATV",
        onboard_battery,
        sizeof(onboard_battery)
    );

    GS_FormatBatteryVoltage(
        gs_battery,
        sizeof(gs_battery)
    );

    snprintf(
        out,
        out_size,
        "DATA,PKT=%s,FS=%s,ARM=%s,BT=%s,EV=%s,A1FT=%s,A2FT=0.0,DESCFTS=%s,MACH=%s,"
        "AX=%s,AY=%s,AZ=%s,"
        "GX=%s,GY=%s,GZ=%s,"
        "I1=%s,I2=%s,GPS=%s,FIX=%s,SATS=%s,"
        "LAT=%s,LON=%s,GPSAGE=%s,GPSALTFT=%s,GPSVSFTS=%s,"
        "RFHZ=%s,BATV=%s,GSBATV=%s,"
        "RSSI=%d,SNR=%d.%02d",
        pkt,
        flight_state, arm_state, baro_trust, event_flags,
        a1ft,
        descfts,
        mach,
        ax,
        ay,
        az,
        gx,
        gy,
        gz,
        i1,
        i2,
        gps_status,
        gps_fix,
        sats,
        lat,
        lon,
        gps_age,
        gps_alt_ft,
        gps_vs_fts,
        radio_frequency_hz,
        onboard_battery,
        gs_battery,
        last_lora_rssi,
        (int)last_lora_snr,
        abs((int)(last_lora_snr * 100.0f) % 100)
    );
}

static void GetValue(char *line, const char *key, char *out, uint16_t out_size)
{
    char search[24];

    snprintf(search, sizeof(search), "%s=", key);

    char *start = strstr(line, search);

    if (start == NULL)
    {
        strncpy(out, "---", out_size);
        out[out_size - 1] = 0;
        return;
    }

    start += strlen(search);

    char *end = strchr(start, ',');

    uint16_t len = 0;

    if (end == NULL)
    {
        len = strlen(start);
    }
    else
    {
        len = end - start;
    }

    if (len >= out_size)
    {
        len = out_size - 1;
    }

    memcpy(out, start, len);
    out[len] = 0;
}

static void ESP_SendLine(const char *line)
{
    HAL_UART_Transmit(&huart1, (uint8_t *)line, strlen(line), 100);
    HAL_UART_Transmit(&huart1, (uint8_t *)"\r\n", 2, 100);
}

static uint8_t LORA_Init(void)
{
    LORA_Reset();

    if (LORA_ReadReg(REG_VERSION) != 0x12)
    {
        return 0;
    }

    LORA_WriteReg(REG_OP_MODE, MODE_LONG_RANGE_MODE | MODE_SLEEP);
    HAL_Delay(10);

    LORA_WriteReg(REG_FIFO_TX_BASE_ADDR, 0x00);
    LORA_WriteReg(REG_FIFO_RX_BASE_ADDR, 0x00);

    LORA_SetFrequency(current_lora_frequency_hz);

    LORA_WriteReg(REG_PA_CONFIG, 0x8F);
    LORA_WriteReg(REG_OCP, 0x2B);
    LORA_WriteReg(REG_LNA, 0x23);

    LORA_WriteReg(REG_MODEM_CONFIG_1, 0x72);
    LORA_WriteReg(REG_MODEM_CONFIG_2, 0x74);
    LORA_WriteReg(REG_MODEM_CONFIG_3, 0x04);

    LORA_WriteReg(REG_PREAMBLE_MSB, 0x00);
    LORA_WriteReg(REG_PREAMBLE_LSB, 0x08);

    LORA_WriteReg(REG_SYNC_WORD, 0x12);
    LORA_WriteReg(REG_PA_DAC, 0x84);
    LORA_WriteReg(REG_IRQ_FLAGS, 0xFF);

    LORA_Standby();

    return 1;
}

static uint8_t GS_FrequencyAllowed(uint32_t frequency_hz)
{
    if (
        frequency_hz >= 902300000UL &&
        frequency_hz <= 927500000UL
    )
    {
        return 1;
    }

    return 0;
}

static void GS_SendFrequencyStatus(
    const char *status,
    uint32_t frequency_hz
)
{
    char line[80];

    uint32_t whole_mhz =
        frequency_hz / 1000000UL;

    uint32_t decimal_mhz =
        (frequency_hz % 1000000UL) / 100000UL;

    snprintf(
        line,
        sizeof(line),
        "GS,FREQ=%lu.%01lu,FREQSTATUS=%s",
        (unsigned long)whole_mhz,
        (unsigned long)decimal_mhz,
        status
    );

    ESP_SendLine(line);
}

static void ESP_ReadCommands(void)
{
    uint8_t received_character;

    while (
        HAL_UART_Receive(
            &huart1,
            &received_character,
            1,
            1
        ) == HAL_OK
    )
    {
        if (
            received_character == '\n' ||
            received_character == '\r'
        )
        {
            if (esp_rx_index > 0)
            {
                esp_rx_line[esp_rx_index] = '\0';

                ESP_HandleCommand(esp_rx_line);

                esp_rx_index = 0;
            }
        }
        else
        {
            if (
                esp_rx_index <
                sizeof(esp_rx_line) - 1
            )
            {
                esp_rx_line[esp_rx_index++] =
                    (char)received_character;
            }
            else
            {
                esp_rx_index = 0;
            }
        }
    }
}

static void ESP_HandleCommand(const char *command)
{
    if (strncmp(command, "GT,", 3) == 0)
    {
        char radio_command[80];
        int count = snprintf(radio_command, sizeof(radio_command), "CMD,%s", command);
        if (count > 0 && count < (int)sizeof(radio_command))
            LORA_Send((uint8_t *)radio_command, (uint8_t)count, 1000);
        LORA_RxContinuous();
        return;
    }

    if (strcmp(command, "FLASHINFO") == 0)
    {
        const char query[] = "CMD,FLASHINFO";

        if (!LORA_Send(
            (uint8_t *)query,
            (uint8_t)strlen(query),
            1000
        ))
        {
            ESP_SendLine(
                "GS,FLASHINFOSTATUS=SEND_FAILED"
            );
        }

        LORA_RxContinuous();
        return;
    }

    /*
     * Destructive W25Q128 erase command.
     * Require the exact confirmation token from the ESP32 UI.
     */
    if (
        strcmp(
            command,
            "CLEARFLASH,CONFIRM=ERASE_W25Q128"
        ) == 0
    )
    {
        if (flash_clear_pending)
        {
            GS_SendFlashStatus("CLEARING");
            return;
        }

        if (GS_SendFlashClearCommand())
        {
            flash_clear_pending = 1;
            flash_last_activity_ms = HAL_GetTick();

            strncpy(
                flash_status,
                "COMMAND_SENT",
                sizeof(flash_status) - 1
            );
            flash_status[sizeof(flash_status) - 1] = '\0';

            GS_SendFlashStatus("COMMAND_SENT");

        }
        else
        {
            flash_clear_pending = 0;

            strncpy(
                flash_status,
                "SEND_FAILED",
                sizeof(flash_status) - 1
            );
            flash_status[sizeof(flash_status) - 1] = '\0';

            GS_SendFlashStatus("SEND_FAILED");

        }

        return;
    }

    if (strcmp(command, "HEALTH") == 0)
    {
        if (!GS_SendHealthQuery())
        {
            GS_SendMainAltitudeStatus(
                "HEALTH_SEND_FAILED",
                current_main_altitude_ft
            );
        }

        /* The send helper already enabled RX. Preserve a pending reply. */
        return;
    }

    if (strncmp(command, "SETMAINALT,", 11) == 0)
    {
        char *end_ptr = NULL;

        uint32_t requested_main_altitude_ft =
            strtoul(
                command + 11,
                &end_ptr,
                10
            );

        if (
            end_ptr == (command + 11) ||
            *end_ptr != '\0' ||
            !GS_MainAltitudeAllowed(requested_main_altitude_ft)
        )
        {
            GS_SendMainAltitudeStatus(
                "INVALID",
                current_main_altitude_ft
            );

            return;
        }

        if (main_altitude_change_pending)
        {
            GS_SendMainAltitudeStatus(
                "BUSY",
                current_main_altitude_ft
            );

            return;
        }

        if (
            current_main_altitude_ft != 0 &&
            requested_main_altitude_ft ==
                current_main_altitude_ft
        )
        {
            GS_SendMainAltitudeStatus(
                "ALREADY_SET",
                current_main_altitude_ft
            );

            return;
        }

        if (
            GS_SendMainAltitudeCommand(
                requested_main_altitude_ft
            )
        )
        {
            main_altitude_change_pending = 1;
            main_altitude_command_ms = HAL_GetTick();

            GS_SendMainAltitudeStatus(
                "COMMAND_SENT",
                current_main_altitude_ft
            );
            /* Keep RX active and preserve any ACK received during UART output. */
        }
        else
        {
            main_altitude_change_pending = 0;
            main_altitude_command_ms = 0;

            GS_SendMainAltitudeStatus(
                "SEND_FAILED",
                current_main_altitude_ft
            );

            LORA_RxContinuous();
        }

        return;
    }

    if (strncmp(command, "SETFREQ,", 8) != 0)
    {
        return;
    }

    uint32_t requested_frequency_hz =
        strtoul(
            command + 8,
            NULL,
            10
        );

    if (!GS_FrequencyAllowed(requested_frequency_hz))
    {
        GS_SendFrequencyStatus(
            "INVALID",
            current_lora_frequency_hz
        );

        return;
    }

    if (
        requested_frequency_hz ==
        current_lora_frequency_hz
    )
    {
        GS_SendFrequencyStatus(
            "ALREADY_SET",
            current_lora_frequency_hz
        );

        return;
    }

    /*
     * Send the frequency command IMMEDIATELY.
     *
     * Older code queued the request and waited for the next AT1 telemetry
     * packet before sending CMD,FREQ. That made frequency changes depend on
     * normal telemetry timing and could fail after a long flash erase.
     *
     * Frequency changing is now independent of telemetry packets.
     */
    pending_lora_frequency_hz =
        requested_frequency_hz;

    frequency_change_pending = 0;

    if (
        GS_SendFrequencyCommand(
            requested_frequency_hz
        )
    )
    {
        GS_SendFrequencyStatus(
            "COMMAND_SENT",
            requested_frequency_hz
        );

        if (
            GS_WaitForFrequencyAck(3000)
        )
        {
            /*
             * ATLAS V2 acknowledged on the OLD frequency.
             * Now retune ATLAS V1 to the requested frequency.
             */
            LORA_Standby();

            LORA_SetFrequency(
                requested_frequency_hz
            );

            current_lora_frequency_hz =
                requested_frequency_hz;

            pending_lora_frequency_hz = 0;

            GS_SendFrequencyStatus(
                "CHANGED",
                current_lora_frequency_hz
            );

            LORA_RxContinuous();
        }
        else
        {
            /*
             * Do NOT retune if V2 never acknowledged.
             * Stay on the current frequency so the link is preserved.
             */
            pending_lora_frequency_hz = 0;

            GS_SendFrequencyStatus(
                "NO_ACK",
                current_lora_frequency_hz
            );

            LORA_RxContinuous();
        }
    }
    else
    {
        pending_lora_frequency_hz = 0;

        GS_SendFrequencyStatus(
            "SEND_FAILED",
            current_lora_frequency_hz
        );

        LORA_RxContinuous();
    }
}

static uint8_t GS_MainAltitudeAllowed(
    uint32_t altitude_ft
)
{
    return (
        altitude_ft >= MAIN_ALTITUDE_MIN_FT &&
        altitude_ft <= MAIN_ALTITUDE_MAX_FT
    );
}

static void GS_SendMainAltitudeStatus(
    const char *status,
    uint32_t altitude_ft
)
{
    char line[96];

    if (altitude_ft != 0)
    {
        snprintf(
            line,
            sizeof(line),
            "GS,MAINALTFT=%lu,MAINALTSTATUS=%s",
            (unsigned long)altitude_ft,
            status
        );
    }
    else
    {
        snprintf(
            line,
            sizeof(line),
            "GS,MAINALTFT=UNKNOWN,MAINALTSTATUS=%s",
            status
        );
    }

    ESP_SendLine(line);
}

static uint8_t GS_SendMainAltitudeCommand(
    uint32_t altitude_ft
)
{
    char command[48];

    snprintf(
        command,
        sizeof(command),
        "CMD,MAINALTFT=%lu",
        (unsigned long)altitude_ft
    );

    uint8_t sent = LORA_Send(
        (uint8_t *)command,
        (uint8_t)strlen(command),
        1000
    );
    /* Listen before any blocking UART status output. */
    LORA_RxContinuous();
    return sent;
}

static uint8_t GS_SendHealthQuery(void)
{
    const char command[] =
        "CMD,HEALTH";

    uint8_t sent = LORA_Send(
        (uint8_t *)command,
        (uint8_t)strlen(command),
        1000
    );
    /* Receive the onboard reply before UART reporting resumes. */
    LORA_RxContinuous();
    return sent;
}

static void GS_ServiceMainAltitudeCommand(void)
{
    if (!main_altitude_change_pending)
    {
        return;
    }

    if (
        (HAL_GetTick() - main_altitude_command_ms) >=
        MAIN_ALTITUDE_ACK_TIMEOUT_MS
    )
    {
        main_altitude_change_pending = 0;
        main_altitude_command_ms = 0;

        GS_SendMainAltitudeStatus(
            "NO_ACK",
            current_main_altitude_ft
        );

        LORA_RxContinuous();
    }
}

static void GS_SendFlashStatus(const char *status)
{
